+/// Shared endpoint variables retain their native arrays and shared control.
+#[derive(Debug, Clone)]
+enum EndpointVariables {
+    Caller(Arc<[Variable]>),
+    Native(SharedWorkspace<AdmittedVec<Variable>>),
