+fn one_occurrence(occurrence: Occurrence, workspace: &crate::WorkspaceCapability) -> Result<AdmittedVec<Occurrence>, EvalError> {
+    let mut summary = AdmittedVec::with_capacity(1, workspace)?;
+    summary.push_reserved(occurrence);
+    Ok(summary)
+}
