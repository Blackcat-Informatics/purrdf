+/// Keep the bounded outer-row schema and whole-pattern collision walk off the
+/// frame that descends through a substituted definition's next `EXISTS`.
+#[inline(never)]
+fn check_exists_row_collision_admitted<D: DatasetView + Sync>(
+    normalized: &GraphPattern,
+    row: &[Option<SolutionTerm<D::Id>>],
+    schema: &VarSchema,
+    growth: &crate::WorkspaceCapability,
+) -> Result<(), EvalError> {
+    // The outer-bound variables (a concrete binding in the current row), built
+    // only for this check: it is the one consumer that needs the set itself.
+    let outer_bound = VarSchema::from_vars_admitted(
+        schema
+            .vars()
+            .iter()
+            .enumerate()
+            .filter(|(i, _)| row[*i].is_some())
+            .map(|(_, v)| v.clone()),
+        growth,
+    )?;
+    // A walk over the whole inner pattern, over a work list, so an `EXISTS` of any
+    // depth is read to the end before "no collision" is answered.
+    if let Some((var, intro)) =
+        crate::governor::soundness::exists_row_collision_admitted(normalized, &outer_bound, growth)?
+    {
+        return Err(EvalError::ExistsScopeCollision {
+            variable: growth.authored_text(var.as_str())?,
+            intro: intro.as_str(),
+        });
+    }
+    Ok(())
+}
+
