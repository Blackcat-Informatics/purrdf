+    #[test]
+    fn dictionary_positions_are_bound_to_their_certified_source() {
+        let mut images = Vec::new();
+        for width in [180, 80] {
+            let mut builder =
+                SegmentedBuilder::new(SegmentedBuildLimits::new(20, 20_000, 0, 512, 8).unwrap())
+                    .unwrap();
+            let values: Vec<_> = (0..10)
+                .map(|index| {
+                    let prefix = if index % 2 == 0 { "a" } else { "z" };
+                    TermValue::iri(format!(
+                        "https://example.org/{}/{index:02}",
+                        prefix.repeat(width)
+                    ))
+                })
+                .collect();
+            let mut id = None;
+            builder
+                .intern_batch(&values, |_, value| id = Some(value))
+                .unwrap();
+            images.push((builder.seal().unwrap(), id.unwrap(), values[9].clone()));
+        }
+        let operation =
+            SegmentedOperation::new(SegmentedReadLimits::new(2_000_000, 2, 2000, 10_000_000, 4))
+                .unwrap();
+        let sessions: Vec<_> = images
+            .iter()
+            .map(|(image, _, _)| {
+                operation
+                    .open(Arc::new(image.provider()), image.receipt())
+                    .unwrap()
+            })
+            .collect();
+        let pins: Vec<_> = sessions
+            .iter()
+            .zip(&images)
+            .map(|(session, (_, id, _))| session.resolve(*id).unwrap())
+            .collect();
+        let before = operation.evidence(()).request_count();
+        for index in [0, 1, 0, 1] {
+            let (_, id, value) = &images[index];
+            assert_eq!(sessions[index].term_value(*id).unwrap(), *value);
+        }
+        assert_eq!(operation.evidence(()).request_count(), before);
+        let state = lock_read_state(&operation.state);
+        let positions: Vec<_> = state.dictionary_positions.iter().collect();
+        assert_eq!(positions.len(), 2);
+        assert_ne!(positions[0].key.snapshot, positions[1].key.snapshot);
+        assert_ne!(positions[0].key.slot, positions[1].key.slot);
+        assert!(
+            positions
+                .iter()
+                .all(|position| position.first <= images[0].1.index()
+                    && images[0].1.index() < position.end)
+        );
+        drop(state);
+        drop(pins);
+    }
