+fn selected_capi_artifacts(messages: &[Value]) -> IoResult<Vec<phases::Artifact>> {
+    let mut selected = Vec::new();
+    for message in messages {
+        if message.get("reason").and_then(Value::as_str) == Some("compiler-artifact")
+            && message.pointer("/target/name").and_then(Value::as_str) == Some("purrdf")
+            && message
+                .pointer("/target/kind")
+                .and_then(Value::as_array)
+                .is_some_and(|kinds| kinds.iter().any(|kind| kind == "cdylib"))
+        {
+            artifact_metadata(message)?;
+            let package = message
+                .get("package_id")
+                .and_then(Value::as_str)
+                .ok_or_else(|| invalid("artifact package ID malformed"))?;
+            let filename = format!(
+                "{}purrdf{}",
+                std::env::consts::DLL_PREFIX,
+                std::env::consts::DLL_SUFFIX
+            );
+            let artifact = phases::cdylib(messages, package, &filename)?;
+            if artifact.message != *message {
+                return Err(invalid("selected C library does not match its Cargo frame"));
+            }
+            selected.push(artifact);
+        }
+    }
+    Ok(selected)
+}
+
+fn capture_capi_artifacts(messages: &[Value]) -> IoResult<Vec<Value>> {
+    selected_capi_artifacts(messages)?
+        .into_iter()
+        .map(|artifact| {
+            Ok(Object::new()
+                .with("artifact", artifact.message)
+                .with("library", phases::identity(&artifact.path)?)
+                .into())
+        })
+        .collect()
+}
+
+fn validate_capi_artifacts<'a>(messages: &[Value], captured: &'a Value) -> IoResult<&'a [Value]> {
+    let captures = captured
+        .as_array()
+        .ok_or_else(|| invalid("child-time C library identity inventory missing"))?;
+    let selected = selected_capi_artifacts(messages)?;
+    if captures.len() != selected.len() {
+        return Err(invalid("child-time C library identity inventory differs"));
+    }
+    for artifact in selected {
+        let matching: Vec<_> = captures
+            .iter()
+            .filter(|capture| capture.get("artifact") == Some(&artifact.message))
+            .collect();
+        let [capture] = matching.as_slice() else {
+            return Err(invalid(
+                "missing or ambiguous child-time C library identity",
+            ));
+        };
+        let library = capture
+            .get("library")
+            .ok_or_else(|| invalid("child-time C library identity missing"))?;
+        if library.get("path").and_then(Value::as_str) != artifact.path.to_str()
+            || library.get("bytes").and_then(Value::as_u64).is_none()
+            || library
+                .get("blake3")
+                .and_then(Value::as_str)
+                .and_then(purrdf_hash::hex::decode_32_canonical)
+                .is_none()
+        {
+            return Err(invalid(
+                "child-time C library identity is malformed or mismatched",
+            ));
+        }
+    }
+    Ok(captures)
+}
+
+fn c_phase_binding(c: &Value, captures: &[Value]) -> IoResult<()> {
+    let artifact = c
+        .pointer("/context/cargo_artifact")
+        .ok_or_else(|| invalid("actual C smoke Cargo artifact missing"))?;
+    let library = c
+        .pointer("/context/library")
+        .ok_or_else(|| invalid("actual C smoke library identity missing"))?;
+    if captures
+        .iter()
+        .filter(|capture| {
+            capture.get("artifact") == Some(artifact) && capture.get("library") == Some(library)
+        })
+        .count()
+        != 1
+    {
+        return Err(invalid(
+            "C smoke library is not bound to one actual Cargo child",
+        ));
+    }
+    Ok(())
+}
