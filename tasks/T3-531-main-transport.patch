+fn eval_ordinary_chain<'a, D: DatasetView + Sync>(
+    pattern: &'a GraphPattern,
+    ctx: &mut EvalCtx<'_, D>,
+) -> Result<Evaluated<D::Id>, EvalError> {
+    // A single ordinary FILTER or Slice keeps its parent inline. Only an
+    // actual nested suspension needs the admitted spill buffer.
+    let mut runner = OrdinaryRunner {
+        pending: crate::AdmittedVec::new(&ctx.growth),
+        ctx,
+        active: None,
+        first: None,
+    };
+    let mut current = pattern;
+    let mut completed = loop {
+        match NodeBoundary::enter(current, runner.ctx) {
+            Ok(boundary) => runner.active = Some(boundary),
+            Err(error) => break Err(error),
+        }
+        match runner
+            .active
+            .as_mut()
+            .expect("entered node")
+            .start(current, runner.ctx)
+        {
+            Ok(Some(early)) => break runner.finish_active(current, Ok(early)),
+            Err(error) => break runner.finish_active(current, Err(error)),
+            Ok(None) => {}
+        }
+        if matches!(current, GraphPattern::Join { .. })
+            && runner.ctx.positive_region(current).is_none()
+        {
+            let evaluated = eval_numbered_node(current, runner.ctx);
+            break runner.finish_active(current, evaluated);
+        }
+        match precomputed_evaluated(current, runner.ctx) {
+            Ok(Some(evaluated)) => break runner.finish_active(current, Ok(evaluated)),
+            Err(error) => break runner.finish_active(current, Err(error)),
+            Ok(None) => {}
+        }
+        let after = match current {
+            GraphPattern::Filter { expr, .. } => {
+                crate::governor::lift::Lift::at_admitted(current, &runner.ctx.growth).map(|lift| {
+                    Some(OrdinaryAfter::Filter {
+                        expression: expr,
+                        lift: lift.detach(),
+                    })
+                })
+            }
+            GraphPattern::Slice { start, length, .. } => {
+                crate::governor::lift::Lift::at_admitted(current, &runner.ctx.growth).map(|lift| {
+                    Some(OrdinaryAfter::Slice {
+                        start: *start,
+                        length: *length,
+                        lift: lift.detach(),
+                    })
+                })
+            }
+            _ => Ok(None),
+        };
+        let after = match after {
+            Ok(after) => after,
+            Err(error) => break runner.finish_active(current, Err(error)),
+        };
+        if let Some(after) = after {
+            let next = match current {
+                GraphPattern::Filter { inner, .. } | GraphPattern::Slice { inner, .. } => inner,
+                _ => unreachable!("only FILTER and Slice suspend a graph child here"),
+            };
+            if runner.first.is_none() {
+                runner.first = Some(OrdinaryFrame {
+                    pattern: current,
+                    boundary: runner.active.take().expect("entered parent"),
+                    after,
+                });
+            } else {
+                if let Err(error) = runner.pending.reserve_next() {
+                    break runner.finish_active(current, Err(error));
+                }
+                runner.pending.push_reserved(OrdinaryFrame {
+                    pattern: current,
+                    boundary: runner.active.take().expect("entered parent"),
+                    after,
+                });
+            }
+            current = next;
+        } else {
+            let evaluated = dispatch_node(current, &mut (), runner.ctx);
+            break runner.finish_active(current, evaluated);
+        }
+    };
+    while let Some(frame) = runner.pop() {
+        let OrdinaryFrame {
+            pattern,
+            boundary,
+            after,
+        } = frame;
+        runner.active = Some(boundary);
+        completed = match (after, completed) {
+            (OrdinaryAfter::Filter { expression, lift }, Ok(child)) => {
+                crate::expr::finish_filter_child(pattern, expression, lift, child, runner.ctx)
+            }
+            (
+                OrdinaryAfter::Slice {
+                    start,
+                    length,
+                    lift,
+                },
+                Ok(child),
+            ) => crate::modifier::finish_slice(pattern, start, length, lift, child, runner.ctx),
+            (_, Err(error)) => Err(error),
+        };
+        completed = runner.finish_active(pattern, completed);
+    }
+    completed
