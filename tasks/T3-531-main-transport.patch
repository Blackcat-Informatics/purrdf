+                    .evidence_search
+                    .as_mut()
+                    .and_then(|frames| frames.as_mut_slice().last_mut())
+                {
+                    *parent = parent.combine(
+                        &search,
+                        purrdf_core::evidence::EvidenceCombination::Conjunction,
+                    )?;
+                }
+            }
+        }
+        evaluated
+    }
+}
