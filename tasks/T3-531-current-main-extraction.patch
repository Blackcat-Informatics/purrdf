+/// The state whose owners must survive an expression's recursive EXISTS evaluation.
+/// The concrete box is admitted at construction; its payload dies before that grant.
+enum FilterInput<I: ViewTermId> {
+    Forked(RowBag<I>),
+    Sequential(Option<RowBagIntoIter<I>>),
+}
+
+struct FilterContinuation<'p, 'e, I: ViewTermId> {
+    output: Option<RowsBuilder<I>>,
+    linked: crate::vm::Linked<'e, I>,
+    checkpoint: crate::row_checkpoint::RowCheckpoint,
+    input: FilterInput<I>,
+    schema: SharedSchema,
+    lift: Option<Lift<'p>>,
+}
+
+/// Build the full live FILTER state outside the frame that calls `linked.filter`.
+/// Keep checkpoint, program, link and output preparation in their original order.
+#[inline(never)]
+fn prepare_filter_continuation<'p, 'e, D: DatasetView + Sync>(
+    node: &'p GraphPattern,
+    expr: &'e Expression,
+    seq: SolutionSeq<D::Id>,
+    lift: Lift<'p>,
+    forked: bool,
+    ctx: &mut EvalCtx<'_, D>,
+) -> Result<crate::workspace::WorkspaceBox<FilterContinuation<'p, 'e, D::Id>>, EvalError> {
+    let schema = seq.schema.clone();
+    let checkpoint = crate::row_checkpoint::RowCheckpoint::for_rows(
+        ctx,
+        crate::governor::ChargePoint::RowExpressionEvaluation,
+        forked,
+        seq.rows.len(),
+    );
+    let program = crate::vm::program_at(ctx, node, expr)?;
+    let linked = crate::vm::Linked::link_admitted(program, expr, &schema, ctx)?;
+    let output = (!forked).then(|| RowsBuilder::new(&ctx.growth));
+    let input = if forked {
+        FilterInput::Forked(seq.rows)
+    } else {
+        FilterInput::Sequential(Some(seq.rows.into_iter()))
+    };
+    crate::workspace::WorkspaceBox::new_admitted(
+        FilterContinuation {
+            output,
+            linked,
+            checkpoint,
+            input,
+            schema,
+            lift: Some(lift),
+        },
+        &ctx.growth,
+    )
+}
