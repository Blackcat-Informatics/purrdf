+/// Input-proportional work admission for repeated star projection/scope walks.
+/// Parser ownership makes nested SELECTs share one budget.
+#[derive(Clone, Copy)]
+struct ProjectionWork {
+    used: usize,
+    limit: usize,
+}
+
 impl<'a, 'o, 's, const RDFLIB: bool> Parser<'a, 'o, '_, 's, RDFLIB> {
+    /// Admit a repeated variable scan before it reads or copies any entries.
+    fn admit_projection_work(&mut self, entries: usize) -> Result<()> {
+        let at = self.span();
+        let Some(work) = &mut self.projection_work else {
+            return Ok(());
+        };
+        let requested = work.used.saturating_add(entries);
+        if requested > work.limit {
+            return Err(ParseError::ProjectionLimit {
+                requested,
+                limit: work.limit,
+                at,
+            });
+        }
+        work.used = requested;
+        Ok(())
+    }
     fn boxed<T>(&mut self, value: T) -> Result<Box<T>> {
