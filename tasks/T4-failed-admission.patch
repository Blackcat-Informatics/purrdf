+    /// Every nested star republishes its child's visible names. The parser
+    /// refuses the 8,000-level adversary before the repeated copies can become
+    /// quadratic, while accepted neighbors keep first-appearance order.
+    #[test]
+    fn nested_star_projection_admits_work_before_repeated_scope_copies() {
+        fn nested(depth: usize) -> String {
+            use std::fmt::Write;
+            let mut query = String::new();
+            for _ in 1..depth {
+                query.push_str("SELECT * WHERE { { ");
+            }
+            query.push_str("SELECT * WHERE { BIND(0 AS ?v0) }");
+            for level in 1..depth {
+                write!(query, " }} BIND({level} AS ?v{level}) }}").expect("String write");
+            }
+            query
+        }
+        let mut admitted_visits = [0; 3];
+        for (index, depth) in [2, 4, 8].into_iter().enumerate() {
+            let input = nested(depth);
+            let query = SparqlParser::new()
+                .parse_query(&input)
+                .expect("small nested stars retain all visible variables");
+            let Query::Select { pattern, .. } = query else {
+                panic!("SELECT query");
+            };
+            let GraphPattern::Project { variables, .. } = pattern else {
+                panic!("star projection");
+            };
+            assert_eq!(
+                variables,
+                (0..depth)
+                    .map(|level| Variable::new(format!("v{level}")))
+                    .collect::<Vec<_>>()
+            );
+
+            let public = SparqlParser::new();
+            let options = ParserOptions::default();
+            let mut resident = ResidentParserAdmission;
+            let mut memory = Memory::new(&mut resident as &mut dyn ParserAdmission);
+            let mut parser = public
+                .parser_for::<false>(&input, &options, &mut memory)
+                .expect("internal count uses the public parser setup");
+            parser.parse_prologue().expect("prologue");
+            let _query = parser.parse_query_form().expect("accepted query");
+            parser.expect_eof().expect("whole query");
+            admitted_visits[index] = parser.projection_work.expect("nested stars").used;
+        }
+        eprintln!("nested star admitted variable visits: {admitted_visits:?}");
+        let input = nested(8_000);
+        let error = SparqlParser::new()
+            .parse_query(&input)
+            .expect_err("repeated projection is refused before 8,000 growing vectors");
+        let ParseError::ProjectionLimit {
+            requested,
+            limit,
+            at,
+        } = error
+        else {
+            panic!("expected typed projection admission, got {error:?}");
+        };
+        assert!(requested > limit);
+        assert!(limit <= 8 * 8_000 + 256, "input-proportional bound");
+        assert!(at < input.len());
+
+        let with_modifier = input.replace("SELECT *", "SELECT DISTINCT *");
+        assert!(matches!(
+            SparqlParser::new().parse_query(&with_modifier),
+            Err(ParseError::ProjectionLimit { .. })
+        ));
+    }
