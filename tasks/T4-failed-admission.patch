+/// Assemble from the outside in without repeatedly copying the test string.
+/// Every sub-SELECT introduces one new visible variable.
+fn nested_stars(depth: usize) -> String {
+    let mut query = String::new();
+    for _ in 1..depth {
+        query.push_str("SELECT * WHERE { { ");
+    }
+    query.push_str("SELECT * WHERE { BIND(0 AS ?v0) }");
+    for level in 1..depth {
+        write!(query, " }} BIND({level} AS ?v{level}) }}").expect("String write");
+    }
+    query
+}
+
+#[test]
+fn nested_star_refusal_keeps_parse_allocation_input_proportional() {
+    let measured = [2_000, 4_000, 8_000].map(|depth| {
+        let input = nested_stars(depth);
+        let window = CurrentThreadWindow::open();
+        let refusal = SparqlParser::new().parse_query(&input);
+        let cost = window.close();
+        assert!(matches!(refusal, Err(ParseError::ProjectionLimit { .. })));
+        cost
+    });
+    for (before, after) in measured.iter().zip(measured.iter().skip(1)) {
+        assert!(
+            after.requested_bytes < before.requested_bytes * 3,
+            "rejected doubling has bounded allocator traffic: {before:?} -> {after:?}"
+        );
+        assert!(
+            after.peak_working_bytes < before.peak_working_bytes * 3,
+            "rejected doubling has bounded working bytes: {before:?} -> {after:?}"
+        );
+    }
+}
