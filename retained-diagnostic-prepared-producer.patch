+#[test]
+fn prepared_unbound_names_render_under_the_original_execution_grant() {
+    let (image, _) = fixture();
+    let engine = NativeSparqlEngine::new();
+    let first = format!("first_{}", "a".repeat(1024));
+    let second = format!("second_{}", "b".repeat(1024));
+    let query = format!("SELECT ?{first} ?{second} WHERE {{}}");
+    let mut execution = engine.prepare_execution(
+        &query, None, &[first.as_str(), second.as_str()], QueryOptions::EMPTY,
+    ).unwrap();
+    let source = open_with_evidence(&image, CEILING, 2, 16_384);
+    let window = CurrentThreadWindow::open();
+    let error = engine.execute_fallible(
+        &mut execution, &source, QueryOptions::EMPTY, |_| (),
+    ).unwrap_err();
+    let measured = window.close();
+    assert!(u64::try_from(measured.peak_working_bytes).unwrap() <= source.evidence().peak_bytes());
+    let diagnostic = extract(error);
+    assert_eq!(diagnostic.code, "native-sparql-execution-parameter");
+    assert_eq!(diagnostic.message, format!("parameters still unbound: {first}, {second}"));
+    let live = source.evidence().live_bytes();
+    let window = CurrentThreadWindow::open();
+    let clone = diagnostic.clone();
+    assert_eq!(window.close().allocations, 0);
+    drop(diagnostic);
+    assert_eq!(source.evidence().live_bytes(), live);
+    drop(execution);
+    drop(engine);
+    assert_eq!(clone.code, "native-sparql-execution-parameter");
+    drop(clone);
+    assert!(source.evidence().live_bytes() < live);
+}
