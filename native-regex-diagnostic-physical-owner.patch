+impl<S: Admission + ?Sized> fmt::Write for FormatSink<'_, '_, S> {
+    fn write_str(&mut self, text: &str) -> fmt::Result {
+        let result = (|| {
+            let required = self.text.len().checked_add(text.len()).ok_or(StorageError::SizeOverflow)?;
