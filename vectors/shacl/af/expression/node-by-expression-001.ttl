# First-party PurRDF conformance case for the W3C "SHACL 1.2 Node Expressions"
# specification, section 7.2 (sh:nodeByExpression).
#
# "For each value node v: perform a conformance check of v against each output
# node of evalExpr(expr, data graph, v, {})."  The expression is evaluated with
# the VALUE NODE as focus, so each item names the shape it is judged against.
#
# See vectors/shacl/af/README.md for the directory's provenance rules.

@prefix ex:    <http://example.org/shacl12/node-expr/node-by-expression-001#> .
@prefix mf:    <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht:   <http://www.w3.org/ns/shacl-test#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <node-by-expression-001>
    ) ;
.

<node-by-expression-001>
  rdf:type sht:Validate ;
  rdfs:label "sh:nodeByExpression checks each value node against the shapes its expression computes" ;
  rdfs:comment """SHACL 1.2 Node Expressions section 7.2. Each ex:item value node
    names its own shape through ex:kind, and the node expression is evaluated with
    that value node as the focus node. ex:Labelled conforms to ex:ItemShape;
    ex:Unlabelled does not, so exactly one violation is reported, carrying
    sh:NodeByExpressionConstraintComponent.""" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Document ;
          sh:resultPath ex:item ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:NodeByExpressionConstraintComponent ;
          sh:sourceShape ex:DocumentShape-item ;
          sh:value ex:Unlabelled ;
        ] ;
    ] ;
  mf:status sht:approved ;
.

ex:DocumentShape
  rdf:type sh:NodeShape ;
  sh:targetClass ex:Document ;
  sh:property ex:DocumentShape-item ;
.

ex:DocumentShape-item
  rdf:type sh:PropertyShape ;
  sh:path ex:item ;
  sh:nodeByExpression [ shnex:pathValues ex:kind ] ;
.

ex:ItemShape
  rdf:type sh:NodeShape ;
  sh:property [
      sh:path ex:label ;
      sh:minCount 1 ;
    ] ;
.

ex:Document
  rdf:type ex:Document ;
  ex:item ex:Labelled ;
  ex:item ex:Unlabelled ;
.

ex:Labelled
  ex:kind ex:ItemShape ;
  ex:label "labelled" ;
.

ex:Unlabelled
  ex:kind ex:ItemShape ;
.
