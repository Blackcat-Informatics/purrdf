# First-party SHACL Rules ERROR case: a non-terminating rule.
# The SPARQLRule mints a strictly LONGER ex:Counter IRI every round, and each new
# Counter becomes a focus node that mints another — unbounded fresh-term
# introduction. The CONSTRUCT template carries no blank node, so this is a
# GENERAL rule (SPARQL 1.2 RL §4.4 stratification layers): it is evaluated
# repeatedly to fixpoint rather than exactly once, and nothing bounds it but the
# divergence guard.
# `apply_rules` detects the divergence (fresh-term-minting rounds exceed the
# deterministic, input-derived bound) and returns Err rather than looping forever.
# This directory has NO expected-inferred.ttl; the harness asserts the error.

@prefix ex:  <http://example.org/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .

ex:c0 rdf:type ex:Counter .

ex:CounterRule
  rdf:type sh:NodeShape ;
  sh:targetClass ex:Counter ;
  sh:rule [
      rdf:type sh:SPARQLRule ;
      sh:construct """CONSTRUCT { $this ex:next ?n . ?n a ex:Counter . }
                      WHERE { $this a ex:Counter .
                              BIND(IRI(CONCAT(STR($this), "0")) AS ?n) }""" ] .
