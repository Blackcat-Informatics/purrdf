+
+impl<I: ViewTermId> OwnedTriplePos<I> {
+    fn new_admitted(value: TriplePos<I>, workspace: &crate::WorkspaceCapability) -> Result<Self, EvalError> {
+        let allocation = workspace.charge(u64::try_from(size_of::<TriplePos<I>>())
+            .map_err(|_| EvalError::WorkspaceBoundOverflow)?)?;
+        let node = purrdf_core::small::try_boxed(value)
+            .map_err(|_| EvalError::AllocationFailed { construct: "compiled triple position" })?;
+        Ok(Self { node: Some(node), allocation: Some(allocation), parent: None, parent_allocation: None })
+    }
+
+    fn take(&mut self) -> Option<DetachedTriplePos<I>> {
+        self.node.take().map(|node| DetachedTriplePos { node, _allocation: self.allocation.take() })
+    }
