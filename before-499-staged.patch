-                // serialization in a second system that cannot be compared.
-                row("ga", geo("asWKT"), wkt(INSIDE)),
-                row("ga", geo("asWKT"), wkt(&other_crs_point)),
-                row("gq", geo("asWKT"), wkt(SQUARE)),
