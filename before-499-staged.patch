-                }
-                (Set::Interior, Set::Exterior) => {
-                    matrix.raise(Set::Interior, Set::Exterior, Dim::Two);
-                }
-                (Set::Exterior, Set::Interior) => {
-                    matrix.raise(Set::Exterior, Set::Interior, Dim::Two);
