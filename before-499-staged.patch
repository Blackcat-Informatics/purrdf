-/// Append the consecutive edges of one coordinate chain, planar-projected.
-fn push_chain(coords: &CoordSeq, out: &mut Vec<Edge>) {
-    for pair in coords.windows(2) {
-        out.push((plane(&pair[0]), plane(&pair[1])));
-    }
