+fn push_probe_constants_with_memory(core: &mut GraphPattern, probes: &[(Variable, GroundTerm)], memory: &mut RewriteMemory<'_>) -> RewriteResult<()> {
+
+    if probes.is_empty() {
+        return Ok(());
+    }
+    push_probes_with_memory(core, probes, true, memory)?;
