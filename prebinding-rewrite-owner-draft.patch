+fn seed_every_sub_select_with_memory(
+    root: &mut GraphPattern, probes: &[(Variable, GroundTerm)], memory: &mut RewriteMemory<'_>,
+) -> RewriteResult<()> {
+    let seeded: *const GraphPattern = core_slot(root);
+    seed_sub_selects_in_with_memory(root, probes, seeded, memory)
+}
+
+fn seed_sub_selects_in_with_memory(
+    root: &mut GraphPattern, probes: &[(Variable, GroundTerm)], seeded: *const GraphPattern,
+    memory: &mut RewriteMemory<'_>,
+) -> RewriteResult<()> {
+    if probes.is_empty() { return Ok(()); }
+    let mut pending = rewrite_scratch([(root, true)], memory)?;
+    while let Some((node, top)) = pending.pop() {
+        if !top && matches!(node, GraphPattern::Project { .. }) {
+            let GraphPattern::Project { inner, .. } = node else { unreachable!("Project matched") };
+            if !std::ptr::eq(core_slot(inner), seeded) {
+                let core = core_slot(inner);
+                let seed = seed_entries_with_memory(probes.iter(), memory)?;
+                *core = rewrite_join(seed, take_child(core), memory)?;
+                let GraphPattern::Join { right, .. } = core else { unreachable!("seed joined here") };
+                pending.push((&mut **right, false))?;
+                continue;
+            }
+            pending.push((&mut **inner, false))?;
+            continue;
+        }
+        let child_top = top && matches!(node, GraphPattern::Distinct { .. } | GraphPattern::Reduced { .. }
+            | GraphPattern::Slice { .. } | GraphPattern::OrderBy { .. });
+        push_child_patterns_with_memory(node, &mut pending, |child| (child, child_top))?;
+    }
+    Ok(())
+}
+
+fn seed_above_a_lone_sub_select_with_memory(
+    pattern: &mut GraphPattern, probes: &[(Variable, GroundTerm)], memory: &mut RewriteMemory<'_>,
+) -> RewriteResult<()> {
+    let mut core = pattern;
+    let mut projected = false;
+    loop {
+        match core {
+            GraphPattern::Project { .. } if projected => break,
+            GraphPattern::Project { inner, .. } => { projected = true; core = inner; }
+            GraphPattern::Distinct { inner } | GraphPattern::Reduced { inner } | GraphPattern::Slice { inner, .. }
+            | GraphPattern::OrderBy { inner, .. } | GraphPattern::Group { inner, .. } | GraphPattern::Extend { inner, .. }
+            | GraphPattern::Filter { inner, .. } | GraphPattern::Unfold { inner, .. } => core = inner,
+            _ => return Ok(()),
+        }
+    }
+    let seed = seed_entries_with_memory(probes.iter(), memory)?;
+    *core = rewrite_join(seed, take_child(core), memory)?;
+    Ok(())
+}
