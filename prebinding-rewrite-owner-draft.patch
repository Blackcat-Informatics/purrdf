+fn push_probes_with_memory(pattern: &mut GraphPattern, probes: &[(Variable, GroundTerm)], at_core_root: bool, memory: &mut RewriteMemory<'_>) -> RewriteResult<()> {
+
+    let mut open: crate::AdmittedVec<PushFrame<'_>> = crate::AdmittedVec::new(&rewrite_workspace(memory));
+    let mut next = (take_child(pattern), ProbeList::Whole(probes), at_core_root);
+    loop {
+        let (node, probes, at_core_root) = next;
+        let mut finished = match enter_push_with_memory(node, probes, at_core_root, &mut open, memory)? {
+            Step::Descend(child) => {
+                next = child;
+                continue;
+            }
+            Step::Finished(node) => node,
+        };
+        loop {
+            let Some(frame) = open.pop() else {
+                *pattern = finished;
+                return Ok(());
+            };
+            match resume_push_with_memory(frame, finished, &mut open, memory)? {
+                Step::Descend(child) => {
+                    next = child;
+                    break;
+                }
+                Step::Finished(node) => finished = node,
+            }
+        }
+    }
+}
