+fn seed_minus_in_with_memory(
+    root: &mut GraphPattern, probes: &[(Variable, GroundTerm)], in_exists: bool, fresh: &mut usize,
+    memory: &mut RewriteMemory<'_>,
+) -> RewriteResult<()> {
+    if probes.is_empty() { return Ok(()); }
