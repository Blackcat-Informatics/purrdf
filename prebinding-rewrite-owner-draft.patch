+#[cfg(test)]
+fn restore_probed_bindings(leaf: &mut GraphPattern, probed: &[usize], probes: &[(Variable, GroundTerm)], at_core_root: bool) {
+    resident_rewrite(|memory| restore_probed_bindings_with_memory(leaf, probed, probes, at_core_root, memory))
+}
