+fn join_assignments_in_with_memory(
+    root: &mut GraphPattern, on_descent: bool, in_exists: bool, names: &[&str], fresh: &mut usize,
+    memory: &mut RewriteMemory<'_>,
+) -> RewriteResult<()> {
+    scope_walk_with_memory(root, ScopeFlags {
+        joined: on_descent && !in_exists, on_descent: on_descent || in_exists, in_exists,
+    }, ScopeOperation::Assign { names, fresh }, memory)
+}
+
+pub(crate) fn join_assignments_with_prebinding_with_memory(
+    query: &mut Query, names: &[&str], memory: &mut RewriteMemory<'_>,
+) -> RewriteResult<bool> {
+    if !needs_assignment_join_with_memory(query, names, memory)? { return Ok(false); }
+    let pattern = query_pattern_mut(query);
+    let mut fresh = highest_index_with_memory(pattern, ASSIGNED_PREFIX, memory)?;
+    join_assignments_in_with_memory(pattern, true, false, names, &mut fresh, memory)?;
+    Ok(true)
+}
+
+pub(crate) fn needs_assignment_join_with_memory(
+    query: &Query, names: &[&str], memory: &mut RewriteMemory<'_>,
+) -> RewriteResult<bool> {
+    use purrdf_sparql_algebra::walk::NodeRef;
+    if names.is_empty() { return Ok(false); }
+    let root = ScopeFlags { on_descent: true, in_exists: false, joined: true };
+    let mut pending = rewrite_scratch([(NodeRef::Pattern(query.pattern()), root)], memory)?;
+    while let Some((node, flags)) = pending.pop() {
+        let child_flags = match node {
+            NodeRef::Pattern(pattern) => {
+                let binds = |variable: &Variable| names.contains(&variable.as_str());
+                let changes = match pattern {
+                    GraphPattern::Extend { variable, .. } => binds(variable),
+                    GraphPattern::Unfold { element, companion, .. } => binds(element) || companion.as_ref().is_some_and(binds),
+                    GraphPattern::Group { aggregates, .. } => aggregates.iter().any(|(variable, _)| binds(variable)),
+                    GraphPattern::Values { variables, .. } if !flags.joined => variables.iter().any(binds),
+                    _ => false,
+                };
+                if changes { return Ok(true); }
+                let wrapper = matches!(pattern, GraphPattern::Project { .. } | GraphPattern::Distinct { .. }
+                    | GraphPattern::Reduced { .. } | GraphPattern::Slice { .. } | GraphPattern::OrderBy { .. }
+                    | GraphPattern::Group { .. } | GraphPattern::Extend { .. } | GraphPattern::Filter { .. }
+                    | GraphPattern::Unfold { .. });
+                ScopeFlags {
+                    on_descent: flags.in_exists || (flags.on_descent && wrapper),
+                    in_exists: flags.in_exists,
+                    joined: !flags.in_exists && ((flags.on_descent && wrapper)
+                        || (flags.joined && matches!(pattern, GraphPattern::Join { .. } | GraphPattern::Union { .. } | GraphPattern::Graph { .. }))),
+                }
+            }
+            NodeRef::Expr(Expression::Exists(_)) => ScopeFlags { on_descent: true, in_exists: true, joined: false },
+            _ => flags,
+        };
+        let mut count = Some(0_usize);
+        node.for_each_child(|_| count = count.and_then(|count| count.checked_add(1)));
+        pending.reserve_additional(count.ok_or(crate::EvalError::WorkspaceBoundOverflow)?)?;
+        node.for_each_child(|child| pending.push_reserved((child, child_flags)));
+    }
+    Ok(false)
+}
