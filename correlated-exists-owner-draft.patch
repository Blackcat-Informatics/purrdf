+fn substitute_expression_list<const PRESERVE: bool>(
+    source: &[Expression], row: &SubstitutionRow,
+    map: &mut Option<&mut SubstitutionTracking<'_>>, defer: &mut Deferral<'_>,
+    memory: &mut CorrelatedMemory<'_>,
+) -> Result<Vec<Expression>, EvalError> {
+    let mut copied = Vec::new();
+    memory.reserve(&mut copied,source.len()).map_err(|e| correlated_storage_error(memory,e))?;
+    for expression in source { copied.push(substitute_expr::<PRESERVE>(expression,row,map,defer,memory)?); }
+    Ok(copied)
+}
+fn substitute_order_list<const PRESERVE: bool>(
+    source: &[purrdf_sparql_algebra::OrderExpression], row: &SubstitutionRow,
+    map: &mut Option<&mut SubstitutionTracking<'_>>, defer: &mut Deferral<'_>,
+    memory: &mut CorrelatedMemory<'_>,
+) -> Result<Vec<purrdf_sparql_algebra::OrderExpression>, EvalError> {
+    let mut copied = Vec::new();
+    memory.reserve(&mut copied,source.len()).map_err(|e| correlated_storage_error(memory,e))?;
+    for order in source {
+        copied.push(crate::modifier::rebuild_order(order,
+            substitute_expr::<PRESERVE>(order.expression(),row,map,defer,memory)?));
+    }
+    Ok(copied)
+}
+fn substitute_aggregates<const PRESERVE: bool>(
+    source: &[(Variable,purrdf_sparql_algebra::AggregateExpression)], row: &SubstitutionRow,
+    map: &mut Option<&mut SubstitutionTracking<'_>>, defer: &mut Deferral<'_>,
+    memory: &mut CorrelatedMemory<'_>,
+) -> Result<Vec<(Variable,purrdf_sparql_algebra::AggregateExpression)>, EvalError> {
+    let mut copied = Vec::new();
+    memory.reserve(&mut copied,source.len()).map_err(|e| correlated_storage_error(memory,e))?;
+    for (variable,aggregate) in source {
+        let args = substitute_expression_list::<PRESERVE>(aggregate.args(),row,map,defer,memory)?;
+        let order = substitute_order_list::<PRESERVE>(aggregate.order_by(),row,map,defer,memory)?;
+        // The sole native scalar-values clone preserves key order, spelling and
+        // literal identity; checked original arity/count cannot change here.
+        let aggregate = aggregate.rebuild_with_memory(args,order,memory)
+            .map_err(|e| correlated_storage_error(memory,e))?;
+        copied.push((variable.clone(),aggregate));
+    }
+    Ok(copied)
+}
+
+fn join_selected_values(
+    node: Box<GraphPattern>, term_row: &[(Variable,purrdf_sparql_algebra::GroundTerm)],
+    selected: impl Fn(&Variable)->bool, source: &GraphPattern,
+    map: &mut Option<&mut SubstitutionTracking<'_>>, memory: &mut CorrelatedMemory<'_>,
+) -> Result<Box<GraphPattern>, EvalError> {
+    let count = term_row.iter().filter(|(v,_)| selected(v)).count();
+    if count == 0 { return Ok(node); }
+    let mut variables = Vec::new();
+    let mut values = Vec::new();
+    memory.reserve(&mut variables,count).map_err(|e| correlated_storage_error(memory,e))?;
+    memory.reserve(&mut values,count).map_err(|e| correlated_storage_error(memory,e))?;
+    for (variable,value) in term_row.iter().filter(|(v,_)| selected(v)) {
+        variables.push(variable.clone());
+        values.push(Some(value.clone_with_memory(memory).map_err(|e| correlated_storage_error(memory,e))?));
+    }
+    let mut bindings = Vec::new();
+    memory.push(&mut bindings,values).map_err(|e| correlated_storage_error(memory,e))?;
+    demote_to_scaffolding(map,std::ptr::from_ref(node.as_ref()) as usize);
+    let values = boxed_and_mapped_scaffolding(GraphPattern::Values { variables,bindings },source,map,memory)?;
+    boxed_and_mapped(GraphPattern::Join { left:node.into(),right:values.into() },source,map,memory)
+}
