+pub(super) fn failure_record(p: u64, tied: u64, nodes: u64, lines: u64) -> FailureRecord {
+    FailureRecord {
+        path_position: p,
+        tied_cell: tied,
+        component_nodes: nodes,
+        component_lines: lines,
+    }
+}
