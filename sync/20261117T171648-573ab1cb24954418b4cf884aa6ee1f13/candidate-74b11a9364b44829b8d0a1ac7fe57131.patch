+pub(super) fn quad(s: &str, p: &str, o: &str) -> Line {
+    Line::Quad {
+        subject: term(s),
+        predicate: term(p),
+        object: term(o),
+        graph: None,
+    }
+}
+
+fn quads(spec: &[(&str, &str, &str)]) -> Vec<Line> {
+    spec.iter().map(|&(s, p, o)| quad(s, p, o)).collect()
+}
