+
+impl ExecutionSources {
+    /// The sources of a run that read one dataset view, given its content identity.
+    #[must_use]
+    pub const fn new(dataset: purrdf_hash::hex::Digest32) -> Self {
+        Self {
+            dataset,
+            focus_graph: None,
+        }
+    }
+    /// Add the content identity of the run's focus graph.
+    #[must_use]
