+}
+
+#[test]
+fn the_optimised_engine_agrees_on_every_set_of_q5dense_stride_1() {
+    q5dense_stride(1);
+}
+
+#[test]
+fn the_optimised_engine_agrees_on_every_set_of_q5dense_stride_2() {
+    q5dense_stride(2);
+}
+
+#[test]
+fn the_optimised_engine_agrees_on_every_set_of_q5dense_stride_3() {
+    q5dense_stride(3);
+}
