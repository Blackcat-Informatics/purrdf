+/// The one `purrdf-execution` receipt a run printed on stderr.
+fn receipt(out: &Output) -> purrdf_lex::json::Value {
+    let text = stderr(out);
+    let line = text
+        .lines()
+        .find_map(|line| line.strip_prefix("purrdf-execution "))
