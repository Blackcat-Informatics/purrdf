         let dataset = RdfDatasetBuilder::new().freeze().expect("empty dataset");
diff --git crates/sparql-eval/src/eval/cursor_answer.rs crates/sparql-eval/src/eval/cursor_answer.rs
new file mode 100644
index 000000000..eb00e3454
--- /dev/null
+++ crates/sparql-eval/src/eval/cursor_answer.rs
@@ -0,0 +1,130 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+//! Incremental native answer status under the original evidence admission.
+
+use crate::evidence_exec::{EvidenceAdmission, StatusFailure, answer_failure, observe_answer_rows};
+use crate::solution::{RetainedRow, SolutionSeq};
+use crate::{EvalError, RowEvidence, WorkspaceCapability};
+use purrdf_core::ViewTermId;
+use purrdf_core::evidence::{
+    AnswerAccumulator, AnswerError, AnswerRequest, AnswerTier, EvidencePartition, WitnessVerdict,
+};
+
+pub(super) struct CursorAnswer {
+    answer: AnswerAccumulator<EvidenceAdmission>,
+    admission: EvidenceAdmission,
+    workspace: WorkspaceCapability,
+    verdict: bool,
+    observed_stop: bool,
+    settled: bool,
+}
+
+impl CursorAnswer {
+    pub(super) fn new(
+        request: AnswerRequest,
+        workspace: &WorkspaceCapability,
+    ) -> Result<Self, EvalError> {
+        let admission = EvidenceAdmission::new(workspace)?;
+        Ok(Self {
+            answer: AnswerAccumulator::with_admission(request, admission.clone()),
+            admission,
+            workspace: workspace.clone(),
+            verdict: request.tier == AnswerTier::Verdict,
+            observed_stop: false,
+            settled: false,
+        })
+    }
+
+    fn failure(&self, error: StatusFailure) -> EvalError {
+        match error {
+            StatusFailure::Answer(AnswerError::Storage(error)) => self.admission.storage_error(
+                error,
+                "native cursor answer reason counts",
+                &self.workspace,
+            ),
+            error => answer_failure(error, &self.workspace),
+        }
+    }
+
+    pub(super) const fn is_verdict(&self) -> bool {
+        self.verdict
+    }
+
+    pub(super) fn witness_stop(&self) -> Option<WitnessVerdict> {
+        self.answer.witness_stop()
+    }
+
+    fn observe_search(&mut self, search: &RowEvidence) -> Result<(), EvalError> {
+        search
+            .with_record(|record| {
+                self.answer
+                    .observe_search(record, search.permits_closed_absence())
+            })?
+            .map_err(|error| self.failure(StatusFailure::Answer(error)))
+    }
+
+    pub(super) fn begin_block(&mut self, search: Option<&RowEvidence>) -> Result<(), EvalError> {
+        if self.verdict
+            && let Some(search) = search
+        {
+            self.observe_search(search)?;
+        }
+        Ok(())
+    }
+
+    pub(super) fn observe_row<I: ViewTermId>(
+        &mut self,
+        row: &RetainedRow<I>,
+    ) -> Result<(), EvalError> {
+        if self.observed_stop {
+            return Ok(());
+        }
+        let partition = if row.evidence().is_undecided() {
+            EvidencePartition::Undecided
+        } else {
+            EvidencePartition::Established
+        };
+        row.evidence()
+            .with_record(|record| self.answer.observe(record, partition))?
+            .map_err(|error| self.failure(StatusFailure::Answer(error)))?;
+        self.observed_stop = self.answer.witness_stop().is_some();
+        Ok(())
+    }
+
+    pub(super) fn observe_block<I: ViewTermId>(
+        &mut self,
+        rows: &SolutionSeq<I>,
+        search: Option<&RowEvidence>,
+    ) -> Result<(), EvalError> {
+        self.begin_block(search)?;
+        observe_answer_rows(&mut self.answer, rows).map_err(|error| self.failure(error))?;
+        self.observed_stop = self.answer.witness_stop().is_some();
+        Ok(())
+    }
+
+    pub(super) fn finish(
+        &mut self,
+        search: &RowEvidence,
+        exhausted: bool,
+    ) -> Result<(), EvalError> {
+        self.observe_search(search)?;
+        if exhausted || self.answer.witness_stop().is_some() {
+            self.answer
+                .finish(exhausted)
+                .map_err(|error| self.failure(StatusFailure::Answer(error)))?;
+            self.settled = true;
+        }
+        Ok(())
+    }
+
+    pub(super) fn status(&self) -> Result<super::CursorAnswerStatus<'_>, EvalError> {
+        if !self.settled {
+            return Ok(super::CursorAnswerStatus::UnreadSuffix);
+        }
+        self.answer
+            .status()
+            .map(super::CursorAnswerStatus::Settled)
+            .map_err(|error| self.failure(StatusFailure::Answer(error)))
+    }
+}
diff --git crates/sparql-eval/src/eval/cursor_buffering.rs crates/sparql-eval/src/eval/cursor_buffering.rs
new file mode 100644
index 000000000..9bf7f0ca7
--- /dev/null
+++ crates/sparql-eval/src/eval/cursor_buffering.rs
@@ -0,0 +1,105 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+//! A fixed, admitted record of the buffering strategies execution actually selected.
+
+use crate::workspace::SharedWorkspace;
+use crate::{EvalError, WorkspaceCapability};
+use std::sync::atomic::{AtomicU16, Ordering};
+
+/// An original operator unit retained while the cursor delivers its answer.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[repr(u8)]
+pub enum CursorBufferReason {
+    /// ORDER BY retains its input rows and ordering keys.
+    OrderedInput,
+    /// GROUP BY or an aggregate retains its grouping/input state.
+    AggregateState,
+    /// DISTINCT/REDUCED retains alternatives until their evidence is coalesced.
+    EvidenceCoalescing,
+    /// DISTINCT/REDUCED retains the identities it has already emitted.
+    DistinctKeys,
+    /// Stateful expressions retain their original operator-major input unit.
+    StatefulExpression,
+    /// A selected join driver is retained before evaluating its driven relation.
+    DriverRelation,
+    /// A join/OPTIONAL/MINUS probe relation is retained for matching rows.
+    ProbeRelation,
+    /// A compiled BGP retains an earlier stage's intermediate relation.
+    IntermediateRelation,
+    /// Property-path traversal retains its reachability sets and work state.
+    PathReachability,
+    /// Coupled finite governors or a stop signal require a settled rollback unit.
+    GovernorSettlement,
+    /// An explicit semantic verdict preserves the original producer's commit unit.
+    VerdictCommitUnit,
+    /// A host relation invocation retains its original invocation unit.
+    HostInvocation,
+    /// A selected certified physical plan retains its native execution unit.
+    PhysicalPlan,
+}
+
+impl CursorBufferReason {
+    const ALL: [Self; 13] = [
+        Self::OrderedInput,
+        Self::AggregateState,
+        Self::EvidenceCoalescing,
+        Self::DistinctKeys,
+        Self::StatefulExpression,
+        Self::DriverRelation,
+        Self::ProbeRelation,
+        Self::IntermediateRelation,
+        Self::PathReachability,
+        Self::GovernorSettlement,
+        Self::VerdictCommitUnit,
+        Self::HostInvocation,
+        Self::PhysicalPlan,
+    ];
+}
+
+/// Buffering selected so far, copied without allocating or advancing a source.
+/// Each reason appears at most once, regardless of rows or operator re-entry.
+#[derive(Clone, Copy, Default, PartialEq, Eq)]
+pub struct CursorBufferingReport(u16);
+
+impl CursorBufferingReport {
+    /// Whether execution has selected no retaining operator unit so far.
+    #[must_use]
+    pub const fn is_empty(self) -> bool {
+        self.0 == 0
+    }
+
+    /// Whether this retaining strategy was actually selected.
+    #[must_use]
+    pub const fn contains(self, reason: CursorBufferReason) -> bool {
+        self.0 & (1 << reason as u8) != 0
+    }
+
+    /// Selected reasons in a fixed presentation order.
+    pub fn reasons(self) -> impl Iterator<Item = CursorBufferReason> {
+        CursorBufferReason::ALL
+            .into_iter()
+            .filter(move |reason| self.contains(*reason))
+    }
+}
+
+impl std::fmt::Debug for CursorBufferingReport {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.debug_set().entries(self.reasons()).finish()
+    }
+}
+
+#[derive(Clone)]
+pub(super) struct BufferingTrace(SharedWorkspace<AtomicU16>);
+
+impl BufferingTrace {
+    pub(super) fn new(workspace: &WorkspaceCapability) -> Result<Self, EvalError> {
+        SharedWorkspace::new_admitted(AtomicU16::new(0), workspace).map(Self)
+    }
+    pub(super) fn note(&self, reason: CursorBufferReason) {
+        self.0.fetch_or(1 << reason as u8, Ordering::Relaxed);
+    }
+    pub(super) fn report(&self) -> CursorBufferingReport {
+        CursorBufferingReport(self.0.load(Ordering::Relaxed))
+    }
+}
