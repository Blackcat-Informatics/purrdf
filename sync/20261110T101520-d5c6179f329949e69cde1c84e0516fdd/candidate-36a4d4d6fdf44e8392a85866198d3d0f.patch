+                    &workspace.capability(),
+                )?,
+                &workspace.capability(),
+            )?
+            .schema;
+            return Ok((
+                PreparedCursorExecution::Refused {
+                    exhausted,
+                    answer_requested: answer.is_some(),
+                    schema,
+                },
+                QueryCoordinates::NotStarted,
+                identity,
+            ));
+        }
+        let (cursor, coordinates) = self.select_cursor_admitted(
+            dataset,
+            prepared,
+            substitutions,
+            options,
+            workspace,
+            publication,
+            source,
+            answer,
+            Some(state),
+        )?;
+        Ok((
+            PreparedCursorExecution::Active(cursor),
+            coordinates,
+            identity,
+        ))
+    }
+}
