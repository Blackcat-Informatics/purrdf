+// Shared admitted closing-delimiter scan. The caller owns opening policy.
+fn close<S: Admission + ?Sized>(
+    scan: &mut Scan<'_, '_, S>,
+    mut at: usize,
+    closer: &[u8],
+) -> Option<(usize, bool)> {
