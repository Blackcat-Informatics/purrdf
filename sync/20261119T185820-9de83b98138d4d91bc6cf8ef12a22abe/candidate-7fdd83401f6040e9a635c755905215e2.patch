+/// One row of `walk`: START, REFINE, FIX-SUM, SPLIT, TWIN, the total and `A`.
+fn row(walk: &Walk, allowance: u64) -> [u64; 7] {
+    let t = walk.totals();
+    [
+        t.start,
+        t.refine,
+        t.fix_sum,
+        t.split,
+        t.twin,
+        walk.total(),
+        allowance,
+    ]
+}
