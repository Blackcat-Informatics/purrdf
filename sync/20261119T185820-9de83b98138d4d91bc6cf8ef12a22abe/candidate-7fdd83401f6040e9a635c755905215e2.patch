+    let inputs: [(&str, Vec<Line>, [u64; 20]); 3] = [
+        ("COMPL(3,5)", complement_of_cycles(3, 5, false), compl),
+        ("CUB8", cub8(), cub8_totals),
+        ("QR13", quadratic_residue_13("r"), qr13),
