diff --git .github/workflows/release-pypi.yaml .github/workflows/release-pypi.yaml
index a3bbe9277..bb405ab1e 100644
--- .github/workflows/release-pypi.yaml
+++ .github/workflows/release-pypi.yaml
@@ -13,13 +13,22 @@ name: Publish coordinated PurRDF Python distributions
 permissions: {}
 
 concurrency:
-  # Rehearsals use their own group and cannot replace a pending publish.
-  group: python-release-${{ github.event_name == 'workflow_dispatch' && (inputs.publish && 'py-v5.0.1' || 'rehearsal-py-v5.0.1') || github.ref_name }}
+  # Rehearsals and rejected recovery requests cannot replace a pending publish.
+  group: >-
+    python-release-${{ github.event_name == 'workflow_dispatch' &&
+      (inputs.publish && (!inputs.recover ||
+        (github.repository == 'Blackcat-Informatics/purrdf' &&
+         github.ref == 'refs/heads/main' && github.ref_protected)) &&
+       'py-v5.0.1' || 'rehearsal-py-v5.0.1') || github.ref_name }}
   cancel-in-progress: false
 
 on:
   workflow_dispatch:
     inputs:
