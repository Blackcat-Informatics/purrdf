+        crate::blake3::Backend::Avx2 => {
+            // SAFETY: the checked backend requires AVX2.
+            unsafe { blake3_avx2::messages(inputs, mode, out) };
+            Some(())
+        }
+        #[cfg(any(target_arch = "x86", target_arch = "x86_64"))]
