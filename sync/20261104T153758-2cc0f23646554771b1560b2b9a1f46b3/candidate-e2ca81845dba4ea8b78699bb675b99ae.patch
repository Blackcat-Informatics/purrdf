new file mode 100644
index 000000000..45365e507
--- /dev/null
+++ crates/yaml/src/profile.rs
@@ -0,0 +1,328 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+use crate::YamlError;
+use purrdf_core::{BaseIri, ContentDigest};
+use purrdf_hash::{Domain, frame::frame_le};
+use purrdf_lex::{
+    allocation::{Admission, Memory, Resident, StorageError},
+    yaml::SyntaxStreamLimits,
+};
+
+/// Explicitly offered vocabulary; never supplied implicitly by analysis.
+pub const STANDARD_NAMESPACE: &str = "https://w3id.org/purrdf/yaml#";
+pub(crate) const SPECIFICATION: &str = "yaml-1.2.2-acyclic-lexical-stream-cover-v1";
+const PROFILE_DOMAIN: Domain = Domain::new(b"purrdf-yaml-profile-v1");
+const STREAM_DOMAIN: Domain = Domain::new(b"purrdf-yaml-stream-v1");
+pub(crate) const MAX_IDENTIFIER_BYTES: usize = 4096;
+pub(crate) const TERMS: &[&str] = &[
+    "Stream",
+    "Document",
+    "Node",
+    "Item",
+    "Entry",
+    "Trivia",
+    "Directive",
+    "Escape",
+    "CoverSpan",
+    "source",
+    "sourceDigest",
+    "lexBlake3",
+    "byteLength",
+    "profile",
+    "profileName",
+    "profileVersion",
+    "vocabulary",
+    "specification",
+    "stream",
+    "document",
+    "ordinal",
+    "byteStart",
+    "byteEnd",
+    "prologueStart",
+    "prologueEnd",
+    "startMarkerStart",
+    "startMarkerEnd",
+    "endMarkerStart",
+    "endMarkerEnd",
+    "root",
+    "node",
+    "item",
+    "entry",
+    "key",
+    "value",
+    "parent",
+    "kind",
+    "style",
+    "text",
+    "rawStart",
+    "rawEnd",
+    "rawText",
+    "anchorStart",
+    "anchorEnd",
+    "anchorText",
+    "tagStart",
+    "tagEnd",
+    "tagText",
+    "tagKind",
+    "tagName",
+    "explicitKeyStart",
+    "explicitKeyEnd",
+    "blockStart",
+    "blockEnd",
+    "chomping",
+    "indentIndicator",
+    "contentIndent",
+    "target",
+    "attachment",
+    "attachmentNode",
+    "decoded",
+    "escapeKind",
+    "verbatim",
+    "verbatimText",
+    "sha256Digest",
+    "blake3Digest",
+];
+
+/// Cached terms derived under an explicit caller namespace.
+#[derive(Debug)]
+pub struct Vocabulary {
+    base: String,
+    terms: Vec<String>,
+}
+impl Vocabulary {
+    /// Validate and cache a namespace ending in slash or hash, at most 2,048 bytes.
+    pub fn under(base: &str) -> Result<Self, YamlError> {
+        if base.len() > 2048 || !base.ends_with(['/', '#']) {
+            return Err(YamlError::Profile(
+                "namespace must end in / or # and fit 2,048 bytes",
+            ));
+        }
+        validate_iri(base)?;
+        let mut resident = Resident;
+        let mut memory = Memory::new(&mut resident);
+        let mut terms = Vec::new();
+        for local in TERMS {
+            let text = memory.format(&format_args!("{base}{local}"))?;
+            validate_iri(&text)?;
+            memory.push(&mut terms, text)?;
+        }
+        Ok(Self {
+            base: memory.string(base)?,
+            terms,
+        })
+    }
+    /// Explicitly opt into the shipped vocabulary.
+    pub fn standard() -> Result<Self, YamlError> {
+        Self::under(STANDARD_NAMESPACE)
+    }
+    /// The exact namespace.
+    pub fn base(&self) -> &str {
+        &self.base
+    }
+    /// A known vocabulary term; unknown locals are configuration failures.
+    pub fn term(&self, local: &str) -> Result<&str, YamlError> {
+        TERMS
+            .iter()
+            .position(|&term| term == local)
+            .map(|index| self.terms[index].as_str())
+            .ok_or(YamlError::Profile("unknown vocabulary local name"))
+    }
+}
+
+/// Separate explicit phase ceilings, all included in profile identity.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Bounds {
+    /// Complete source/occurrence/parser admission through Lex.
+    pub syntax: SyntaxStreamLimits,
+    /// Maximum distinct partition spans.
+    pub max_cover_spans: usize,
+    /// Partition, identity and coverage verification scratch, additional to Lex.
+    pub max_partition_bytes: usize,
+    /// Maximum projected or selected metadata statements.
+    pub max_statements: usize,
+    /// Sum of lexical/IRI component bytes over metadata statements, before deduplication.
+    pub max_payload_bytes: usize,
+    /// Additional RDF builder, index, temporary text and freeze storage.
+    pub max_projection_bytes: usize,
+    /// Selected metadata collection and shared cover reconstruction storage.
+    pub max_decode_bytes: usize,
+}
+impl Bounds {
+    /// Explicit standard bounds: 16 MiB input, one million occurrences/documents,
+    /// depth 128, 128 MiB Lex, 64 MiB partition, two million RDF statements,
+    /// and 512 MiB payload/projection plus 256 MiB decode storage.
+    pub const fn standard() -> Self {
+        Self {
+            syntax: SyntaxStreamLimits {
+                syntax: purrdf_lex::yaml::SyntaxLimits::DEFAULT,
+                max_documents: 1 << 20,
+            },
+            max_cover_spans: (2 << 20) + 1,
+            max_partition_bytes: 64 << 20,
+            max_statements: 2 << 20,
+            max_payload_bytes: 512 << 20,
+            max_projection_bytes: 512 << 20,
+            max_decode_bytes: 256 << 20,
+        }
+    }
+}
+
+/// Versioned, immutable source grammar, vocabulary and phase-admission law.
+#[derive(Debug)]
+pub struct Profile {
+    name: String,
+    version: u32,
+    vocabulary: Vocabulary,
+    bounds: Bounds,
+    identity: ContentDigest,
+}
+impl Profile {
+    /// Bind a nonempty caller name/version, vocabulary and portable phase bounds.
+    /// Zero resource ceilings are legitimate refusal policies.
+    pub fn new(
+        name: &str,
+        version: u32,
+        vocabulary: Vocabulary,
+        bounds: Bounds,
+    ) -> Result<Self, YamlError> {
+        if name.is_empty() || name.len() > 1024 || version == 0 {
+            return Err(YamlError::Profile(
+                "nonempty name within 1,024 bytes and nonzero version required",
+            ));
+        }
+        let numbers = bounds.numbers();
+        if numbers.iter().any(|&number| number > u64::from(u32::MAX)) {
+            return Err(YamlError::Profile(
+                "phase bounds must fit portable 32-bit counts",
+            ));
+        }
+        let mut resident = Resident;
+        let mut memory = Memory::new(&mut resident);
+        let mut fields = Vec::new();
+        for field in [
+            PROFILE_DOMAIN.as_bytes(),
+            SPECIFICATION.as_bytes(),
+            name.as_bytes(),
+            vocabulary.base().as_bytes(),
+        ] {
+            memory.push(&mut fields, field)?;
+        }
+        for &term in TERMS {
+            memory.push(&mut fields, term.as_bytes())?;
+        }
+        let mut bytes = framed(&fields, &mut memory)?;
+        let required = bytes
+            .len()
+            .checked_add(4 + numbers.len() * 8 + 1)
+            .ok_or(StorageError::SizeOverflow)?;
+        memory.reserve(&mut bytes, required)?;
+        bytes.extend_from_slice(&version.to_le_bytes());
+        for number in numbers {
+            bytes.extend_from_slice(&number.to_le_bytes());
+        }
+        bytes.push(u8::from(bounds.syntax.syntax.aliases));
+        let identity = ContentDigest::of(&bytes);
+        Ok(Self {
+            name: memory.string(name)?,
+            version,
+            vocabulary,
+            bounds,
+            identity,
+        })
+    }
+    /// Explicitly select the shipped schema, vocabulary and standard bounds.
+    pub fn standard() -> Result<Self, YamlError> {
+        Self::new(
+            "purrdf-yaml-source",
+            1,
+            Vocabulary::standard()?,
+            Bounds::standard(),
+        )
+    }
+    /// SHA-256 of the complete versioned profile law.
+    pub const fn identity(&self) -> ContentDigest {
+        self.identity
+    }
+    /// Caller profile name.
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+    /// Caller profile version.
+    pub const fn version(&self) -> u32 {
+        self.version
+    }
+    /// Cached caller vocabulary.
+    pub const fn vocabulary(&self) -> &Vocabulary {
+        &self.vocabulary
+    }
+    /// Exact phase bounds.
+    pub const fn bounds(&self) -> Bounds {
+        self.bounds
+    }
+    pub(crate) fn stream_id<S: Admission + ?Sized>(
+        &self,
+        source: &str,
+        digest: ContentDigest,
+        memory: &mut Memory<'_, S>,
+    ) -> Result<String, YamlError> {
+        let bytes = framed(
+            &[
+                STREAM_DOMAIN.as_bytes(),
+                source.as_bytes(),
+                self.identity.as_bytes(),
+                digest.as_bytes(),
+            ],
+            memory,
+        )?;
+        let identity = ContentDigest::of(&bytes);
+        memory.release_vec(bytes)?;
+        Ok(memory.format(&format_args!("urn:purrdf:yaml:{identity}"))?)
+    }
+}
+
+impl Bounds {
+    fn numbers(self) -> [u64; 11] {
+        [
+            self.syntax.syntax.max_input_bytes as u64,
+            self.syntax.syntax.max_allocation_bytes as u64,
+            self.syntax.syntax.max_occurrences,
+            self.syntax.syntax.max_depth as u64,
+            self.syntax.max_documents as u64,
+            self.max_cover_spans as u64,
+            self.max_partition_bytes as u64,
+            self.max_statements as u64,
+            self.max_payload_bytes as u64,
+            self.max_projection_bytes as u64,
+            self.max_decode_bytes as u64,
+        ]
+    }
+}
+pub(crate) fn validate_iri(text: &str) -> Result<(), YamlError> {
+    if text.len() > MAX_IDENTIFIER_BYTES {
+        return Err(YamlError::Limit {
+            resource: "identifier bytes",
+            limit: MAX_IDENTIFIER_BYTES,
+        });
+    }
+    let mut resident = Resident;
+    let mut memory = Memory::new(&mut resident);
+    BaseIri::parse_with_memory(text, &mut memory)?;
+    Ok(())
+}
+fn framed<S: Admission + ?Sized>(
+    fields: &[&[u8]],
+    memory: &mut Memory<'_, S>,
+) -> Result<Vec<u8>, StorageError> {
+    let length = fields.iter().try_fold(0_usize, |size, field| {
+        size.checked_add(8)
+            .and_then(|size| size.checked_add(field.len()))
+            .ok_or(StorageError::SizeOverflow)
+    })?;
+    let mut bytes = Vec::new();
+    memory.reserve(&mut bytes, length)?;
+    for field in fields {
+        frame_le(&mut bytes, field);
+    }
+    Ok(bytes)
+}
diff --git crates/yaml/src/project.rs crates/yaml/src/project.rs
new file mode 100644
index 000000000..383260475
--- /dev/null
+++ crates/yaml/src/project.rs
@@ -0,0 +1,470 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+use crate::{
+    Ceiling, Document, Profile, SourceDocument, YamlError, admit_count, analyze,
+    profile::{SPECIFICATION, TERMS},
+};
+use purrdf_core::{
+    RdfDataset, RdfDatasetBuilder, TermId, TermRef,
+    datatype::{XSD_INTEGER, XSD_STRING},
+};
+use purrdf_lex::{
+    allocation::{Memory, OrderedTable, StorageError},
+    yaml::{
+        Attachment, Chomping, CollectionStyle, ExplicitTag, NodeId, NodeKind, ScalarStyle, Span,
+        TriviaKind,
+    },
+};
+
+#[derive(Clone, Copy)]
+enum Object<'a> {
+    Id(TermId),
+    Iri(&'a str),
+    Text(&'a str),
+    Typed(&'a str, &'a str),
+}
+struct Emitter<'p, 'm, 's> {
+    profile: &'p Profile,
+    memory: &'m mut Memory<'s, Ceiling>,
+    builder: RdfDatasetBuilder,
+    predicates: Vec<TermId>,
+    rdf_type: TermId,
+    root: TermId,
+    nodes: OrderedTable<NodeId, TermId>,
+    statements: usize,
+    payload: usize,
+}
+impl<'p, 'm, 's> Emitter<'p, 'm, 's> {
+    fn new(
+        profile: &'p Profile,
+        root: &str,
+        memory: &'m mut Memory<'s, Ceiling>,
+    ) -> Result<Self, YamlError> {
+        let mut builder = RdfDatasetBuilder::new();
+        let rdf_type = builder.intern_iri_with_memory(purrdf_core::vocab::rdf::TYPE, memory)?;
+        let root = builder.intern_iri_with_memory(root, memory)?;
+        let mut predicates = Vec::new();
+        for local in TERMS {
+            let id = builder.intern_iri_with_memory(profile.vocabulary().term(local)?, memory)?;
+            memory.push(&mut predicates, id)?;
+        }
+        Ok(Self {
+            profile,
+            memory,
+            builder,
+            predicates,
+            rdf_type,
+            root,
+            nodes: OrderedTable::default(),
+            statements: 0,
+            payload: 0,
+        })
+    }
+    fn term(&self, local: &str) -> Result<TermId, YamlError> {
+        TERMS
+            .iter()
+            .position(|&term| term == local)
+            .map(|index| self.predicates[index])
+            .ok_or(YamlError::Profile("unknown emitted vocabulary term"))
+    }
+    fn node(&self, id: NodeId) -> Result<TermId, YamlError> {
+        self.nodes
+            .get(&id)
+            .copied()
+            .ok_or(YamlError::Metadata("native node target is absent"))
+    }
+    fn subject(
+        &mut self,
+        root: &str,
+        suffix: impl core::fmt::Display,
+    ) -> Result<TermId, YamlError> {
+        let text = self.memory.format(&format_args!("{root}#{suffix}"))?;
+        let id = self.builder.intern_iri_with_memory(&text, self.memory)?;
+        self.memory.release_string(text)?;
+        Ok(id)
+    }
+    fn fact(&mut self, subject: TermId, local: &str, object: Object<'_>) -> Result<(), YamlError> {
+        let bounds = self.profile.bounds();
+        let statements = self
+            .statements
+            .checked_add(1)
+            .ok_or(StorageError::SizeOverflow)?;
+        admit_count(statements, bounds.max_statements, "RDF statements")?;
+        let predicate = if local == "type" {
+            self.rdf_type
+        } else {
+            self.term(local)?
+        };
+        let object_bytes = match object {
+            Object::Id(id) => iri_bytes(self.builder.resolve(id))?,
+            Object::Iri(text) => text.len(),
+            Object::Text(text) => text
+                .len()
+                .checked_add(XSD_STRING.len())
+                .ok_or(StorageError::SizeOverflow)?,
+            Object::Typed(text, datatype) => text
+                .len()
+                .checked_add(datatype.len())
+                .ok_or(StorageError::SizeOverflow)?,
+        };
+        let subject_bytes = iri_bytes(self.builder.resolve(subject))?;
+        let predicate_bytes = iri_bytes(self.builder.resolve(predicate))?;
+        let payload = self
+            .payload
+            .checked_add(subject_bytes)
+            .and_then(|bytes| bytes.checked_add(predicate_bytes))
+            .and_then(|bytes| bytes.checked_add(object_bytes))
+            .ok_or(StorageError::SizeOverflow)?;
+        admit_count(payload, bounds.max_payload_bytes, "metadata payload bytes")?;
+        let object = match object {
+            Object::Id(id) => id,
+            Object::Iri(text) => self.builder.intern_iri_with_memory(text, self.memory)?,
+            Object::Text(text) => self.builder.intern_literal_parts_with_memory(
+                text,
+                None,
+                None,
+                None,
+                self.memory,
+            )?,
+            Object::Typed(text, datatype) => self.builder.intern_literal_parts_with_memory(
+                text,
+                Some(datatype),
+                None,
+                None,
+                self.memory,
+            )?,
+        };
+        self.builder
+            .push_quad_with_memory(subject, predicate, object, None, self.memory)?;
+        self.statements = statements;
+        self.payload = payload;
+        Ok(())
+    }
+    fn number(&mut self, subject: TermId, local: &str, number: usize) -> Result<(), YamlError> {
+        let text = self.memory.format(&number)?;
+        self.fact(subject, local, Object::Typed(&text, XSD_INTEGER))?;
+        self.memory.release_string(text)?;
+        Ok(())
+    }
+    fn span(
+        &mut self,
+        subject: TermId,
+        start: &str,
+        end: &str,
+        span: Span,
+    ) -> Result<(), YamlError> {
+        self.number(subject, start, span.start)?;
+        self.number(subject, end, span.end)
+    }
+    fn describe(
+        &mut self,
+        subject: TermId,
+        class: &str,
+        ordinal: usize,
+        span: Span,
+    ) -> Result<(), YamlError> {
+        self.fact(subject, "type", Object::Id(self.term(class)?))?;
+        self.fact(subject, "stream", Object::Id(self.root))?;
+        self.number(subject, "ordinal", ordinal)?;
+        self.span(subject, "byteStart", "byteEnd", span)
+    }
+    fn finish(self) -> Result<RdfDataset, YamlError> {
+        self.nodes.release(self.memory)?;
+        self.memory.release_vec(self.predicates)?;
+        Ok(self.builder.freeze_with_memory(self.memory)?)
+    }
+}
+
+/// Count borrowed term components under the metadata payload law.
+pub(crate) fn term_bytes(dataset: &RdfDataset, id: TermId) -> Result<usize, YamlError> {
+    match dataset.resolve(id) {
+        TermRef::Iri(text) => Ok(text.len()),
+        TermRef::Literal {
+            lexical,
+            datatype,
+            language: None,
+            direction: None,
+        } => Ok(lexical
+            .len()
+            .checked_add(iri_bytes(dataset.resolve(datatype))?)
+            .ok_or(StorageError::SizeOverflow)?),
+        _ => Err(YamlError::Metadata(
+            "metadata terms must be IRIs or undirected literals",
+        )),
+    }
+}
+fn iri_bytes(term: TermRef<'_>) -> Result<usize, YamlError> {
+    match term {
+        TermRef::Iri(text) => Ok(text.len()),
+        _ => Err(YamlError::Metadata("metadata IRI invariant")),
+    }
+}
+
+/// Analyze and project one source stream under the explicit profile.
+/// # Errors
+/// Returns original grammar, storage, profile or RDF errors, never partial RDF.
+pub fn encode(source: SourceDocument<'_>, profile: &Profile) -> Result<RdfDataset, YamlError> {
+    project(&analyze(source, profile)?, profile)
+}
+
+/// Deterministic metadata and byte cover; no semantic YAML construction runs.
+/// Projection admits additional builder/index/freeze storage while the model is alive.
+/// # Errors
+/// Returns typed profile, storage or RDF failures before publication.
+pub fn project(document: &Document<'_>, profile: &Profile) -> Result<RdfDataset, YamlError> {
+    if document.profile != profile.identity() {
+        return Err(YamlError::Metadata("model/profile identity mismatch"));
+    }
+    let mut ceiling = Ceiling(profile.bounds().max_projection_bytes);
+    let mut memory = Memory::new(&mut ceiling);
+    let mut emit = Emitter::new(profile, document.id(), &mut memory)?;
+    let root = emit.root;
+    emit.fact(root, "type", Object::Id(emit.term("Stream")?))?;
+    emit.fact(root, "source", Object::Iri(document.source.id))?;
+    emit.fact(root, "vocabulary", Object::Iri(profile.vocabulary().base()))?;
+    emit.fact(root, "specification", Object::Text(SPECIFICATION))?;
+    emit.fact(root, "profileName", Object::Text(profile.name()))?;
+    emit.number(root, "profileVersion", profile.version() as usize)?;
+    emit.number(root, "byteLength", document.source.bytes.len())?;
+    for (local, datatype, value) in [
+        (
+            "sourceDigest",
+            "sha256Digest",
+            emit.memory
+                .format(&format_args!("sha256:{}", document.source_digest()))?,
+        ),
+        (
+            "profile",
+            "sha256Digest",
+            emit.memory
+                .format(&format_args!("sha256:{}", profile.identity()))?,
+        ),
+        (
+            "lexBlake3",
+            "blake3Digest",
+            emit.memory
+                .format(&format_args!("blake3:{}", document.lex_source_id()))?,
+        ),
+    ] {
+        emit.fact(
+            root,
+            local,
+            Object::Typed(&value, profile.vocabulary().term(datatype)?),
+        )?;
+        emit.memory.release_string(value)?;
+    }
+    for (ordinal, (id, _)) in document.stream.nodes().enumerate() {
+        let subject = emit.subject(document.id(), format_args!("n{ordinal}"))?;
+        emit.nodes.insert(id, subject, emit.memory)?;
+    }
+    for (ordinal, doc) in document.stream.documents().iter().enumerate() {
+        let subject = emit.subject(document.id(), format_args!("d{ordinal}"))?;
+        emit.describe(subject, "Document", ordinal, doc.span)?;
+        emit.fact(root, "document", Object::Id(subject))?;
+        emit.fact(subject, "root", Object::Id(emit.node(doc.root)?))?;
+        emit.span(subject, "prologueStart", "prologueEnd", doc.prologue)?;
+        if let Some(span) = doc.start_marker {
+            emit.span(subject, "startMarkerStart", "startMarkerEnd", span)?;
+        }
+        if let Some(span) = doc.end_marker {
+            emit.span(subject, "endMarkerStart", "endMarkerEnd", span)?;
+        }
+    }
+    for (ordinal, (id, node)) in document.stream.nodes().enumerate() {
+        let subject = emit.node(id)?;
+        emit.describe(subject, "Node", ordinal, node.span)?;
+        if let Some(span) = node.anchor {
+            emit.span(subject, "anchorStart", "anchorEnd", span)?;
+            emit.fact(subject, "anchorText", Object::Text(raw(document, span)?))?;
+        }
+        if let Some(span) = node.tag {
+            emit.span(subject, "tagStart", "tagEnd", span)?;
+            emit.fact(subject, "tagText", Object::Text(raw(document, span)?))?;
+        }
+        match &node.explicit_tag {
+            Some(ExplicitTag::NonSpecific) => {
+                emit.fact(subject, "tagKind", Object::Text("non-specific"))?;
+            }
+            Some(ExplicitTag::Specific(name)) => {
+                emit.fact(subject, "tagKind", Object::Text("specific"))?;
+                emit.fact(subject, "tagName", Object::Text(name))?;
+            }
+            None => {}
+        }
+        if let Some(span) = node.explicit_key {
+            emit.span(subject, "explicitKeyStart", "explicitKeyEnd", span)?;
+        }
+        match &node.kind {
+            NodeKind::Scalar(scalar) => {
+                emit.fact(subject, "kind", Object::Text("scalar"))?;
+                emit.fact(subject, "text", Object::Text(&scalar.text))?;
+                emit.fact(subject, "style", Object::Text(scalar_style(scalar.style)))?;
+                emit.span(subject, "rawStart", "rawEnd", scalar.raw)?;
+                emit.fact(subject, "rawText", Object::Text(raw(document, scalar.raw)?))?;
+                if let Some(block) = scalar.block {
+                    emit.span(subject, "blockStart", "blockEnd", block.span)?;
+                    emit.fact(
+                        subject,
+                        "chomping",
+                        Object::Text(match block.chomping {
+                            Chomping::Clip => "clip",
+                            Chomping::Strip => "strip",
+                            Chomping::Keep => "keep",
+                        }),
+                    )?;
+                    if let Some(indent) = block.indent_indicator {
+                        emit.number(subject, "indentIndicator", indent)?;
+                    }
+                    emit.number(subject, "contentIndent", block.content_indent)?;
+                }
+            }
+            NodeKind::Alias { raw: span, target } => {
+                emit.fact(subject, "kind", Object::Text("alias"))?;
+                emit.fact(subject, "target", Object::Id(emit.node(*target)?))?;
+                emit.span(subject, "rawStart", "rawEnd", *span)?;
+                emit.fact(subject, "rawText", Object::Text(raw(document, *span)?))?;
+            }
+            NodeKind::Sequence { items, style } => {
+                emit.fact(subject, "kind", Object::Text("sequence"))?;
+                emit.fact(subject, "style", Object::Text(collection_style(*style)))?;
+                for (position, &id) in items.iter().enumerate() {
+                    let item =
+                        emit.subject(document.id(), format_args!("i{ordinal}-{position}"))?;
+                    emit.describe(
+                        item,
+                        "Item",
+                        position,
+                        document
+                            .stream
+                            .node(id)
+                            .ok_or(YamlError::Metadata("native item target"))?
+                            .span,
+                    )?;
+                    emit.fact(subject, "item", Object::Id(item))?;
+                    emit.fact(item, "parent", Object::Id(subject))?;
+                    emit.fact(item, "node", Object::Id(emit.node(id)?))?;
+                }
+            }
+            NodeKind::Mapping { entries, style } => {
+                emit.fact(subject, "kind", Object::Text("mapping"))?;
+                emit.fact(subject, "style", Object::Text(collection_style(*style)))?;
+                for (position, entry) in entries.iter().enumerate() {
+                    let item =
+                        emit.subject(document.id(), format_args!("e{ordinal}-{position}"))?;
+                    let key = document
+                        .stream
+                        .node(entry.key)
+                        .ok_or(YamlError::Metadata("native key target"))?;
+                    let value = document
+                        .stream
+                        .node(entry.value)
+                        .ok_or(YamlError::Metadata("native value target"))?;
+                    emit.describe(
+                        item,
+                        "Entry",
+                        position,
+                        Span {
+                            start: key.span.start,
+                            end: value.span.end.max(key.span.end),
+                        },
+                    )?;
+                    emit.fact(subject, "entry", Object::Id(item))?;
+                    emit.fact(item, "parent", Object::Id(subject))?;
+                    emit.fact(item, "key", Object::Id(emit.node(entry.key)?))?;
+                    emit.fact(item, "value", Object::Id(emit.node(entry.value)?))?;
+                }
+            }
+        }
+    }
+    for (ordinal, trivia) in document.stream.trivia().iter().enumerate() {
+        let subject = emit.subject(document.id(), format_args!("t{ordinal}"))?;
+        emit.describe(subject, "Trivia", ordinal, trivia.span)?;
+        emit.fact(
+            subject,
+            "rawText",
+            Object::Text(raw(document, trivia.span)?),
+        )?;
+        emit.fact(
+            subject,
+            "kind",
+            Object::Text(match trivia.kind {
+                TriviaKind::Whitespace => "whitespace",
+                TriviaKind::LineBreak => "line-break",
+                TriviaKind::BlankLine => "blank-line",
+                TriviaKind::Comment => "comment",
+                TriviaKind::BlockHeaderComment => "block-header-comment",
+            }),
+        )?;
+        let (kind, node) = match trivia.attachment {
+            Attachment::Leading(id) => ("leading", Some(id)),
+            Attachment::Trailing(id) => ("trailing", Some(id)),
+            Attachment::Document => ("document", None),
+        };
+        emit.fact(subject, "attachment", Object::Text(kind))?;
+        if let Some(id) = node {
+            emit.fact(subject, "attachmentNode", Object::Id(emit.node(id)?))?;
+        }
+    }
+    for (ordinal, &span) in document.stream.directives().iter().enumerate() {
+        let subject = emit.subject(document.id(), format_args!("q{ordinal}"))?;
+        emit.describe(subject, "Directive", ordinal, span)?;
+        emit.fact(subject, "rawText", Object::Text(raw(document, span)?))?;
+    }
+    for (ordinal, escape) in document.stream.escapes().iter().enumerate() {
+        let subject = emit.subject(document.id(), format_args!("x{ordinal}"))?;
+        emit.describe(subject, "Escape", ordinal, escape.span)?;
+        emit.fact(
+            subject,
+            "rawText",
+            Object::Text(raw(document, escape.span)?),
+        )?;
+        if let Some(character) = escape.decoded {
+            emit.fact(subject, "escapeKind", Object::Text("character"))?;
+            let mut bytes = [0; 4];
+            emit.fact(
+                subject,
+                "decoded",
+                Object::Text(character.encode_utf8(&mut bytes)),
+            )?;
+        } else {
+            emit.fact(subject, "escapeKind", Object::Text("line-joining"))?;
+        }
+    }
+    for (ordinal, &span) in document.cover.iter().enumerate() {
+        let subject = emit.subject(document.id(), format_args!("c{ordinal}"))?;
+        emit.describe(subject, "CoverSpan", ordinal, span)?;
+        emit.fact(
+            subject,
+            "verbatim",
+            Object::Typed(
+                raw(document, span)?,
+                profile.vocabulary().term("verbatimText")?,
+            ),
+        )?;
+    }
+    emit.finish()
+}
+
+fn raw<'a>(document: &Document<'a>, span: Span) -> Result<&'a str, YamlError> {
+    document
+        .stream
+        .raw(span)
+        .ok_or(YamlError::Metadata("native source span"))
+}
+fn scalar_style(style: ScalarStyle) -> &'static str {
+    match style {
+        ScalarStyle::Empty => "empty",
+        ScalarStyle::Plain => "plain",
+        ScalarStyle::SingleQuoted => "single-quoted",
+        ScalarStyle::DoubleQuoted => "double-quoted",
+        ScalarStyle::Literal => "literal",
+        ScalarStyle::Folded => "folded",
+    }
+}
+fn collection_style(style: CollectionStyle) -> &'static str {
+    match style {
+        CollectionStyle::Block => "block",
+        CollectionStyle::Flow => "flow",
+    }
+}
diff --git crates/yaml/tests/roundtrip.rs crates/yaml/tests/roundtrip.rs
new file mode 100644
index 000000000..96469d0e7
--- /dev/null
+++ crates/yaml/tests/roundtrip.rs
@@ -0,0 +1,402 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+//! Native presentation, transport, closed metadata and phase-bound acceptance.
+
+use purrdf_core::{RdfDatasetBuilder, RdfLiteral, RdfTerm};
+use purrdf_yaml::{
+    Bounds, Profile, SourceDocument, Vocabulary, YamlError, analyze, decode_stream, project,
+};
+
+const SOURCE: &str = "https://example.org/source.yaml";
+fn profile(bounds: Bounds) -> Profile {
+    Profile::new("source-test", 1, Vocabulary::standard().unwrap(), bounds).unwrap()
+}
+fn model<'a>(text: &'a str, profile: &Profile) -> purrdf_yaml::Document<'a> {
+    analyze(
+        SourceDocument {
+            id: SOURCE,
+            bytes: text.as_bytes(),
+        },
+        profile,
+    )
+    .unwrap()
+}
+fn specimen() -> String {
+    concat!(
+        "\u{feff}# original notice\n%YAML 1.2\n%TAG !e! tag:example.org,2026:\n---\n",
+        "? [complex, key]\n: &a !e!record {text: 'it''s', flow: [é, .inf], empty:}\n",
+        "copy: *a\nshadow: [&a old, *a, &a [&a inner, *a], *a]\n",
+        "duplicate: first\nduplicate: second\nnonSpecific: ! plain\n",
+        "literal: |2- # header\n  # body content\n  text\n",
+        "folded: >+\n  one\n  two\n\n",
+        "clip: |\n  final\nescaped: \"x\\n\\u00E9\\\n  joined\" # tail\n",
+        "...\n---\n...\n---\n- one\n- two\n",
+    )
+    .replace('\n', "\r\n")
+}
+
+fn presentation_round_trips_through_rdf_with_deterministic_identities() {
+    let profile = Profile::standard().unwrap();
+    let specimen = specimen();
+    for text in [
+        specimen.as_str(),
+        "",
+        "# only comment\r\n",
+        "---\r\n...\r\n",
+    ] {
+        let document = model(text, &profile);
+        let graph = project(&document, &profile).unwrap();
+        assert_eq!(
+            decode_stream(&graph, document.id(), &profile).unwrap(),
+            text
+        );
+        let transport = purrdf_rdf::serialize_dataset_to_format(
+            &graph,
+            purrdf_rdf::NativeRdfFormat::Turtle,
+            None,
+        )
+        .unwrap();
+        let decoded = purrdf_rdf::parse_dataset(&transport.bytes, "text/turtle", None).unwrap();
+        assert_eq!(
+            decode_stream(&decoded, document.id(), &profile).unwrap(),
+            text
+        );
+        let again = model(text, &profile);
+        assert_eq!(document.id(), again.id());
+        let repeated = project(&again, &profile).unwrap();
+        assert_eq!(
+            purrdf_rdf::serialize_dataset(
+                &graph,
+                "application/n-triples",
+                purrdf_rdf::SerializeGraph::Dataset
+            )
+            .unwrap(),
+            purrdf_rdf::serialize_dataset(
+                &repeated,
+                "application/n-triples",
+                purrdf_rdf::SerializeGraph::Dataset
+            )
+            .unwrap()
+        );
+        assert_eq!(
+            document.source_digest(),
+            purrdf_core::ContentDigest::of(text.as_bytes())
+        );
+        let mut frontier = 0;
+        for span in document.cover_spans() {
+            assert_eq!(span.start, frontier);
+            assert!(span.end > span.start);
+            frontier = span.end;
+        }
+        assert_eq!(frontier, text.len());
+    }
+    let document = model(&specimen, &profile);
+    assert_eq!(document.syntax().documents().len(), 3);
+    let aliases: Vec<_> = document
+        .syntax()
+        .nodes()
+        .filter_map(|(_, node)| match node.kind {
+            purrdf_yaml::syntax::NodeKind::Alias { target, .. } => Some(target),
+            _ => None,
+        })
+        .collect();
+    assert!(aliases.len() >= 4);
+    assert_ne!(aliases[1], aliases[2]);
+    assert_eq!(aliases[2], aliases[3]);
+    let changed_text = specimen.replace("# original notice", "# changed notice");
+    let changed = model(&changed_text, &profile);
+    assert_ne!(document.id(), changed.id());
+    let other_source = analyze(
+        SourceDocument {
+            id: "https://example.org/other.yaml",
+            bytes: specimen.as_bytes(),
+        },
+        &profile,
+    )
+    .unwrap();
+    assert_ne!(document.id(), other_source.id());
+    let other_profile = Profile::new(
+        "other",
+        1,
+        Vocabulary::standard().unwrap(),
+        Bounds::standard(),
+    )
+    .unwrap();
+    assert_ne!(document.id(), model(&specimen, &other_profile).id());
+}
+
+fn strict_selection_rejects_forged_metadata_and_cover_claims() {
+    let profile = Profile::standard().unwrap();
+    let source = specimen();
+    let document = model(&source, &profile);
+    let graph = project(&document, &profile).unwrap();
+    let base = profile.vocabulary().base();
+    let mut builder = RdfDatasetBuilder::new();
+    let mut removed = false;
+    for (index, row) in graph.quads().enumerate() {
+        let statement = graph.to_owned_quad(index, row);
+        if !removed && statement.predicate == profile.vocabulary().term("verbatim").unwrap() {
+            removed = true;
+            continue;
+        }
+        builder.push_owned_quad(&statement).unwrap();
+    }
+    assert!(removed);
+    assert!(matches!(
+        decode_stream(&builder.freeze().unwrap(), document.id(), &profile),
+        Err(YamlError::Cover(
+            purrdf_core::cover::ReconstructError::UncoveredRange { .. }
+        ))
+    ));
+    // Every selected class is checked through complete reprojected graph equality.
+    for local in ["root", "key", "target", "tagName", "attachment", "decoded"] {
+        let predicate = profile.vocabulary().term(local).unwrap();
+        let mut removed = false;
+        let mut builder = RdfDatasetBuilder::new();
+        for (index, row) in graph.quads().enumerate() {
+            let statement = graph.to_owned_quad(index, row);
+            if !removed && statement.predicate == predicate {
+                removed = true;
+                continue;
+            }
+            builder.push_owned_quad(&statement).unwrap();
+        }
+        assert!(removed, "specimen must exercise {local}");
+        assert!(
+            decode_stream(&builder.freeze().unwrap(), document.id(), &profile).is_err(),
+            "accepted missing {local}"
+        );
+    }
+    for local in ["verbatim", "byteStart", "profile", "sourceDigest"] {
+        let predicate = profile.vocabulary().term(local).unwrap();
+        let mut edited = false;
+        let mut builder = RdfDatasetBuilder::new();
+        for (index, row) in graph.quads().enumerate() {
+            let mut statement = graph.to_owned_quad(index, row);
+            if !edited && statement.predicate == predicate {
+                edited = true;
+                statement.object = RdfTerm::Literal(RdfLiteral::simple("forged"));
+            }
+            builder.push_owned_quad(&statement).unwrap();
+        }
+        assert!(edited);
+        assert!(
+            decode_stream(&builder.freeze().unwrap(), document.id(), &profile).is_err(),
+            "accepted wrongly typed {local}"
+        );
+    }
+    // Namespace subjects stay selected even with no ownership edge.
+    for subject in [
+        format!("{}#forged", document.id()),
+        "https://example.org/owned-forgery".to_owned(),
+    ] {
+        let mut builder = RdfDatasetBuilder::new();
+        builder.push_dataset(&graph).unwrap();
+        let s = builder.intern_iri(&subject).unwrap();
+        let p = builder.intern_iri(&format!("{base}unknown")).unwrap();
+        let o = builder
+            .intern_literal(RdfLiteral::simple("forged"))
+            .unwrap();
+        builder.push_quad(s, p, o, None).unwrap();
+        if !subject.starts_with(document.id()) {
+            let owner = builder
+                .intern_iri(profile.vocabulary().term("stream").unwrap())
+                .unwrap();
+            let root = builder.intern_iri(document.id()).unwrap();
+            builder.push_quad(s, owner, root, None).unwrap();
+        }
+        assert!(decode_stream(&builder.freeze().unwrap(), document.id(), &profile).is_err());
+    }
+    let mut builder = RdfDatasetBuilder::new();
+    builder.push_dataset(&graph).unwrap();
+    let named = builder
+        .intern_iri(&format!("{}#hidden-graph", document.id()))
+        .unwrap();
+    builder.declare_named_graph(named).unwrap();
+    assert!(decode_stream(&builder.freeze().unwrap(), document.id(), &profile).is_err());
+    let other = model("other: source\n", &profile);
+    let other_graph = project(&other, &profile).unwrap();
+    let mut combined = RdfDatasetBuilder::new();
+    combined.push_dataset(&graph).unwrap();
+    combined.push_dataset(&other_graph).unwrap();
+    let combined = combined.freeze().unwrap();
+    assert_eq!(
+        decode_stream(&combined, document.id(), &profile).unwrap(),
+        source
+    );
+    assert_eq!(
+        decode_stream(&combined, other.id(), &profile).unwrap(),
+        "other: source\n"
+    );
+    assert!(decode_stream(&combined, "https://example.org/absent", &profile).is_err());
+    let wrong_profile = Profile::new(
+        "wrong",
+        1,
+        Vocabulary::standard().unwrap(),
+        Bounds::standard(),
+    )
+    .unwrap();
+    assert!(decode_stream(&graph, document.id(), &wrong_profile).is_err());
+}
+
+fn phase_bounds_and_native_refusals_are_explicit() {
+    let text = "a: [one, two]\n";
+    let original = Profile::standard().unwrap();
+    let document = model(text, &original);
+    let mut bounds = Bounds::standard();
+    bounds.max_cover_spans = document.cover_spans().len();
+    assert!(
+        analyze(
+            SourceDocument {
+                id: SOURCE,
+                bytes: text.as_bytes()
+            },
+            &profile(bounds)
+        )
+        .is_ok()
+    );
+    bounds.max_cover_spans -= 1;
+    assert!(matches!(
+        analyze(
+            SourceDocument {
+                id: SOURCE,
+                bytes: text.as_bytes()
+            },
+            &profile(bounds)
+        ),
+        Err(YamlError::Limit {
+            resource: "cover spans",
+            ..
+        })
+    ));
+    let mut bounds = Bounds::standard();
+    bounds.syntax.syntax.max_input_bytes = text.len() - 1;
+    assert!(matches!(
+        analyze(
+            SourceDocument {
+                id: SOURCE,
+                bytes: text.as_bytes()
+            },
+            &profile(bounds)
+        ),
+        Err(YamlError::Limit {
+            resource: "source bytes",
+            ..
+        })
+    ));
+    let mut bounds = Bounds::standard();
+    bounds.syntax.syntax.max_occurrences = 1;
+    assert!(matches!(
+        analyze(
+            SourceDocument {
+                id: SOURCE,
+                bytes: text.as_bytes()
+            },
+            &profile(bounds)
+        ),
+        Err(YamlError::Syntax(_))
+    ));
+    let mut bounds = Bounds::standard();
+    bounds.syntax.syntax.max_depth = 0;
+    assert!(matches!(
+        analyze(
+            SourceDocument {
+                id: SOURCE,
+                bytes: text.as_bytes()
+            },
+            &profile(bounds)
+        ),
+        Err(YamlError::Syntax(_))
+    ));
+    let mut bounds = Bounds::standard();
+    bounds.max_partition_bytes = 1;
+    assert!(matches!(
+        analyze(
+            SourceDocument {
+                id: SOURCE,
+                bytes: text.as_bytes()
+            },
+            &profile(bounds)
+        ),
+        Err(YamlError::Storage(_))
+    ));
+    for (resource, configure) in [
+        ("storage", 0_u8),
+        ("RDF statements", 1),
+        ("metadata payload bytes", 2),
+    ] {
+        let mut bounds = Bounds::standard();
+        match configure {
+            0 => bounds.max_projection_bytes = 1,
+            1 => bounds.max_statements = 1,
+            _ => bounds.max_payload_bytes = 1,
+        }
+        let profile = profile(bounds);
+        let document = model(text, &profile);
+        let error = project(&document, &profile).unwrap_err();
+        assert!(
+            matches!(error, YamlError::Storage(_))
+                || matches!(error, YamlError::Limit { resource: actual, .. } if actual == resource)
+        );
+    }
+    let mut bounds = Bounds::standard();
+    bounds.max_decode_bytes = 1;
+    let profile = profile(bounds);
+    let document = model(text, &profile);
+    let graph = project(&document, &profile).unwrap();
+    assert!(matches!(
+        decode_stream(&graph, document.id(), &profile),
+        Err(YamlError::Storage(_))
+    ));
+    assert!(matches!(
+        analyze(
+            SourceDocument {
+                id: SOURCE,
+                bytes: b"\xff"
+            },
+            &original
+        ),
+        Err(YamlError::Utf8 { at: 0 })
+    ));
+    assert!(matches!(
+        analyze(
+            SourceDocument {
+                id: SOURCE,
+                bytes: b"&a [*a]"
+            },
+            &original
+        ),
+        Err(YamlError::Syntax(_))
+    ));
+}
+
+fn presentation_metadata_does_not_change_the_yaml_ld_dataset() {
+    let first = "'@id': https://example.org/s\nhttps://example.org/p: value\nhttps://example.org/q: value\n";
+    let second = "# authored presentation\n---\n'@id': 'https://example.org/s'\nhttps://example.org/p: &value value\nhttps://example.org/q: *value\n...\n";
+    let profile = Profile::standard().unwrap();
+    assert_ne!(model(first, &profile).id(), model(second, &profile).id());
+    let first = purrdf_rdf::parse_dataset(first.as_bytes(), "application/ld+yaml", None).unwrap();
+    let second = purrdf_rdf::parse_dataset(second.as_bytes(), "application/ld+yaml", None).unwrap();
+    assert_eq!(
+        purrdf_rdf::serialize_dataset(
+            &first,
+            "application/n-quads",
+            purrdf_rdf::SerializeGraph::Dataset
+        )
+        .unwrap(),
+        purrdf_rdf::serialize_dataset(
+            &second,
+            "application/n-quads",
+            purrdf_rdf::SerializeGraph::Dataset
+        )
+        .unwrap()
+    );
+}
+
+purrdf_testkit::harness_main!(
+    presentation_round_trips_through_rdf_with_deterministic_identities,
+    strict_selection_rejects_forged_metadata_and_cover_claims,
+    phase_bounds_and_native_refusals_are_explicit,
+    presentation_metadata_does_not_change_the_yaml_ld_dataset,
+);
