+    );
+    assert_eq!(
+        ingest("[&a [x], [*a]]")
+            .into_core(
+                Select::First,
+                Root::CollectionsOrNull,
+                Bound {
+                    max_depth: 2,
+                    ..Bound::DEFAULT
+                }
+            )
+            .unwrap_err()
+            .kind(),
+        ErrorKind::Depth { limit: 2 }
+    );
+    assert_eq!(
+        ingest("[&a [x], *a]")
+            .into_core(
+                Select::First,
+                Root::CollectionsOrNull,
+                Bound {
+                    max_nodes: 4,
+                    ..Bound::DEFAULT
+                }
+            )
+            .unwrap_err()
+            .kind(),
+        ErrorKind::Nodes { limit: 4 }
+    );
+    // A lower ceiling refuses the original retained account before key validation.
+    assert_eq!(
+        ingest("{1: value}")
+            .into_core(
+                Select::First,
+                Root::CollectionsOrNull,
+                Bound {
+                    max_allocation_bytes: 1,
+                    ..Bound::DEFAULT
+                }
+            )
+            .unwrap_err()
+            .kind(),
+        ErrorKind::Allocation { limit: 1 }
+    );
+    let source = format!("'{}'", "x".repeat(24 << 10));
+    assert!(
+        ingest(&source)
+            .into_core(
+                Select::First,
+                Root::Any,
+                Bound {
+                    max_allocation_bytes: 128 << 10,
+                    ..Bound::DEFAULT
+                }
+            )
+            .is_ok()
+    );
+    assert_eq!(
+        ingest(&source)
+            .into_core(
+                Select::First,
+                Root::Any,
+                Bound {
+                    max_allocation_bytes: 48 << 10,
+                    ..Bound::DEFAULT
+                }
+            )
+            .unwrap_err()
+            .kind(),
+        ErrorKind::Allocation { limit: 48 << 10 }
+    );
+}
