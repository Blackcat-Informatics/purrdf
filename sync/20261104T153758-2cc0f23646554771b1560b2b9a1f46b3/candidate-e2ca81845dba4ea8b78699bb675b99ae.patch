+#[test]
+fn configured_yamlld_input_reaches_convert_and_refuses_other_routes() {
+    let dir = purrdf_testkit::temp_dir!().expect("tempdir");
+    let yaml = write_file(
+        dir.path(),
+        "input.yamlld",
+        "'@id': first\nhttps://example.org/p: one\n---\n'@id': second\nhttps://example.org/p: two\n",
