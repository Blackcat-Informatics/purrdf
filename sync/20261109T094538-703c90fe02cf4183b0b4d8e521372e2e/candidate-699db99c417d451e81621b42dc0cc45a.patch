+
+/// Only immutable native step handles are copied into later proofs.
+#[derive(Debug, Clone)]
+pub(crate) struct PreparationLayout {
+    pub(crate) state: [u8; 32],
+    steps: Vec<Shared<Vec<u8>>>,
+    counts: Counts,
+    pub(crate) live: usize,
