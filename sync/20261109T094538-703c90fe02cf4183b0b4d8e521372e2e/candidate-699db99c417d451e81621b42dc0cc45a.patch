+        limits: PositiveWorldLimits,
+        other_live: usize,
+    ) -> Result<Self, EntailError> {
+        let mut account = Metadata {
+            limit: limits.metadata_bytes,
+            attempted: 0,
+        };
+        let result = (|| {
+            let mut memory = Memory::resume(
+                &mut account,
+                self.live
