+            crate::reasoner::proof::encode_term(out, &term);
+            for _ in 0..3 { length(out, 0); }
+        }), Err(EntailError::PositiveUpdate(refusal)) if matches!(*refusal, crate::reasoner::PositiveUpdateRefusal::ProofEncoding { .. }))
+        );
+    }
