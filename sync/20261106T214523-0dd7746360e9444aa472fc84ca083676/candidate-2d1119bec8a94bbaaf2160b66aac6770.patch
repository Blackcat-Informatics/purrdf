+    let predicate = builder.intern_iri("https://example.org/p").unwrap();
+    for value in 0..18 {
+        let object = builder
+            .intern_iri(&format!("https://example.org/v{value}"))
+            .unwrap();
+        builder.push_quad(subject, predicate, object, None).unwrap();
+    }
