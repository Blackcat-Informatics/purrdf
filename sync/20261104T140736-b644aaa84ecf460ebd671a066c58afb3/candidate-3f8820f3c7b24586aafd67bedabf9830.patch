+        emit(if self.full { "b3w1: " } else { "b3p1: " });
+        for (position, index) in self.indices[..=self.payload].iter().enumerate() {
+            if position != 0 {
+                emit(" ");
+            }
+            emit(word(*index));
+        }
+    }
