+        raw.len()
+            - raw
+                .trim_start_matches(purrdf_lex::terminals::is_unicode_white_space)
+                .len()
+    } else {
+        raw.len() - raw.trim_start_matches([' ', '\t']).len()
+    };
+    let offset = marker + count + leading;
+    Some((byte, count, span(offset, offset + info.len())))
