+pub(super) fn word(index: u16) -> &'static str {
+    let index = usize::from(index);
+    &BLOB[usize::from(OFFSETS[index])..usize::from(OFFSETS[index + 1])]
+}
+pub(super) fn lookup(bytes: &[u8]) -> Option<u16> {
+    let hash = crate::fnv::fnv1a64(bytes);
+    let displacement = DISPLACEMENTS[hash as usize & 1023];
+    if displacement == 0 {
+        return None;
+    }
+    let slot = if displacement < 0 {
+        (-displacement - 1) as usize
+    } else {
+        crate::mix::splitmix64_finalize(hash ^ displacement as u64) as usize & 4095
+    };
+    let index = SLOTS[slot];
+    (word(index).as_bytes() == bytes).then_some(index)
+}
