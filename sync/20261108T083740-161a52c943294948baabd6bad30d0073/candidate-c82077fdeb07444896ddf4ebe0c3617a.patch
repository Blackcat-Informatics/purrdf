+{
+  "copyright": "2026 Blackcat Informatics Inc.",
+  "license": "MIT OR Apache-2.0 OR MulanPSL-2.0",
+  "profiles": {
+    "sparql11-query-over-rdf12": "SPARQL 1.1 algebra over its applicable RDF 1.2 term subset; no SHACL admission claim."
+  },
+  "cases": [
+    {
+      "id": "mixed-predicate-inverse-sequence",
+      "profile": "sparql11-query-over-rdf12",
+      "kind": "query-evaluation",
+      "query": "mixed-predicate-inverse-sequence.rq",
+      "expected": "mixed-predicate-inverse-sequence.srj",
+      "data": [
+        {
+          "path": "data.ttl"
+        }
+      ],
+      "categories": [
+        "predicate",
+        "inverse",
+        "sequence",
+        "alternative",
+        "equivalence",
+        "hidden-witness",
+        "bag"
+      ],
+      "rationale": "There is one direct t edge, one inverse q edge, and two p/r derivations through a and b. Each yields o, for exactly four copies. The wrong/r/other edge has no predecessor from s and cannot contribute. UNION and reordering basic patterns preserve this multiset; the middle witnesses are not projected.",
