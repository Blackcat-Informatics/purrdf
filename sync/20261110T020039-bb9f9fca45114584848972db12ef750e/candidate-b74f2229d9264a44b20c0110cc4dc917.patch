+        .expect("render RDF 1.2");
+    let text = String::from_utf8(bytes).expect("UTF-8 RDF text");
+    let mut lines: Vec<_> = text.lines().collect();
+    lines.sort_unstable();
+    lines.join("\n").into_bytes()
+}
