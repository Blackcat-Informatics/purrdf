+// SPDX-FileCopyrightText: 2026 Blackcat Informatics Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+//! Explicit GB 18030 acquisition into the existing native RDF grammars.
+
+use super::{HexTuplesStreamParser, LineEnd, LineStreamParser};
+use crate::{RdfDataset, RdfDiagnostic};
+use purrdf_lex::allocation::{Admission, Memory, StorageError};
+use purrdf_lex::control::Progress;
+use purrdf_lex::gb18030::{
+    Direction, Emission, Extent, Limits, Profile, StreamError, Totals, Transcoder,
+};
+use std::io::Read;
+use std::sync::Arc;
+
+mod error;
+pub use error::EncodedReadError;
+
+const INPUT_WINDOW: usize = 8192;
+
+/// Explicit encoding and conversion-workspace ceilings; no encoding default.
+#[derive(Debug, Clone, Copy)]
+pub struct EncodedReadOptions {
+    /// Complete mapping edition selected by the caller.
+    pub profile: Profile,
+    /// Whole-stream source and UTF-8 output bounds.
+    pub limits: Limits,
+    /// Maximum decoded physical line bytes for line-oriented grammars.
+    pub line_bytes: usize,
+    /// Maximum conversion workspace, including the fixed input window, codec,
+    /// line/document text and source maps, including replacement allocation peaks.
+    /// Parser state and the resulting dataset are separate existing resources.
+    pub workspace_bytes: usize,
+}
+
+/// Complete native dataset and exact conversion work, without changing ParseOutcome.
+#[derive(Debug)]
+pub struct EncodedReadOutcome {
+    /// Dataset produced by the existing native grammar and statement-layer fold.
+    pub dataset: Arc<RdfDataset>,
+    /// Original input bytes, UTF-8 bytes and scalar emissions.
+    pub totals: Totals,
+    /// Explicit edition used for every contribution.
+    pub profile: Profile,
+}
+
+#[derive(Clone, Copy)]
+struct Scalar {
+    value: char,
+    source: Extent,
+}
+
+struct Input<R> {
+    reader: R,
+    bytes: [u8; INPUT_WINDOW],
+    used: usize,
+    available: usize,
+    codec: Transcoder,
+    totals: Totals,
+    eof: bool,
+    finished: bool,
+}
+
+impl<R: Read> Input<R> {
+    fn peek<C: Progress + ?Sized, O>(
+        &mut self,
+        progress: &mut C,
+    ) -> Result<Option<u8>, EncodedReadError<C::Error, O>> {
+        if self.used == self.available && !self.eof {
+            self.available = loop {
+                progress.charge(0).map_err(EncodedReadError::Control)?;
+                match self.reader.read(&mut self.bytes) {
+                    Ok(available) => break available,
+                    Err(cause) if cause.kind() == std::io::ErrorKind::Interrupted => {}
+                    Err(cause) => {
+                        return Err(EncodedReadError::Read {
+                            cause,
+                            offset: self.totals.input_bytes,
+                        });
+                    }
+                }
+            };
+            if self.available > self.bytes.len() {
+                return Err(EncodedReadError::ReadCount {
+                    actual: self.available,
+                    maximum: self.bytes.len(),
+                });
+            }
+            self.used = 0;
+            self.eof = self.available == 0;
+        }
+        Ok((!self.eof).then(|| self.bytes[self.used]))
+    }
+
+    fn next<C: Progress + ?Sized, O>(
+        &mut self,
+        progress: &mut C,
+        emit: &mut impl FnMut(Emission<'_>) -> Result<(), O>,
+    ) -> Result<Option<Scalar>, EncodedReadError<C::Error, O>> {
+        if self.finished {
+            return Ok(None);
+        }
+        loop {
+            let Some(byte) = self.peek(progress)? else {
+                self.totals = self
+                    .codec
+                    .push(&[], true, progress, |_| Ok::<_, O>(()))
+                    .map_err(EncodedReadError::Codec)?;
+                self.finished = true;
+                return Ok(None);
+            };
+            self.used += 1;
+            let mut scalar = None;
+            self.totals = self
+                .codec
+                .push(&[byte], false, progress, |item| {
+                    emit(item)?;
+                    scalar = Some(Scalar {
+                        value: item.scalar,
+                        source: item.source,
+                    });
+                    Ok(())
+                })
+                .map_err(EncodedReadError::Codec)?;
+            if scalar.is_some() {
+                return Ok(scalar);
+            }
+        }
+    }
+}
+
+#[derive(Default)]
+struct Workspace {
+    text: String,
+    sources: Vec<Extent>,
+    end: u64,
+}
+
+impl Workspace {
+    fn check<E, O>(
+        &self,
+        additional: usize,
+        options: EncodedReadOptions,
+    ) -> Result<(), EncodedReadError<E, O>> {
+        let required = self
+            .text
+            .capacity()
+            .checked_add(
+                self.sources
+                    .capacity()
+                    .checked_mul(size_of::<Extent>())
+                    .ok_or(StorageError::SizeOverflow)?,
+            )
+            .and_then(|n| n.checked_add(size_of::<Input<()>>() + size_of::<Self>()))
+            .and_then(|n| n.checked_add(additional))
+            .ok_or(StorageError::SizeOverflow)?;
+        if required > options.workspace_bytes {
+            return Err(EncodedReadError::Limit {
+                resource: "transcode-workspace-bytes",
+                required: required as u64,
+                limit: options.workspace_bytes as u64,
+            });
+        }
+        Ok(())
+    }
+
+    fn growth<E, O>(
+        &self,
+        minimum: usize,
+        preferred: usize,
+        options: EncodedReadOptions,
+    ) -> Result<usize, EncodedReadError<E, O>> {
+        self.check(minimum, options)?;
+        let retained = self.text.capacity()
+            + self.sources.capacity() * size_of::<Extent>()
+            + size_of::<Input<()>>()
+            + size_of::<Self>();
+        Ok(preferred.min(options.workspace_bytes - retained))
+    }
+
+    fn append<A: Admission + ?Sized, C: Progress + ?Sized, O>(
+        &mut self,
+        scalar: Scalar,
+        line: bool,
+        options: EncodedReadOptions,
+        memory: &mut Memory<'_, A>,
+        progress: &mut C,
+    ) -> Result<(), EncodedReadError<C::Error, O>> {
+        let required = self
+            .text
+            .len()
+            .checked_add(scalar.value.len_utf8())
+            .ok_or(StorageError::SizeOverflow)?;
+        if line && required > options.line_bytes {
+            return Err(EncodedReadError::Limit {
+                resource: "transcode-line-bytes",
+                required: required as u64,
+                limit: options.line_bytes as u64,
+            });
+        }
+        if required > self.text.capacity() {
+            // Leave room for the next map slot after the old text buffer dies.
+            let map_next = if self.sources.len() == self.sources.capacity() {
+                self.sources
+                    .len()
+                    .checked_add(1)
+                    .and_then(|n| n.checked_mul(size_of::<Extent>()))
+                    .ok_or(StorageError::SizeOverflow)?
+            } else {
+                0
+            };
+            let reserve_map = map_next.saturating_sub(self.text.capacity());
+            let minimum = required
+                .checked_add(reserve_map)
+                .ok_or(StorageError::SizeOverflow)?;
+            let preferred = required
+                .max(self.text.capacity().saturating_mul(2))
+                .max(64)
+                .checked_add(reserve_map)
+                .ok_or(StorageError::SizeOverflow)?;
+            let capacity = self.growth(minimum, preferred, options)? - reserve_map;
+            progress
+                .charge(self.text.len() as u64)
+                .map_err(EncodedReadError::Control)?;
+            memory.reserve_string(&mut self.text, capacity)?;
+        }
+        if self.sources.len() == self.sources.capacity() {
+            let minimum = self
+                .sources
+                .len()
+                .checked_add(1)
+                .ok_or(StorageError::SizeOverflow)?;
+            let preferred = minimum
+                .max(self.sources.capacity().saturating_mul(2))
+                .max(16)
+                .checked_mul(size_of::<Extent>())
+                .ok_or(StorageError::SizeOverflow)?;
+            let capacity = self.growth(
+                minimum
+                    .checked_mul(size_of::<Extent>())
+                    .ok_or(StorageError::SizeOverflow)?,
+                preferred,
+                options,
+            )? / size_of::<Extent>();
+            progress
+                .charge(self.sources.len() as u64)
+                .map_err(EncodedReadError::Control)?;
+            memory.reserve(&mut self.sources, capacity)?;
+        }
+        self.text.push(scalar.value);
+        self.sources.push(scalar.source);
+        self.end = scalar.source.end;
+        Ok(())
+    }
+
+    fn source_at(&self, line: u64, column: u32) -> Option<Extent> {
+        if line == 0 || column == 0 {
+            return None;
+        }
+        let mut current_line = 1u64;
+        let mut current_column = 1u32;
+        // Native LineIndex/PositionCursor count LF only; CR remains a scalar
+        // in a buffered grammar. Line-oriented callers pass already split text.
+        for (index, scalar) in self.text.chars().enumerate() {
+            if current_line == line && current_column == column {
+                return self.sources.get(index).copied();
+            }
+            if scalar == '\n' {
+                current_line = current_line.checked_add(1)?;
+                current_column = 1;
+            } else {
+                current_column = current_column.checked_add(1)?;
+            }
+        }
+        (current_line == line && current_column == column).then_some(Extent {
+            start: self.end,
+            end: self.end,
+        })
+    }
+
+    fn diagnostic<E, O>(
+        &self,
+        diagnostic: RdfDiagnostic,
+        line: Option<u64>,
+    ) -> EncodedReadError<E, O> {
+        let source = diagnostic
+            .location
+            .as_ref()
+            .and_then(|location| self.source_at(line.or(location.line)?, location.column?));
+        EncodedReadError::Parse { diagnostic, source }
+    }
+
+    fn release<A: Admission + ?Sized>(
+        self,
+        memory: &mut Memory<'_, A>,
+    ) -> Result<(), StorageError> {
+        let text = memory.release_string(self.text);
+        let sources = memory.release_vec(self.sources);
+        text.and(sources)
+    }
+}
+
+fn next_line<R: Read, A: Admission + ?Sized, C: Progress + ?Sized, O>(
+    input: &mut Input<R>,
+    workspace: &mut Workspace,
+    end: LineEnd,
+    options: EncodedReadOptions,
+    memory: &mut Memory<'_, A>,
+    progress: &mut C,
+    emit: &mut impl FnMut(Emission<'_>) -> Result<(), O>,
+) -> Result<bool, EncodedReadError<C::Error, O>> {
+    workspace.text.clear();
+    workspace.sources.clear();
+    workspace.end = input.totals.input_bytes;
+    loop {
+        let Some(scalar) = input.next(progress, emit)? else {
+            return Ok(!workspace.text.is_empty());
+        };
+        match (end, scalar.value) {
+            (_, '\n') => {
+                if matches!(end, LineEnd::Ndjson) && workspace.text.ends_with('\r') {
+                    workspace.text.pop();
+                    if let Some(cr) = workspace.sources.pop() {
+                        workspace.end = cr.start;
+                    }
+                }
+                return Ok(true);
+            }
+            (LineEnd::RdfEol, '\r') => {
+                // LF is ASCII in both encodings and cannot be inside a GB sequence.
+                // Peek raw bytes only: decoding the next line could mask this
+                // line's grammar failure with a later malformed scalar.
+                if input.peek(progress)? == Some(b'\n') {
+                    input.next(progress, emit)?;
+                }
+                return Ok(true);
+            }
+            _ => workspace.append(scalar, true, options, memory, progress)?,
+        }
+    }
+}
+
+/// Parse explicitly encoded input through the existing native RDF grammars.
+///
+/// Every decoded scalar reaches `contribution` with exact original bytes. The
+/// callback owns any retained mapping and its original output/admission errors.
+/// Conversion text/maps use `memory` and are destroyed and refunded before return.
+/// Line grammars retain one physical line; CR lookahead inspects raw bytes. The
+/// fixed 8 KiB source window may prefetch raw bytes, but does not decode ahead.
+/// Other grammars retain the complete admitted UTF-8 text/map under the explicit
+/// workspace and output ceilings, as their existing parser requires. The native
+/// grammar state and returned dataset retain their existing resident ownership.
+///
+/// Scalar columns remain native columns; an outer parse refusal adds its exact
+/// original scalar extent (or end boundary) when the native diagnostic supplies
+/// a position. No interior output byte is asserted to be an original boundary.
+/// UTF-8 defaults and existing public option/outcome structures are unchanged.
+///
+/// # Errors
+/// Preserves original codec, work/cancellation, mapping-output, allocation,
+/// reader and native parser causes. No failed conversion yields a dataset.
+pub fn parse_dataset_from_encoded_reader<
+    R: Read,
+    A: Admission + ?Sized,
+    C: Progress + ?Sized,
+    O,
+>(
+    reader: R,
+    media_type: &str,
+    base_iri: Option<&str>,
+    options: EncodedReadOptions,
+    memory: &mut Memory<'_, A>,
+    progress: &mut C,
+    mut contribution: impl FnMut(Emission<'_>) -> Result<(), O>,
+) -> Result<EncodedReadOutcome, EncodedReadError<C::Error, O>> {
+    let format = super::classify(media_type).map_err(|diagnostic| EncodedReadError::Parse {
+        diagnostic,
+        source: None,
+    })?;
+    let mut workspace = Workspace::default();
+    workspace.check(0, options)?;
+    let mut input = Input {
+        reader,
+        bytes: [0; INPUT_WINDOW],
+        used: 0,
+        available: 0,
+        codec: Transcoder::new(options.profile, Direction::Decode, options.limits),
+        totals: Totals::default(),
+        eof: false,
+        finished: false,
+    };
+    // Keep conversion ownership outside the guard so an unwind is diagnosed
+    // through the native codec boundary before both buffers are refunded.
+    let result = super::super::parse::catch_codec_panic(format, || {
+        Ok((|| {
+            let dataset = if format.is_line_oriented() {
+                let base = super::super::parse::base_scope_for(base_iri).map_err(|diagnostic| {
+                    EncodedReadError::Parse {
+                        diagnostic,
+                        source: None,
+                    }
+                })?;
+                match format {
+                    super::NativeRdfFormat::HexTuples => {
+                        let mut parser = HexTuplesStreamParser::new(base);
+                        while next_line(
+                            &mut input,
+                            &mut workspace,
+                            LineEnd::Ndjson,
+                            options,
+                            memory,
+                            progress,
+                            &mut contribution,
+                        )? {
+                            parser
+                                .push_line(&workspace.text)
+                                .map_err(|diagnostic| workspace.diagnostic(diagnostic, Some(1)))?;
+                        }
+                        parser
+                            .finish()
+                            .map_err(|diagnostic| EncodedReadError::Parse {
+                                diagnostic,
+                                source: None,
+                            })?
+                    }
+                    other => {
+                        let mut parser =
+                            LineStreamParser::new(other, base).map_err(|diagnostic| {
+                                EncodedReadError::Parse {
+                                    diagnostic,
+                                    source: None,
+                                }
+                            })?;
+                        while next_line(
+                            &mut input,
+                            &mut workspace,
+                            LineEnd::RdfEol,
+                            options,
+                            memory,
+                            progress,
+                            &mut contribution,
+                        )? {
+                            parser
+                                .push_line(&workspace.text)
+                                .map_err(|diagnostic| workspace.diagnostic(diagnostic, Some(1)))?;
+                        }
+                        super::super::parse::dataset_from_text_ser_graph(&parser.finish()).map_err(
+                            |diagnostic| EncodedReadError::Parse {
+                                diagnostic,
+                                source: None,
+                            },
+                        )?
+                    }
+                }
+            } else {
+                while let Some(scalar) = input.next(progress, &mut contribution)? {
+                    workspace.append(scalar, false, options, memory, progress)?;
+                }
+                super::super::parse_dataset(workspace.text.as_bytes(), media_type, base_iri)
+                    .map_err(|diagnostic| workspace.diagnostic(diagnostic, None))?
+            };
+            progress.charge(0).map_err(EncodedReadError::Control)?;
+            Ok(EncodedReadOutcome {
+                dataset,
+                totals: input.totals,
+                profile: options.profile,
+            })
+        })())
+    })
+    .unwrap_or_else(|diagnostic| {
+        Err(EncodedReadError::Parse {
+            diagnostic,
+            source: None,
+        })
+    });
+    let release = workspace.release(memory).map_err(EncodedReadError::Storage);
+    match result {
+        Err(error) => Err(error),
+        Ok(output) => release.map(|()| output),
+    }
+}
diff --git crates/rdf/src/native_codecs/stream/encoded/error.rs crates/rdf/src/native_codecs/stream/encoded/error.rs
new file mode 100644
index 000000000..73b2b89ec
--- /dev/null
+++ crates/rdf/src/native_codecs/stream/encoded/error.rs
@@ -0,0 +1,103 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+//! Original encoded acquisition failures and their source coordinates.
+
+use super::{Extent, RdfDiagnostic, StorageError, StreamError};
+
+/// Original encoded input failure; compatibility diagnostics remain unchanged.
+#[derive(Debug)]
+pub enum EncodedReadError<C, O> {
+    /// Original strict codec/control/output error.
+    Codec(StreamError<C, O>),
+    /// Original progress/cancellation failure outside scalar conversion.
+    Control(C),
+    /// Original memory admission or allocator failure.
+    Storage(StorageError),
+    /// Original reader error before another source scalar is consumed.
+    Read {
+        /// Unchanged I/O error and its original native source chain.
+        cause: std::io::Error,
+        /// Original byte offset of the next read window.
+        offset: u64,
+    },
+    /// A reader violated its slice count contract.
+    ReadCount {
+        /// Returned count.
+        actual: usize,
+        /// Supplied slice width.
+        maximum: usize,
+    },
+    /// Explicit conversion workspace or line ceiling, before allocation.
+    Limit {
+        /// Bounded resource.
+        resource: &'static str,
+        /// Required bytes.
+        required: u64,
+        /// Inclusive ceiling.
+        limit: u64,
+    },
+    /// Unchanged native parser diagnostic, with original source contribution.
+    Parse {
+        /// Original diagnostic, with its native location/presentation intact.
+        diagnostic: RdfDiagnostic,
+        /// Exact original scalar extent, or an exact end boundary, when located.
+        source: Option<Extent>,
+    },
+}
+
+purrdf_lex::variant_from!(impl<C,O> EncodedReadError<C,O> { Storage(StorageError) });
+
+impl<C: core::fmt::Display, O: core::fmt::Display> core::fmt::Display for EncodedReadError<C, O> {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::Codec(cause) => cause.fmt(f),
+            Self::Control(cause) => cause.fmt(f),
+            Self::Storage(cause) => cause.fmt(f),
+            Self::Read { cause, offset } => {
+                write!(f, "encoded source read at byte {offset}: {cause}")
+            }
+            Self::ReadCount { actual, maximum } => write!(
+                f,
+                "reader returned {actual} bytes for a {maximum}-byte window"
+            ),
+            Self::Limit {
+                resource,
+                required,
+                limit,
+            } => write!(f, "{resource} needs {required} bytes, limit {limit}"),
+            Self::Parse { diagnostic, .. } => diagnostic.fmt(f),
+        }
+    }
+}
+impl<C: std::error::Error + 'static, O: std::error::Error + 'static> std::error::Error
+    for EncodedReadError<C, O>
+{
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Codec(cause) => Some(cause),
+            Self::Control(cause) => Some(cause),
+            Self::Storage(cause) => Some(cause),
+            Self::Read { cause, .. } => Some(cause),
+            Self::Parse { diagnostic, .. } => Some(diagnostic),
+            _ => None,
+        }
+    }
+}
+impl<C: purrdf_hash::error::StructuredError, O: purrdf_hash::error::StructuredError>
+    purrdf_hash::error::StructuredError for EncodedReadError<C, O>
+{
+    purrdf_hash::error_visit! {
+        Codec(cause)=>"encoded-read-codec" {"cause"=>Record(cause)},
+        Control(cause)=>"encoded-read-control" {"cause"=>Record(cause)},
+        Storage(cause)=>"encoded-read-storage" {"cause"=>Cause(cause)},
+        Read {cause,offset}=>"encoded-read-io" {"cause"=>Cause(cause),"offset"=>ByteCount(u128::from(*offset))},
+        ReadCount {actual,maximum}=>"encoded-read-count" {"actual"=>Unsigned(*actual as u128),"maximum"=>Unsigned(*maximum as u128)},
+        Limit {resource,required,limit}=>"encoded-read-limit" {"resource"=>Code(resource),"required"=>ByteCount(u128::from(*required)),"limit"=>ByteCount(u128::from(*limit))},
+        Parse {diagnostic,source}=>"encoded-read-parse" {
+            "cause"=>Cause(diagnostic),
+            "start"=>Value(source.map_or(purrdf_hash::error::ErrorValue::Absent,|range|purrdf_hash::error::ErrorValue::ByteCount(u128::from(range.start)))),
+            "end"=>Value(source.map_or(purrdf_hash::error::ErrorValue::Absent,|range|purrdf_hash::error::ErrorValue::ByteCount(u128::from(range.end))))
+        },
+    }
+}
diff --git crates/rdf/tests/encoded_reader.rs crates/rdf/tests/encoded_reader.rs
new file mode 100644
index 000000000..860e58370
--- /dev/null
+++ crates/rdf/tests/encoded_reader.rs
@@ -0,0 +1,539 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+//! Actual encoded ingestion, original cause transport and admitted conversion bounds.
+
+use core::convert::Infallible;
+use purrdf_lex::allocation::{Admission, Memory, Resident, StorageError};
+use purrdf_lex::control::Unmetered;
+use purrdf_lex::gb18030::{Direction, Extent, Limits, Profile, StreamError, Transcoder};
+use purrdf_rdf::{
+    EncodedReadError, EncodedReadOptions, SerializeGraph, parse_dataset,
+    parse_dataset_from_encoded_reader, parse_dataset_from_reader, serialize_dataset,
+};
+use std::io::Read;
+
+const PROFILE: Profile = Profile::Gb18030_2022Amendment1;
+fn options(profile: Profile) -> EncodedReadOptions {
+    EncodedReadOptions {
+        profile,
+        limits: Limits {
+            input_bytes: u64::MAX,
+            output_bytes: u64::MAX,
+        },
+        line_bytes: 1 << 20,
+        workspace_bytes: 8 << 20,
+    }
+}
+fn encode(text: &str, profile: Profile) -> (Vec<u8>, Vec<(char, Extent)>) {
+    let mut bytes = Vec::new();
+    let mut map = Vec::new();
+    Transcoder::new(profile, Direction::Encode, options(profile).limits)
+        .push(text.as_bytes(), true, &mut Unmetered, |item| {
+            map.push((item.scalar, item.output));
+            bytes.extend_from_slice(item.bytes);
+            Ok::<_, Infallible>(())
+        })
+        .expect("representable source");
+    (bytes, map)
+}
+struct Chunked<'a> {
+    bytes: &'a [u8],
+    chunk: usize,
+}
+impl Read for Chunked<'_> {
+    fn read(&mut self, out: &mut [u8]) -> std::io::Result<usize> {
+        let width = out.len().min(self.chunk);
+        self.bytes.read(&mut out[..width])
+    }
+}
+
+#[test]
+fn explicit_profiles_preserve_native_datasets_source_contributions_and_line_rules() {
+    for profile in [Profile::Gb18030_2005, PROFILE] {
+        for (media, text) in [
+            (
+                "application/n-quads",
+                "<https://example.org/中> <https://example.org/p> \"龴𠀇\"@zh .\r<https://example.org/中> <https://example.org/p> \"ordinary\" .\r\n# comment\n",
+            ),
+            (
+                "text/turtle",
+                "@prefix ex: <https://example.org/> .\r\nex:中 ex:p \"龴𠀇\"@zh .",
+            ),
+            (
+                "application/ld+json",
+                "{\"@id\":\"https://example.org/中\",\"https://example.org/p\":{\"@value\":\"龴𠀇\"}}",
+            ),
+            (
+                "application/x-hextuples",
+                "[\"https://example.org/中\",\"https://example.org/p\",\"龴𠀇\",\"http://www.w3.org/2001/XMLSchema#string\",\"\",\"\"]\r\n",
+            ),
+        ] {
+            let native = parse_dataset(text.as_bytes(), media, None).expect("native grammar");
+            let canonical =
+                serialize_dataset(&native, "application/n-quads", SerializeGraph::Dataset)
+                    .expect("native export");
+            let (bytes, expected) = encode(text, profile);
+            for chunk in [1, 2, 3, 4, 7, 8192] {
+                let mut resident = Resident;
+                let mut memory = Memory::new(&mut resident);
+                let mut observed = Vec::new();
+                let parsed = parse_dataset_from_encoded_reader(
+                    Chunked {
+                        bytes: &bytes,
+                        chunk,
+                    },
+                    media,
+                    None,
+                    options(profile),
+                    &mut memory,
+                    &mut Unmetered,
+                    |item| {
+                        observed.push((item.scalar, item.source));
+                        Ok::<_, Infallible>(())
+                    },
+                )
+                .expect("explicit encoded input");
+                assert_eq!(parsed.profile, profile);
+                assert_eq!(parsed.totals.input_bytes, bytes.len() as u64);
+                assert_eq!(parsed.totals.output_bytes, text.len() as u64);
+                assert_eq!(observed, expected);
+                assert_eq!(memory.admitted_bytes(), 0);
+                assert_eq!(
+                    serialize_dataset(
+                        &parsed.dataset,
+                        "application/n-quads",
+                        SerializeGraph::Dataset
+                    )
+                    .expect("encoded export"),
+                    canonical
+                );
+                assert_eq!(
+                    parsed.dataset.quads().collect::<Vec<_>>(),
+                    native.quads().collect::<Vec<_>>()
+                );
+            }
+            if media == "application/n-quads" {
+                assert!(
+                    parse_dataset_from_reader(bytes.as_slice(), media, None).is_err(),
+                    "UTF8 default must not sniff GB"
+                );
+            }
+        }
+    }
+    let media = "application/x-hextuples";
+    let row = "[\"https://example.org/中\",\"https://example.org/p\",\"https://example.org/o\",\"globalId\",\"\",\"\"]";
+    for (separator, valid) in [("\r", false), ("\r\n", true), ("\n", true)] {
+        let (bytes, _) = encode(&format!("{row}{separator}{row}"), PROFILE);
+        let mut resident = Resident;
+        let mut memory = Memory::new(&mut resident);
+        let result = parse_dataset_from_encoded_reader(
+            Chunked {
+                bytes: &bytes,
+                chunk: 1,
+            },
+            media,
+            None,
+            options(PROFILE),
+            &mut memory,
+            &mut Unmetered,
+            |_| Ok::<_, Infallible>(()),
+        );
+        assert_eq!(result.is_ok(), valid, "NDJSON separator {separator:?}");
+        assert_eq!(memory.admitted_bytes(), 0);
+    }
+}
+
+#[test]
+fn native_diagnostics_keep_scalar_columns_and_original_byte_extents() {
+    for profile in [Profile::Gb18030_2005, PROFILE] {
+        for media in ["application/n-triples", "text/turtle"] {
+            for prefix in [
+                "# 中\r\n",
+                "<https://example.org/中> <https://example.org/p> <https://example.org/o> .\r",
+            ] {
+                let text = format!("{prefix}<https://example.org/𠀇> <https://example.org/p> ！ .");
+                let native = parse_dataset_from_reader(text.as_bytes(), media, None)
+                    .expect_err("malformed object");
+                let location = native.location.as_ref().expect("located native error");
+                let column = location.column.expect("scalar column");
+                let (bytes, map) = encode(&text, profile);
+                let scalar_index = if media == "application/n-triples" {
+                    prefix.chars().count() + column as usize - 1
+                } else {
+                    let positions = purrdf_iri::LineIndex::new(&text);
+                    text.char_indices()
+                        .enumerate()
+                        .find_map(|(index, (byte, _))| {
+                            let position = positions.locate(&text, byte);
+                            (Some(position.line) == location.line && position.column == column)
+                                .then_some(index)
+                        })
+                        .expect("native buffered position")
+                };
+                let expected = map[scalar_index].1;
+                for chunk in [1, 3, 8192] {
+                    let mut resident = Resident;
+                    let mut memory = Memory::new(&mut resident);
+                    let error = parse_dataset_from_encoded_reader(
+                        Chunked {
+                            bytes: &bytes,
+                            chunk,
+                        },
+                        media,
+                        None,
+                        options(profile),
+                        &mut memory,
+                        &mut Unmetered,
+                        |_| Ok::<_, Infallible>(()),
+                    )
+                    .expect_err("native refusal");
+                    let EncodedReadError::Parse { diagnostic, source } = error else {
+                        panic!("native diagnostic");
+                    };
+                    assert_eq!(diagnostic.code, native.code);
+                    assert_eq!(diagnostic.message, native.message);
+                    assert_eq!(diagnostic.location, native.location);
+                    assert_eq!(source, Some(expected), "native byte extent with {prefix:?}");
+                    assert_eq!(memory.admitted_bytes(), 0);
+                }
+            }
+        }
+    }
+    // A malformed later line must not replace the first line's native grammar error.
+    let text = "<https://example.org/中> <https://example.org/p> ！ .\r";
+    let (mut bytes, _) = encode(text, PROFILE);
+    bytes.push(0x80);
+    let native = parse_dataset_from_reader(text.as_bytes(), "application/n-triples", None)
+        .expect_err("first line grammar");
+    for chunk in [1, 8192] {
+        let mut resident = Resident;
+        let mut memory = Memory::new(&mut resident);
+        let error = parse_dataset_from_encoded_reader(
+            Chunked {
+                bytes: &bytes,
+                chunk,
+            },
+            "application/n-triples",
+            None,
+            options(PROFILE),
+            &mut memory,
+            &mut Unmetered,
+            |_| Ok::<_, Infallible>(()),
+        )
+        .expect_err("first failure in document order");
+        let EncodedReadError::Parse { diagnostic, .. } = error else {
+            panic!("later byte must stay undecoded");
+        };
+        assert_eq!(diagnostic.message, native.message);
+        assert_eq!(diagnostic.location, native.location);
+        assert_eq!(memory.admitted_bytes(), 0);
+    }
+}
+
+#[derive(Debug)]
+struct HostFailure(std::sync::Arc<()>);
+impl core::fmt::Display for HostFailure {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.write_str("original host failure")
+    }
+}
+impl std::error::Error for HostFailure {}
+struct FailedRead {
+    token: Option<std::sync::Arc<()>>,
+}
+impl Read for FailedRead {
+    fn read(&mut self, _: &mut [u8]) -> std::io::Result<usize> {
+        Err(std::io::Error::other(HostFailure(
+            self.token.take().expect("one failed read"),
+        )))
+    }
+}
+
+struct InterruptedRead<R> {
+    reader: R,
+    remaining: usize,
+    attempts: std::rc::Rc<std::cell::Cell<usize>>,
+}
+impl<R: Read> Read for InterruptedRead<R> {
+    fn read(&mut self, bytes: &mut [u8]) -> std::io::Result<usize> {
+        self.attempts.set(self.attempts.get() + 1);
+        if self.remaining > 0 {
+            self.remaining -= 1;
+            return Err(std::io::ErrorKind::Interrupted.into());
+        }
+        self.reader.read(bytes)
+    }
+}
+
+#[test]
+fn actual_reader_preserves_original_codec_control_output_io_and_admission_causes() {
+    let mut resident = Resident;
+    let mut memory = Memory::new(&mut resident);
+    let attempts = std::rc::Rc::new(std::cell::Cell::new(0));
+    let parsed = parse_dataset_from_encoded_reader(
+        InterruptedRead {
+            reader: b"<https://example.org/s> <https://example.org/p> <https://example.org/o> ."
+                .as_slice(),
+            remaining: 2,
+            attempts: attempts.clone(),
+        },
+        "application/n-triples",
+        None,
+        options(PROFILE),
+        &mut memory,
+        &mut Unmetered,
+        |_| Ok::<_, Infallible>(()),
+    )
+    .expect("interrupted reads retry before valid RDF");
+    assert_eq!(parsed.totals.input_bytes, 73);
+    assert_eq!(attempts.get(), 4);
+    assert_eq!(memory.admitted_bytes(), 0);
+    let attempts = std::rc::Rc::new(std::cell::Cell::new(0));
+    let token = std::sync::Arc::new(());
+    let error = parse_dataset_from_encoded_reader(
+        InterruptedRead {
+            reader: b"#".as_slice(),
+            remaining: usize::MAX,
+            attempts: attempts.clone(),
+        },
+        "application/n-triples",
+        None,
+        options(PROFILE),
+        &mut memory,
+        &mut |units| {
+            assert_eq!(units, 0);
+            if attempts.get() == 2 {
+                Err(token.clone())
+            } else {
+                Ok(())
+            }
+        },
+        |_| Ok::<_, Infallible>(()),
+    )
+    .expect_err("cancellation polled before each read retry");
+    let EncodedReadError::Control(original) = error else {
+        panic!("unchanged retry cancellation");
+    };
+    assert!(std::sync::Arc::ptr_eq(&original, &token));
+    assert_eq!(attempts.get(), 2);
+    assert_eq!(memory.admitted_bytes(), 0);
+    let error = parse_dataset_from_encoded_reader(
+        b"#a".as_slice(),
+        "application/n-triples",
+        None,
+        options(PROFILE),
+        &mut memory,
+        &mut Unmetered,
+        |item| {
+            assert_ne!(item.scalar, 'a', "unwind with conversion buffers live");
+            Ok::<_, Infallible>(())
+        },
+    )
+    .expect_err("native boundary catches an unwind before refunding workspace");
+    let EncodedReadError::Parse { diagnostic, source } = error else {
+        panic!("native unwind diagnostic");
+    };
+    assert_eq!(diagnostic.code, "native-codec-panic");
+    assert!(source.is_none());
+    assert_eq!(memory.admitted_bytes(), 0);
+    let error = parse_dataset_from_encoded_reader(
+        &[b'#', 0x81, 0x30][..],
+        "application/n-triples",
+        None,
+        options(PROFILE),
+        &mut memory,
+        &mut Unmetered,
+        |_| Ok::<_, Infallible>(()),
+    )
+    .expect_err("incomplete source");
+    assert!(
+        matches!(error,EncodedReadError::Codec(StreamError::Native(error)) if error.profile==PROFILE && error.source==Extent {start:1,end:3} && error.kind==purrdf_lex::gb18030::ErrorKind::Incomplete)
+    );
+    assert_eq!(memory.admitted_bytes(), 0);
+    let token = std::sync::Arc::new(());
+    let error = parse_dataset_from_encoded_reader(
+        FailedRead {
+            token: Some(token.clone()),
+        },
+        "application/n-triples",
+        None,
+        options(PROFILE),
+        &mut memory,
+        &mut Unmetered,
+        |_| Ok::<_, Infallible>(()),
+    )
+    .expect_err("original read error");
+    let EncodedReadError::Read { cause, offset } = error else {
+        panic!("original I/O cause");
+    };
+    assert_eq!(offset, 0);
+    assert!(std::sync::Arc::ptr_eq(
+        &cause
+            .get_ref()
+            .expect("cause")
+            .downcast_ref::<HostFailure>()
+            .expect("typed original")
+            .0,
+        &token
+    ));
+    let mut stopped = Some(token.clone());
+    let error = parse_dataset_from_encoded_reader(
+        b"#".as_slice(),
+        "application/n-triples",
+        None,
+        options(PROFILE),
+        &mut memory,
+        &mut |_: u64| Err(stopped.take().expect("one stop poll")),
+        |_| Ok::<_, Infallible>(()),
+    )
+    .expect_err("original cancellation");
+    let EncodedReadError::Control(original) = error else {
+        panic!("unchanged control");
+    };
+    assert!(std::sync::Arc::ptr_eq(&original, &token));
+    let mut output = Some(token.clone());
+    let error = parse_dataset_from_encoded_reader(
+        b"#".as_slice(),
+        "application/n-triples",
+        None,
+        options(PROFILE),
+        &mut memory,
+        &mut Unmetered,
+        |_| Err(output.take().expect("one output failure")),
+    )
+    .expect_err("original output");
+    let EncodedReadError::Codec(StreamError::Output(original)) = error else {
+        panic!("unchanged output");
+    };
+    assert!(std::sync::Arc::ptr_eq(&original, &token));
+    let mut ceiling = purrdf_lex::allocation::Ceiling(0);
+    let mut memory = Memory::new(&mut ceiling);
+    let error = parse_dataset_from_encoded_reader(
+        b"#".as_slice(),
+        "application/n-triples",
+        None,
+        options(PROFILE),
+        &mut memory,
+        &mut Unmetered,
+        |_| Ok::<_, Infallible>(()),
+    )
+    .expect_err("original admission");
+    assert!(matches!(
+        error,
+        EncodedReadError::Storage(StorageError::AdmissionFailed)
+    ));
+    assert_eq!(memory.admitted_bytes(), 0);
+}
+
+#[derive(Default)]
+struct Account {
+    live: usize,
+    peak: usize,
+    resizes: usize,
+}
+impl Admission for Account {
+    fn resize(&mut self, live: usize) -> Result<(), StorageError> {
+        self.live = live;
+        self.peak = self.peak.max(live);
+        self.resizes += 1;
+        Ok(())
+    }
+}
+
+#[test]
+fn explicit_conversion_ceilings_have_valid_neighbors_and_growing_input_keeps_one_line_live() {
+    let mut resident = Resident;
+    let mut memory = Memory::new(&mut resident);
+    let mut config = options(PROFILE);
+    config.workspace_bytes = 0;
+    let error = parse_dataset_from_encoded_reader(
+        b"".as_slice(),
+        "application/n-triples",
+        None,
+        config,
+        &mut memory,
+        &mut Unmetered,
+        |_| Ok::<_, Infallible>(()),
+    )
+    .expect_err("fixed workspace");
+    let EncodedReadError::Limit { required, .. } = error else {
+        panic!("workspace limit");
+    };
+    config.workspace_bytes = required as usize + 1 + size_of::<Extent>();
+    config.line_bytes = 1;
+    parse_dataset_from_encoded_reader(
+        b"#".as_slice(),
+        "application/n-triples",
+        None,
+        config,
+        &mut memory,
+        &mut Unmetered,
+        |_| Ok::<_, Infallible>(()),
+    )
+    .expect("exact one-scalar neighbor");
+    config = options(PROFILE);
+    config.line_bytes = 1;
+    let error = parse_dataset_from_encoded_reader(
+        b"#x".as_slice(),
+        "application/n-triples",
+        None,
+        config,
+        &mut memory,
+        &mut Unmetered,
+        |_| Ok::<_, Infallible>(()),
+    )
+    .expect_err("line ceiling");
+    assert!(matches!(
+        error,
+        EncodedReadError::Limit {
+            resource: "transcode-line-bytes",
+            required: 2,
+            limit: 1
+        }
+    ));
+    config.line_bytes = 2;
+    parse_dataset_from_encoded_reader(
+        b"#x".as_slice(),
+        "application/n-triples",
+        None,
+        config,
+        &mut memory,
+        &mut Unmetered,
+        |_| Ok::<_, Infallible>(()),
+    )
+    .expect("exact line neighbor");
+    let line = "<https://example.org/中> <https://example.org/p> \"𠀇龴\" .\r\n";
+    let mut peaks = Vec::new();
+    for rows in [64, 257, 1025] {
+        let (bytes, _) = encode(&line.repeat(rows), PROFILE);
+        let mut account = Account::default();
+        let mut memory = Memory::new(&mut account);
+        let parsed = parse_dataset_from_encoded_reader(
+            bytes.as_slice(),
+            "application/n-triples",
+            None,
+            options(PROFILE),
+            &mut memory,
+            &mut Unmetered,
+            |_| Ok::<_, Infallible>(()),
+        )
+        .expect("growing stream");
+        assert_eq!(parsed.totals.input_bytes, bytes.len() as u64);
+        assert_eq!(memory.admitted_bytes(), 0);
+        assert_eq!(account.live, 0);
+        eprintln!(
+            "rows={rows} input={} utf8={} scalars={} conversion_peak={} resizes={}",
+            bytes.len(),
+            parsed.totals.output_bytes,
+            parsed.totals.scalars,
+            account.peak,
+            account.resizes
+        );
+        peaks.push(account.peak);
+    }
+    assert!(
+        peaks.windows(2).all(|pair| pair[0] == pair[1]),
+        "conversion workspace grows with a line, not input size"
+    );
+}
