+struct DictionaryReplay(Box<dyn cbor::ReplayStorage>);
+
+fn replay_io(error: std::io::Error) -> std::io::Error {
+    purrdf_hash::error::io_error(
+        std::io::ErrorKind::Other,
+        crate::dictionary::DictionaryError::from(error),
+    )
