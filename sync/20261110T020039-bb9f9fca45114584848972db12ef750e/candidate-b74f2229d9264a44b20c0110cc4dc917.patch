+    let id = purrdf_gts::wire::content_id(frame);
+    purrdf_lex::assoc::insert(frame, "id".into(), purrdf_lex::cbor::Value::Bytes(id));
+    let mut corrupt = Vec::new();
+    for (_, item) in items {
+        corrupt.extend(purrdf_gts::wire::canonical(&item));
