+                purrdf_sparql_eval::EvalError::WorkspaceStopped
+            )))
+        ));
+        assert_eq!(retained.streams.as_slice().as_ptr(), original_buffer);
+        assert!(
+            retained
+                .streams
+                .iter()
+                .all(|read| matches!(read.admission_failure_settlement, Some(Ok(None))))
+        );
+    }
 }
