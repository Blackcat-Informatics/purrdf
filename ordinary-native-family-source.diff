+        assert_eq!(erased.increment(), 1);
+        drop(capability);
+        drop(workspace);
+        assert!(ledger.live.load(Ordering::Relaxed) > 0);
+        assert_eq!(erased.increment(), 2);
+        drop(erased);
+        assert_eq!(ledger.live.load(Ordering::Relaxed), 0);
