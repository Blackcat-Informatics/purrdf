+pub(crate) fn filter_evidence<D: DatasetView + Sync>(
+    value: Option<bool>,
+    computed: Option<crate::evidence_exec::RowEvidence>,
+    expression: &Expression,
+    row: &RetainedRow<D::Id>,
+    schema: &VarSchema,
