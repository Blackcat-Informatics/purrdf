# The quick subset of `make check`, run on what the commit actually records.
# `.githooks/pre-merge-commit` hands over to this file, so a merge commit git
# creates on its own is checked exactly like one made with `git commit`.
#
# Every gate here reads the index, not the working tree: a commit assembled by
# partial staging is checked as it will exist, so a hunk left behind in the tree
# can neither hide a failure nor fake a pass. The gates are the ones that finish
# in a second or two; the census, the hash-domain registry, clippy, the build and
# the tests stay in `make check` and CI.
#
# Install once per clone with `make hooks`. Bypassing the hook does not bypass
# these gates: each one below also runs in `make check` and in CI. They are not
# byte-identical runs: the hook checks the staged index, `make check` the
# working tree, and CI the pull request's merge commit.

set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# Repository tooling and tests are Rust: the non-Rust ratchet in helper-census
# (crates/helper-census/src/non_rust.rs; AGENTS.md states the rules) compares the
# staged index with the merge-base of HEAD (and any MERGE_HEAD) and the
# integration branch, PURRDF_RATCHET_BASE or origin/main. `make check` runs it on
# the working tree and CI on the pull request. It runs before GIT_DIR and
# GIT_WORK_TREE are pointed at the snapshot below, so it reads the real index.
# `cargo run` builds the tool from the working tree the first time (or after it
# changes) and reuses the built binary afterwards.
if ! cargo run -q --locked -p helper-census -- \
    --root "$(git rev-parse --show-toplevel)" --non-rust-ratchet \
    --merge-base-with "${PURRDF_RATCHET_BASE:-origin/main}" --target index; then
    echo "pre-commit: the non-Rust ratchet refused the staged index (see above)." >&2
    exit 1
fi

snapshot=$(mktemp -d)
logs=$(mktemp -d)
trap 'rm -rf "$snapshot" "$logs"' EXIT
git checkout-index --all --force --prefix="$snapshot/"

# Gates that ask git which paths are tracked must see the index the snapshot
# was taken from, with the snapshot as the work tree.
GIT_DIR=$(git rev-parse --absolute-git-dir)
GIT_INDEX_FILE=${GIT_INDEX_FILE:-$GIT_DIR/index}
case "$GIT_INDEX_FILE" in /*) ;; *) GIT_INDEX_FILE=$(git rev-parse --show-toplevel)/$GIT_INDEX_FILE ;; esac
export GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE="$snapshot"

failed=0

if ! cargo run -q --locked -p helper-census -- --root "$snapshot" \
    --python-binding-tests >"$logs/python-binding-tests" 2>&1; then
    echo "pre-commit: Python-extension Rust test policy failed:" >&2
    sed 's/^/  /' "$logs/python-binding-tests" >&2
    failed=1
fi

# Formatting, for the staged Rust sources only.
mapfile -t rust < <(grep -E '\.rs$' <<<"$staged" || true)
if [ "${#rust[@]}" -gt 0 ]; then
    if ! (cd "$snapshot" && rustfmt --edition 2024 --check "${rust[@]}") >"$logs/rustfmt" 2>&1; then
        echo "pre-commit: rustfmt --check failed on staged sources:" >&2
        sed 's/^/  /' "$logs/rustfmt" >&2
        failed=1
    fi
fi

# Whole-tree hygiene gates that finish quickly, in parallel over the snapshot.
gates=(
    check-toolchain-pin
    check-gate-parity
    check-stream-chunk
    check-iri-resolver-singleton
    check-serializer-rewinds
    check-terminal-predicates
    check-thread-locals
    check-shapes-parser-drops
    check-licenses
    check-layers
    check-corpus-frozen
    check-brand-casing
    check-i18n-glossary
    check-publish-order
    check-wasm-js-exports
    check-entailment-surface
    check-python-stub-parity
    check-tracked-paths
    check-test-shards
)
pids=()
for gate in "${gates[@]}"; do
    python3 "$snapshot/scripts/$gate.py" >"$logs/$gate" 2>&1 &
    pids+=("$!")
done
for i in "${!gates[@]}"; do
    if ! wait "${pids[$i]}"; then
        echo "pre-commit: ${gates[$i]} failed:" >&2
        sed 's/^/  /' "$logs/${gates[$i]}" >&2
        failed=1
    fi
done

if [ "$failed" -ne 0 ]; then
    echo "pre-commit: the staged snapshot fails the gates above; fix and re-stage." >&2
    exit 1
fi
