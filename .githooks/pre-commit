# The quick subset of `make check`, run on what the commit actually records.
#
# Every gate here reads a snapshot of the index, not the working tree: a commit
# assembled by partial staging is checked as it will exist, so a hunk left
# behind in the tree can neither hide a failure nor fake a pass. The gates are
# the ones that finish in a second or two; the census, the hash-domain registry,
# clippy, the build and the tests stay in `make check` and CI.
#
# Install once per clone with `make hooks`. Bypassing the hook does not bypass
# the gates: `make check` and CI run every one of them again.

set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# Repository tooling and tests are Rust. Two rules hold for Python and JS/TS:
#
# 1. Every NEW .py, .mjs, .js, .cjs, .ts or .mts file anywhere in the tree (scripts,
#    binding tests, the wasm suite, ...; the frozen vendor corpora under vectors/
#    excepted) must say why it cannot be Rust: a `# Why not Rust: <reason>` (Python) or
#    `// Why not Rust: <reason>` (JS/TS) line within its first 40 lines, with a reason
#    of at least 30 characters.
# 2. The legacy Python and JS/TS tooling and tests may shrink but never grow: the staged
#    scripts/ Python and JS/TS, the wasm test suite (crates/rdf-wasm/js/tests/) and the
#    JS/TS under any crate's tests/ may not add more lines than they remove (git's `*`
#    matches `/`, so subdirectories count). A new file that carries its rule-1
#    explanation is not counted; growth of an existing file is. The shipped wasm
#    package surface (index.mjs, index.d.ts, src/) is not ratcheted.
#
# New checks, generators, gates and tests belong in Rust (helper-census, an xtask, a test).
if git rev-parse --verify --quiet HEAD >/dev/null; then
    explained=()
    unexplained=()
    while IFS= read -r -d '' path; do
        case "$path" in vectors/*) continue ;; esac
        if git show ":$path" | head -n 40 |
            grep -qiE '^[[:space:]]*(#|//)[[:space:]]*why not rust:[[:space:]]*[^[:space:]].{29,}'; then
            explained+=("$path")
        else
            unexplained+=("$path")
        fi
    done < <(git diff --cached --name-only --diff-filter=A -z -- \
        '*.py' '*.mjs' '*.js' '*.cjs' '*.ts' '*.mts')
    if [ "${#unexplained[@]}" -gt 0 ]; then
        echo "pre-commit: new Python/JS/TS file(s) without an explanation of why they cannot be Rust:" >&2
        printf '  %s\n' "${unexplained[@]}" >&2
        echo "  Write the logic in Rust, or add near the top of each file:" >&2
        echo "    # Why not Rust: <the concrete reason>      (Python)" >&2
        echo "    // Why not Rust: <the concrete reason>     (JS/TS)" >&2
        exit 1
    fi
    ratcheted=(
        'scripts/*.py' 'scripts/*.mjs' 'scripts/*.js' 'scripts/*.cjs' 'scripts/*.ts'
        'crates/rdf-wasm/js/tests/*'
        'crates/*/tests/*.mjs' 'crates/*/tests/*.js' 'crates/*/tests/*.ts'
    )
    growth=$(git diff --cached --numstat -M HEAD -- "${ratcheted[@]}" |
        awk -v skip="$(printf '%s\n' "${explained[@]}")" '
            BEGIN { n = split(skip, s, "\n"); for (i = 1; i <= n; i++) if (s[i] != "") ok[s[i]] = 1 }
            $1 != "-" && !($3 in ok) { net += $1 - $2 }
            END { print net + 0 }')
    if [ "$growth" -gt 0 ]; then
        echo "pre-commit: this commit grows the existing Python/JS tooling and tests by $growth net line(s)" >&2
        echo "  (scripts/, the wasm test suite, or JS/TS under a crate's tests/)." >&2
        echo "  Tooling and tests are written in Rust; these legacy files may only shrink." >&2
        echo "  Put the new logic in Rust (helper-census, an xtask, or a Rust test) instead," >&2
        echo "  or offset the growth by porting or removing at least as many lines." >&2
        exit 1
    fi
fi

snapshot=$(mktemp -d)
logs=$(mktemp -d)
trap 'rm -rf "$snapshot" "$logs"' EXIT
git checkout-index --all --force --prefix="$snapshot/"

# Gates that ask git which paths are tracked must see the index the snapshot
# was taken from, with the snapshot as the work tree.
GIT_DIR=$(git rev-parse --absolute-git-dir)
GIT_INDEX_FILE=${GIT_INDEX_FILE:-$GIT_DIR/index}
case "$GIT_INDEX_FILE" in /*) ;; *) GIT_INDEX_FILE=$(git rev-parse --show-toplevel)/$GIT_INDEX_FILE ;; esac
export GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE="$snapshot"

failed=0

# Formatting, for the staged Rust sources only.
mapfile -t rust < <(grep -E '\.rs$' <<<"$staged" || true)
if [ "${#rust[@]}" -gt 0 ]; then
    if ! (cd "$snapshot" && rustfmt --edition 2024 --check "${rust[@]}") >"$logs/rustfmt" 2>&1; then
        echo "pre-commit: rustfmt --check failed on staged sources:" >&2
        sed 's/^/  /' "$logs/rustfmt" >&2
        failed=1
    fi
fi

# Whole-tree hygiene gates that finish quickly, in parallel over the snapshot.
gates=(
    check-toolchain-pin
    check-gate-parity
    check-stream-chunk
    check-iri-resolver-singleton
    check-serializer-rewinds
    check-python-binding-tests
    check-terminal-predicates
    check-thread-locals
    check-shapes-parser-drops
    check-licenses
    check-layers
    check-corpus-frozen
    check-brand-casing
    check-i18n-glossary
    check-publish-order
    check-wasm-js-exports
    check-entailment-surface
    check-python-stub-parity
    check-tracked-paths
    check-test-shards
)
pids=()
for gate in "${gates[@]}"; do
    python3 "$snapshot/scripts/$gate.py" >"$logs/$gate" 2>&1 &
    pids+=("$!")
done
for i in "${!gates[@]}"; do
    if ! wait "${pids[$i]}"; then
        echo "pre-commit: ${gates[$i]} failed:" >&2
        sed 's/^/  /' "$logs/${gates[$i]}" >&2
        failed=1
    fi
done

if [ "$failed" -ne 0 ]; then
    echo "pre-commit: the staged snapshot fails the gates above; fix and re-stage." >&2
    exit 1
fi
