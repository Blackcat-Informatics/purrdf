# A merge that git commits by itself (no conflict, no `--no-commit`) runs this
# hook rather than pre-commit. Hand over, so the merge result is checked by the
# same gates as any other commit; a merge whose conflicts were resolved is
# committed with `git commit`, which runs pre-commit directly.
exec "$(dirname "$0")/pre-commit" "$@"
