+/// A compiled program and the exact physical grant that admitted its buffers.
+///
+/// Neither the program nor the grant can be detached. The callback owner is
+/// destroyed after the native program, including every source and arena buffer.
+#[derive(Debug)]
+pub struct OwnedCompiledPattern<S> {
+    pattern: CompiledPattern,
+    storage: S,
+}
+
+impl<S> OwnedCompiledPattern<S> {
+    /// Borrow the program while its original physical admission remains alive.
+    #[must_use]
+    pub const fn pattern(&self) -> &CompiledPattern { &self.pattern }
+
+    /// Inspect the original caller's account without detaching its grant.
+    #[must_use]
+    pub const fn storage(&self) -> &S { &self.storage }
+}
+
+/// A failed native compilation retaining its original typed admission owner.
+pub struct OwnedCompileError<S> {
+    error: Error,
+    storage: S,
+}
+
+impl<S> OwnedCompileError<S> {
+    /// The grammar, work or physical-storage verdict.
+    #[must_use]
+    pub const fn error(&self) -> &Error { &self.error }
+
+    /// Original caller account, including its first typed operational cause.
+    #[must_use]
+    pub const fn storage(&self) -> &S { &self.storage }
+}
+
+impl<S> std::fmt::Debug for OwnedCompileError<S> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("OwnedCompileError").field("error", &self.error).finish_non_exhaustive()
+    }
+}
+
+impl<S> std::fmt::Display for OwnedCompileError<S> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { self.error.fmt(f) }
+}
+
+impl<S> std::error::Error for OwnedCompileError<S> {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> { Some(&self.error) }
+}
