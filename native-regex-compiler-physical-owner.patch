+/// Compile the unchanged dated grammar with an owned physical admission.
+///
+/// The same parser, program arenas, leading sets and parent-table analysis run
+/// for resident and admitted construction. Matcher and replacement storage are
+/// separately admitted by their execution entry points.
+///
+/// # Errors
+///
+/// Preserves the original caller account alongside every grammar, work,
+/// layout, allocator or physical-admission failure.
+pub fn compile_with_storage<S: purrdf_lex::allocation::Admission>(
+    profile: Profile,
+    pattern: &str,
+    flags: &str,
+    limits: Limits,
+    mut storage: S,
+) -> Result<OwnedCompiledPattern<S>, OwnedCompileError<S>> {
+    let verdict = compile_budget(profile, pattern, flags, Budget::with_storage(limits, &mut storage));
+    match verdict {
+        Ok(pattern) => Ok(OwnedCompiledPattern { pattern, storage }),
+        Err(error) => Err(OwnedCompileError { error, storage }),
+    }
+}
