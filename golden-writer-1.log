== shaped-only schema
{
  "$defs": {
    "Annotation": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "properties": {
              "@id": {
                "type": "string"
              }
            },
            "required": [
              "@id"
            ],
            "type": "object"
          },
          {
            "properties": {
              "@type": {
                "type": "string"
              },
              "@value": {}
            },
            "required": [
              "@value"
            ],
            "type": "object"
          }
        ]
      },
      "description": "Free-form metadata about an asserted triple (e.g. meta:accordingTo, meta:confidence, meta:assertedAt). Permissive.",
      "title": "RDF-1.2 statement metadata (reifier annotation)",
      "type": "object"
    },
    "Node": {
      "allOf": [
        {
          "if": {
            "properties": {
              "@type": {
                "anyOf": [
                  {
                    "const": "ex:Person"
                  },
                  {
                    "contains": {
                      "const": "ex:Person"
                    },
                    "type": "array"
                  }
                ]
              }
            },
            "required": [
              "@type"
            ]
          },
          "then": {
            "$ref": "#/$defs/Person"
          }
        }
      ],
      "description": "Validated by @type: a node typed ex:Foo MUST satisfy #/$defs/Foo (closed-world). Nodes typed only by unmodeled classes are permissively allowed.",
      "properties": {
        "@annotation": {
          "$ref": "#/$defs/Annotation"
        },
        "@id": {
          "type": "string"
        },
        "@type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        }
      },
      "title": "A single discriminated PURRDF instance node",
      "type": "object"
    },
    "Person": {
      "properties": {
        "@annotation": {
          "$ref": "#/$defs/Annotation"
        },
        "@id": {
          "type": "string"
        },
        "@type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        },
        "ex:name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          ]
        }
      },
      "required": [
        "ex:name"
      ],
      "type": "object"
    }
  },
  "$id": "https://example.org/schema/schema/instance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "properties": {
        "@context": true,
        "@graph": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "type": "array"
        }
      },
      "required": [
        "@graph"
      ],
      "type": "object"
    },
    {
      "$ref": "#/$defs/Node"
    }
  ],
  "properties": {
    "@context": true,
    "@graph": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "type": "array"
    }
  },
  "title": "PURRDF instance schema (SHACL-derived, closed-world)",
  "type": "object"
