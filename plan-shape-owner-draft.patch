+/// The existing reverse fold, prepared before publication so a bounded lazy
+/// classification never allocates on an evaluator path after refusal.
+fn positive_region_table(
+    rows: &[NodeRow],
+    workspace: &crate::WorkspaceCapability,
+) -> Result<AdmittedVec<bool>, crate::EvalError> {
+    if !rows.iter().any(|row| row.kind.label() == "Union") { return Ok(AdmittedVec::new(workspace)); }
+    let mut facts = AdmittedVec::with_capacity(rows.len(), workspace)?;
+    for row in rows {
+        let label = row.kind.label();
+        facts.push_reserved((matches!(label, "Bgp" | "Join" | "Union"), label == "Union"));
+    }
+    for index in (1..rows.len()).rev() {
+        if let Some(parent) = rows[index].parent {
+            let child = facts[index];
+            let parent = &mut facts.as_mut_slice()[parent.index()];
+            parent.0 &= child.0;
+            parent.1 |= child.1;
+        }
+    }
+    let mut regions = AdmittedVec::with_capacity(rows.len(), workspace)?;
+    for (pure, union) in facts { regions.push_reserved(pure && union); }
+    Ok(regions)
+}
