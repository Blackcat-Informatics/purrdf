+    let reservation = if view.storage_live_budget().is_none() {
+        Some(view.reserve_workspace(0).map_err(AdmissionError::Operational)?)
+    } else {
+        None
+    };
+    Ok(ExecutionWorkspace {
+        owner,
+        _reservation: reservation,
+    })
