+//! Query-owned immutable parsed values and their admitted lookup table.
+
+use std::hash::Hash;
+use std::ops::Deref;
+use std::sync::Arc;
+
+use hashbrown::HashTable;
+use purrdf_xsd::{XsdDatatype, XsdValue};
+
+use crate::{EvalError, WorkspaceAllocation, WorkspaceCapability};
+
+/// A nonnumeric datatype belongs to its native parser's separate layout.
+/// This is a dispatch result, never an unsupported-operation refusal.
+pub(crate) enum NumericParse {
+    OtherDatatype,
+    Value(ParsedValue),
+    Invalid(Option<purrdf_xsd::ErrorCode>),
+}
+
+#[derive(Debug)]
+struct ParsedPayload {
+    // Values die before their admission, including the last shared cache view.
+    value: XsdValue,
+    _allocation: WorkspaceAllocation,
+}
+
+#[derive(Debug)]
+enum ParsedStorage {
+    // Constructed only when the value owns no heap allocation.
+    Inline(XsdValue),
+    Shared(Arc<ParsedPayload>),
+}
+
+/// No raw extraction or independent lease clone is exposed. Numeric operators
+/// borrow the value while this carrier keeps its original capacity admitted.
+#[derive(Debug)]
+pub(crate) struct ParsedValue {
+    storage: ParsedStorage,
+}
+
+impl Clone for ParsedValue {
+    fn clone(&self) -> Self {
+        Self { storage: match &self.storage {
+            ParsedStorage::Inline(value) => ParsedStorage::Inline(value.clone()),
+            ParsedStorage::Shared(payload) => ParsedStorage::Shared(payload.clone()),
+        } }
+    }
+}
+
+impl Deref for ParsedValue {
+    type Target = XsdValue;
+
+    fn deref(&self) -> &Self::Target {
+        match &self.storage {
+            ParsedStorage::Inline(value) => value,
+            ParsedStorage::Shared(payload) => &payload.value,
+        }
+    }
+}
+
+impl ParsedValue {
+    /// Parse a numeric literal after native checked physical admission.
+    /// Datatype/lexical errors keep the previous unbound result; operational
+    /// admission errors return directly without constructing diagnostic text.
+    pub(crate) fn parse_numeric(
+        lexical: &str,
+        datatype: XsdDatatype,
+        xsd10: bool,
+        workspace: &WorkspaceCapability,
+    ) -> Result<NumericParse, EvalError> {
+        let Some(layout) = purrdf_xsd::exact::cost::numeric_parse_layout(
+            lexical, datatype, xsd10,
+        ).map_err(|_| EvalError::WorkspaceBoundOverflow)? else {
+            return Ok(NumericParse::OtherDatatype);
+        };
+        if layout.is_invalid() { return Ok(NumericParse::Invalid(layout.error_code())); }
+        let header = if layout.retained_bytes() == 0 { 0 } else {
+            crate::workspace::shared_layout::<ParsedPayload>()?
+        };
+        let peak = u64::try_from(layout.peak_bytes())
+            .map_err(|_| EvalError::WorkspaceBoundOverflow)?
+            .checked_add(header).ok_or(EvalError::WorkspaceBoundOverflow)?;
+        // Known lexical refusal returns its code without owned diagnostic text.
+        // A true zero-heap parse also avoids allocating a workspace lease box.
+        let mut allocation = if peak == 0 { None } else { Some(workspace.charge(peak)?) };
+        let parsed = purrdf_xsd::value::try_parse_numeric(lexical, datatype, xsd10)
+            .map_err(|error| match error {
+                purrdf_xsd::bigint::LimbScratchError::SizeOverflow => EvalError::WorkspaceBoundOverflow,
+                _ => EvalError::AllocationFailed { construct: "numeric parse destination" },
+            })?;
+        let value = match parsed {
+            purrdf_xsd::value::ParsedNumeric::Value(value) => value,
+            purrdf_xsd::value::ParsedNumeric::Invalid(code) => return Ok(NumericParse::Invalid(code)),
+            purrdf_xsd::value::ParsedNumeric::OtherDatatype => return Ok(NumericParse::OtherDatatype),
+        };
+        let bytes = value.owned_heap_bytes().ok_or(EvalError::WorkspaceBoundOverflow)?;
+        if bytes == 0 {
+            drop(allocation);
+            return Ok(NumericParse::Value(Self { storage: ParsedStorage::Inline(value) }));
+        }
+        if bytes > layout.retained_bytes() {
+            // A violated native certificate is a hard invariant failure,
+            // never a request to silently obtain extra unpriced storage.
+            return Err(EvalError::WorkspaceBoundOverflow);
+        }
+        let retained = u64::try_from(bytes).map_err(|_| EvalError::WorkspaceBoundOverflow)?
+            .checked_add(header).ok_or(EvalError::WorkspaceBoundOverflow)?;
+        let mut allocation = allocation.take().ok_or(EvalError::WorkspaceBoundOverflow)?;
+        allocation.resize(retained)?;
+        let payload = Arc::new(ParsedPayload { value, _allocation: allocation });
+        Ok(NumericParse::Value(Self { storage: ParsedStorage::Shared(payload) }))
+    }
+}
+
+/// Table capacity belongs to the cache; individual value carriers own their
+/// parsed payload. Old and replacement tables stay admitted during growth.
+#[derive(Debug)]
+pub(crate) struct ParsedCache<K> {
+    entries: HashTable<(K, Option<ParsedValue>)>,
+    _allocation: Option<WorkspaceAllocation>,
+}
+
+// Deriving Default would impose K: Default, though an empty table needs no key.
+impl<K> Default for ParsedCache<K> {
+    fn default() -> Self {
+        Self { entries: HashTable::new(), _allocation: None }
+    }
+}
+
+impl<K: Copy + Eq + Hash> ParsedCache<K> {
+    /// The outer option distinguishes a miss from cached malformed/opaque None.
+    pub(crate) fn get(&self, key: K) -> Option<Option<ParsedValue>> {
+        self.entries.find(purrdf_hash::fixed::hash_one(&key), |entry| entry.0 == key)
+            .map(|entry| entry.1.clone())
+    }
+
+    pub(crate) fn insert_admitted(
+        &mut self,
+        key: K,
+        value: Option<ParsedValue>,
+        workspace: &WorkspaceCapability,
+    ) -> Result<(), EvalError> {
+        let hash = purrdf_hash::fixed::hash_one(&key);
+        if self.entries.find(hash, |entry| entry.0 == key).is_some() {
+            return Ok(());
+        }
+        let needed = self.entries.len().checked_add(1).ok_or(EvalError::WorkspaceBoundOverflow)?;
+        if needed > self.entries.capacity() {
+            let capacity = self.entries.capacity().checked_mul(2)
+                .ok_or(EvalError::WorkspaceBoundOverflow)?.max(needed);
+            let bytes = purrdf_core::hash::hash_table_allocation_bound::<(K, Option<ParsedValue>)>(capacity)
+                .ok_or(EvalError::WorkspaceBoundOverflow)?;
+            let allocation = workspace.charge(
+                u64::try_from(bytes).map_err(|_| EvalError::WorkspaceBoundOverflow)?,
+            )?;
+            let mut entries = HashTable::new();
+            entries.try_reserve(capacity, |entry: &(K, Option<ParsedValue>)| {
+                purrdf_hash::fixed::hash_one(&entry.0)
+            }).map_err(|_| EvalError::AllocationFailed { construct: "parsed-value cache table" })?;
+            for (old_key, old_value) in self.entries.iter() {
+                entries.insert_unique(
+                    purrdf_hash::fixed::hash_one(old_key), (*old_key, old_value.clone()),
+                    |entry| purrdf_hash::fixed::hash_one(&entry.0),
+                );
+            }
+            // Assignment drops the old table before releasing its admission.
+            self.entries = entries;
+            self._allocation = Some(allocation);
+        }
+        self.entries.insert_unique(hash, (key, value), |entry| {
+            purrdf_hash::fixed::hash_one(&entry.0)
+        });
+        Ok(())
+    }
+}
