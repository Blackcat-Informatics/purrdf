+            let intercepts = prefix.starts_with(namespace)
+                || namespace
+                    .strip_prefix(prefix)
+                    .is_some_and(|suffix| function.local_name().starts_with(suffix));
+            if intercepts && conflict.is_none_or(|old| function.local_name() < old) {
+                conflict = Some(function.local_name());
