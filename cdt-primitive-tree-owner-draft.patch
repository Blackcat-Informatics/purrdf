+fn map_contains_key_with_memory(entries: &[CdtEntry], key: &CdtTerm, memory: &mut Memory<'_>) -> Result<bool, StorageError> {
+    let Some(key) = CdtKey::from_term_with_memory(key, memory)? else { return Ok(false); };
+    let found = entries.binary_search_by(|entry| total_key_cmp(&entry.key, &key)).is_ok();
+    key.release_with_memory(memory)?;
