+fn map_keys_with_memory(entries: &[CdtEntry], memory: &mut Memory<'_>) -> Result<CdtValue, StorageError> {
+    let mut items = Vec::new();
+    memory.reserve(&mut items, entries.len())?;
+    for entry in entries { items.push(entry.key.to_term_with_memory(memory)?); }
