+fn release_keyed(mut keyed: Vec<(CdtKey, usize)>, memory: &mut Memory<'_>) -> Result<(), StorageError> {
+    for (key, _) in keyed.drain(..) { key.release_with_memory(memory)?; }
+    memory.release_vec(keyed)
+}
