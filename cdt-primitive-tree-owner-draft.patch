+fn clone_terms<'a>(items: impl IntoIterator<Item = &'a CdtTerm>, memory: &mut Memory<'_>) -> Result<Vec<CdtTerm>, StorageError> {
+    let iterator = items.into_iter();
+    let mut output = Vec::new();
+    memory.reserve(&mut output, iterator.size_hint().0)?;
+    for item in iterator {
+        let term = item.clone_with_memory(memory)?;
+        memory.push(&mut output, term)?;
+    }
+    Ok(output)
+}
