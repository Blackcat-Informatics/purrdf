+        let original = ledger.live.load(Ordering::Relaxed);
+        drop(service);
+        assert_eq!(ledger.live.load(Ordering::Relaxed), original);
+        let ServiceLevel::Incomplete { reason } = &clone else { panic!("incomplete attestation"); };
+        assert_eq!(reason.as_str(), "shard three is rebuilding");
+        drop(clone);
+        assert_eq!(ledger.live.load(Ordering::Relaxed), base);
+    }
