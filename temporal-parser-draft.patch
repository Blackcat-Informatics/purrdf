+// ── Gregorian family parsing ─────────────────────────────────────────────────────
+
+/// Parse a year part `[-]YYYY[Y...]` (no trailing components).
+/// Returns `(signed_year, remaining_str_after_year_digits)`, the year deferred.
+/// The year must be ≥4 digits; >4 digits must not have a leading zero.
+fn parse_year_str<'a>(
+    dt: XsdDatatype,
+    lexical: &str,
+    s: &'a str,
+) -> Result<(Deferred<i64>, &'a str), TemporalReadError> {
+    let neg = s.starts_with('-');
+    let digits_start = usize::from(neg);
+    let rest = &s[digits_start..];
+    // Find how many leading ASCII digits there are.
+    let n_digits = rest.bytes().take_while(u8::is_ascii_digit).count();
+    if n_digits < 4 {
+        return Err(TemporalReadError::invalid(
+            dt,
+            lexical,
+            "year must be at least 4 digits",
+        ));
+    }
+    let year_digits = &rest[..n_digits];
+    if n_digits > 4 && year_digits.starts_with('0') {
+        return Err(TemporalReadError::invalid(
+            dt,
+            lexical,
+            "year wider than 4 digits must not have a leading zero",
+        ));
+    }
+    let (year, _) = read_year(dt, lexical, neg, year_digits);
+    let after = &rest[n_digits..];
+    Ok((year, after))
+}
+
+/// Max days per month with February = 29 (no year available; allow Feb 29).
+/// Index 0 = January, index 11 = December.
+const MONTH_MAX_DAYS_LEAP: [u8; 12] = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+
+/// A two-digit Gregorian field (`MM` or `DD`, XSD 1.1 Part 2 Appendix D): its largest
+/// value and the refusals naming it.
+struct TwoDigitField {
+    /// The field's largest value; the smallest is `1`.
+    max: u8,
+    /// The refusal of a field that is not exactly two ASCII digits.
+    width: &'static str,
+    /// The refusal of a field outside `1..=max`.
+    range: &'static str,
+}
+
+/// `monthFrag ::= ('0' [1-9]) | ('1' [0-2])`.
+const MONTH_FIELD: TwoDigitField = TwoDigitField {
+    max: 12,
+    width: "month must be exactly 2 digits",
+    range: "month out of range (01-12)",
+};
+
+/// `dayFrag ::= ('0' [1-9]) | ([12] digit) | ('3' [01])`.
+const DAY_FIELD: TwoDigitField = TwoDigitField {
+    max: 31,
+    width: "day must be exactly 2 digits",
+    range: "day out of range (01-31)",
+};
+
+/// Parse a two-digit Gregorian field, returning its value in `1..=field.max`: the
+/// one reading of `MM` and `DD`. Exactly two ASCII digits, so the value is read
+/// off the two bytes and no signed or wider spelling can slip through.
+fn parse_two_digit_field(
+    dt: XsdDatatype,
+    lexical: &str,
+    s: &str,
+    field: &TwoDigitField,
+) -> Result<u8, TemporalReadError> {
+    let &[tens, units] = s.as_bytes() else {
+        return Err(TemporalReadError::invalid(dt, lexical, field.width));
+    };
+    if !tens.is_ascii_digit() || !units.is_ascii_digit() {
+        return Err(TemporalReadError::invalid(dt, lexical, field.width));
+    }
+    let value = (tens - b'0') * 10 + (units - b'0');
+    if !(1..=field.max).contains(&value) {
+        return Err(TemporalReadError::invalid(dt, lexical, field.range));
+    }
+    Ok(value)
+}
+
+/// Dispatch parser for all five Gregorian datatypes.
+fn read_gregorian(datatype: XsdDatatype, lexical: &str) -> Result<Gregorian, TemporalReadError> {
+    let dt = datatype;
+    match dt {
+        XsdDatatype::GYear => {
+            // [-]YYYY[Y...][tz]
+            let (body, tz) = split_tz(dt, lexical, lexical)?;
+            let (year, after) = parse_year_str(dt, lexical, body)?;
+            if !after.is_empty() {
+                return Err(TemporalReadError::invalid(
+                    dt,
+                    lexical,
+                    "unexpected content after gYear",
+                ));
+            }
+            Ok(Gregorian {
+                year: Some(year?),
+                month: None,
+                day: None,
+                tz,
+                datatype: dt,
+            })
+        }
+        XsdDatatype::GMonth => {
+            // --MM[tz]
+            let (body, tz) = split_tz(dt, lexical, lexical)?;
+            let s = body
+                .strip_prefix("--")
+                .ok_or_else(|| TemporalReadError::invalid(dt, lexical, "gMonth must start with '--'"))?;
+            // After stripping "--", s must be exactly "MM" (2 digits)
+            if s.len() != 2 {
+                return Err(TemporalReadError::invalid(dt, lexical, "gMonth must be '--MM'"));
+            }
+            let month = parse_two_digit_field(dt, lexical, s, &MONTH_FIELD)?;
+            Ok(Gregorian {
+                year: None,
+                month: Some(month),
+                day: None,
+                tz,
+                datatype: dt,
+            })
+        }
+        XsdDatatype::GDay => {
+            // ---DD[tz]
+            let (body, tz) = split_tz(dt, lexical, lexical)?;
+            let s = body
+                .strip_prefix("---")
+                .ok_or_else(|| TemporalReadError::invalid(dt, lexical, "gDay must start with '---'"))?;
+            if s.len() != 2 {
+                return Err(TemporalReadError::invalid(dt, lexical, "gDay must be '---DD'"));
+            }
+            let day = parse_two_digit_field(dt, lexical, s, &DAY_FIELD)?;
+            Ok(Gregorian {
+                year: None,
+                month: None,
+                day: Some(day),
+                tz,
+                datatype: dt,
+            })
+        }
+        XsdDatatype::GYearMonth => {
+            // [-]YYYY[Y...]-MM[tz]
+            let (body, tz) = split_tz(dt, lexical, lexical)?;
+            let (year, after) = parse_year_str(dt, lexical, body)?;
+            // after must be "-MM"
+            let mm_str = after.strip_prefix('-').ok_or_else(|| {
+                TemporalReadError::invalid(dt, lexical, "gYearMonth: expected '-MM' after year")
+            })?;
+            if mm_str.len() != 2 {
+                return Err(TemporalReadError::invalid(
+                    dt,
+                    lexical,
+                    "gYearMonth: month part must be 2 digits",
+                ));
+            }
+            let month = parse_two_digit_field(dt, lexical, mm_str, &MONTH_FIELD)?;
+            Ok(Gregorian {
+                year: Some(year?),
+                month: Some(month),
+                day: None,
+                tz,
+                datatype: dt,
+            })
+        }
+        XsdDatatype::GMonthDay => {
+            // --MM-DD[tz]
+            let (body, tz) = split_tz(dt, lexical, lexical)?;
+            let s = body
+                .strip_prefix("--")
+                .ok_or_else(|| TemporalReadError::invalid(dt, lexical, "gMonthDay must start with '--'"))?;
+            // s must be "MM-DD" — exactly 5 chars
+            if s.len() != 5 || s.as_bytes()[2] != b'-' {
+                return Err(TemporalReadError::invalid(
+                    dt,
+                    lexical,
+                    "gMonthDay must be '--MM-DD'",
+                ));
+            }
+            let month = parse_two_digit_field(dt, lexical, &s[..2], &MONTH_FIELD)?;
+            let day = parse_two_digit_field(dt, lexical, &s[3..5], &DAY_FIELD)?;
+            // Validate day against month; use leap reference (Feb max = 29).
+            let max_day = MONTH_MAX_DAYS_LEAP[(month - 1) as usize];
+            if day > max_day {
+                return Err(TemporalReadError::invalid(dt, lexical, "day out of range for month"));
+            }
+            Ok(Gregorian {
+                year: None,
+                month: Some(month),
+                day: Some(day),
+                tz,
+                datatype: dt,
+            })
+        }
+        _ => Err(TemporalReadError::invalid(dt, lexical, "not a Gregorian datatype")),
+    }
+}
