+/// `xsd:time` = `time tz?`.
+fn read_time(s: &str) -> Result<Time, TemporalReadError> {
+    let dt = XsdDatatype::Time;
+    let (body, tz) = split_tz(dt, s, s)?;
+    let (hour, minute, second) = parse_hms(dt, s, body)?;
+    let second = second?;
+    Ok(Time {
+        hour,
+        minute,
+        second,
+        tz,
+    })
+}
