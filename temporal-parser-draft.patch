+/// `xsd:date` = `date tz?`.
+fn read_date(s: &str) -> Result<Date, TemporalReadError> {
+    let dt = XsdDatatype::Date;
+    let (body, tz) = split_tz(dt, s, s)?;
+    let (year, month, day) = parse_ymd(dt, s, body)?;
+    let year = year?;
+    Ok(Date {
+        year,
+        month,
+        day,
+        tz,
+    })
