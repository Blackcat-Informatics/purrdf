# Preserve the revision-pinned W3C CSVW corpus byte-for-byte. Some normative
# fixtures intentionally exercise CRLF and trailing-whitespace behavior.
crates/rdf/tests/fixtures/csvw-w3c/** -text -diff

# Preserve the pinned OBO Graphs schema and upstream license evidence byte-for-byte.
crates/rdf/tests/fixtures/obographs-0.3.2/README.upstream.md -text -diff
crates/rdf/tests/fixtures/obographs-0.3.2/pom.upstream.xml -text -diff
crates/rdf/tests/fixtures/obographs-0.3.2/obographs-schema.json -text -diff
crates/rdf/tests/fixtures/obographs-0.3.2/subschemas/** -text -diff

# Test goldens hold a serializer's exact bytes, CRLF record ends included (see
# crates/testkit/src/golden.rs), so no end-of-line conversion applies.
# The pre-push whitespace check accepts the CR of a CRLF record end there.
crates/*/tests/golden/** -text -diff whitespace=cr-at-eol

# The vendored JSON-Schema-Test-Suite and draft 2020-12 meta-schemas are frozen
# by digest (scripts/check-corpus-frozen.py), so no end-of-line conversion applies.
crates/jsonschema/tests/suite/** -text -diff
crates/jsonschema/metaschemas/** -text -diff

# The vendored Unicode Character Database is frozen by digest and kept verbatim;
# several upstream files carry trailing whitespace, which is part of the bytes.
crates/iri/unicode/*.*.*/*.txt -text -diff
