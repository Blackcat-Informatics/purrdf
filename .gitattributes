# Preserve the revision-pinned W3C CSVW corpus byte-for-byte. Some normative
# fixtures intentionally exercise CRLF and trailing-whitespace behavior.
crates/rdf/tests/fixtures/csvw-w3c/** -text -diff

# Preserve the pinned OBO Graphs schema and upstream license evidence byte-for-byte.
crates/rdf/tests/fixtures/obographs-0.3.2/README.upstream.md -text -diff
crates/rdf/tests/fixtures/obographs-0.3.2/pom.upstream.xml -text -diff
crates/rdf/tests/fixtures/obographs-0.3.2/obographs-schema.json -text -diff
crates/rdf/tests/fixtures/obographs-0.3.2/subschemas/** -text -diff

# Public mail retains upstream trailing empty lines and its original line ends.
# Keep the byte-frozen payload visible in diffs; only its empty EOF lines differ
# from source-code whitespace policy.
crates/mime/tests/corpus/cpython/msg_*.txt -text whitespace=-blank-at-eof

# The license-bundle writer separates notice sections with empty lines, including
# the final section. Preserve its generated format and keep the text diff visible.
crates/mime/licenses/NOTICE.txt whitespace=-blank-at-eof

# Test goldens hold a serializer's exact bytes, CRLF record ends included (see
# crates/testkit/src/golden.rs), so no end-of-line conversion applies.
# The pre-push whitespace check accepts the CR of a CRLF record end there.
crates/*/tests/golden/** -text -diff whitespace=cr-at-eol

# The vendored JSON-Schema-Test-Suite and draft 2020-12 meta-schemas are frozen
# by digest (scripts/check-corpus-frozen.py), so no end-of-line conversion applies.
crates/jsonschema/tests/suite/** -text -diff
crates/jsonschema/metaschemas/** -text -diff

# The vendored Unicode Character Database is frozen by digest and kept verbatim;
# several upstream files carry trailing whitespace, which is part of the bytes.
crates/iri/unicode/*.*.*/*.txt -text -diff

# Preserve the pinned W3C SHACL 1.2 vocabularies and shacl12-test-suite
# byte-for-byte, including the crate-local runtime copy of the vocabularies.
vectors/shacl12/** -text -diff
crates/shapes/spec/** -text -diff

# The vendored W3C XML Conformance Test Suite is frozen by digest and kept
# verbatim: its documents deliberately carry CRLF, bare CR, BOMs, and non-UTF-8
# encodings, which no end-of-line or encoding conversion may touch.
vectors/xmlconf/** -text -diff

# The vendored yaml-test-suite is frozen by digest; its inputs deliberately carry
# tabs and trailing white space, and no conversion may touch them.
vectors/yaml-test-suite/** -text -diff

# The W3C Recommendations the dated XPath regex tables are generated from are
# vendored verbatim and frozen by digest (scripts/check-corpus-frozen.py);
# REC-xml-20001006.html has CRLF line ends, which are part of the bytes.
vectors/w3c-recs/*.html -text -diff
