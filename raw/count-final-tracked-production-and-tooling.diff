+    /// Worker speculation and continuation of a conservatively stopped prefix are
+    /// different phases. Count both at their actual boundary, including the tail minted
+    /// after the last growth charge: charged headroom alone is not retained headroom.
+    #[test]
+    #[cfg(not(target_arch = "wasm32"))]
+    fn heavy_rows_bound_fork_work_and_retained_prefix_continuation_separately() {
+        use super::RowCheckpoint;
+        use crate::eval::EvalCtx;
+        use crate::governor::{ChargePoint, GovernorState, QueryGovernors};
+        use purrdf_core::{DatasetView, RdfDatasetBuilder, ResourceDimension, TermValue};
+        use purrdf_xsd::exact::Cost;
+        use std::sync::Arc;
+        use std::sync::atomic::{AtomicBool, AtomicU8, AtomicUsize, Ordering};
+
+        const ROWS: usize = 8_192;
+        const LEXICAL_BYTES: usize = 65_536;
+        fn value(index: usize) -> TermValue {
+            TermValue::simple_literal(format!("{index:016}{}", "x".repeat(LEXICAL_BYTES - 16)))
+        }
+        fn work<D: DatasetView + Sync>(ctx: &mut EvalCtx<'_, D>, index: usize, cost: Cost) -> bool {
+            if ctx.charge_exact_numeric(cost).is_err() {
+                return false;
+            }
+            // The admitted operation mints a distinct tail after its growth checkpoint.
+            // Its next charge must include this retained state, including worker ghosts.
+            let _ = ctx
+                .scratch
+                .try_intern(ctx.dataset, value(index))
+                .expect("fixture read");
+            true
+        }
+        fn await_fixture(ready: impl Fn() -> bool, reason: &str) {
+            let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+            while !ready() {
+                assert!(std::time::Instant::now() < deadline, "{reason}");
+                std::thread::yield_now();
+            }
+        }
+        let row_bytes = crate::scratch::value_bytes(&value(0));
+        assert_eq!(row_bytes, LEXICAL_BYTES as u64 + 71);
+        let cost = Cost::new(7, row_bytes * 2);
+        let point = ChargePoint::RowExpressionEvaluation;
+        let ds = RdfDatasetBuilder::new().freeze().expect("empty dataset");
+        let items: Vec<_> = (0..ROWS).collect();
+        for ceiling in [
+            row_bytes * 2 - 1,
+            row_bytes * 2,
+            row_bytes * 3,
+            row_bytes * 5,
+        ] {
+            let governors = QueryGovernors::METERED.with_max_scratch_bytes(ceiling);
+            let sequential = {
+                let state = Arc::new(GovernorState::new(&governors));
+                let mut ctx = EvalCtx::new(&ds).with_governors(Arc::clone(&state));
+                let mut checkpoint = RowCheckpoint::for_rows(&ctx, point, false, ROWS);
+                let mut rows = Vec::new();
+                for &index in &items {
+                    if checkpoint.pass(&ctx).is_err() || !work(&mut ctx, index, cost) {
+                        break;
+                    }
+                    rows.push(index);
+                }
+                (
+                    rows,
+                    state.tripped(),
+                    ResourceDimension::ALL.map(|dimension| state.consumed_in(dimension)),
+                    ctx.scratch.minted_bytes(),
+                )
+            };
+            for (threads, gated) in [(1, false), (4, false), (32, false), (4, true)] {
+                if gated && ceiling != row_bytes * 5 {
+                    continue;
+                }
+                let pool = rayon::ThreadPoolBuilder::new()
+                    .num_threads(threads)
+                    .build()
+                    .expect("pool");
+                let visits: Vec<_> = (0..ROWS).map(|_| AtomicU8::new(0)).collect();
+                let fork_visits = AtomicUsize::new(0);
+                let resume_visits = AtomicUsize::new(0);
+                let arrived: Vec<_> = (0..threads).map(|_| AtomicBool::new(false)).collect();
+                let arrivals = AtomicUsize::new(0);
+                let state = Arc::new(GovernorState::new(&governors));
+                let (observation, forked, resumed, prefix, retained, charged, pending) = pool
+                    .install(|| {
+                        let mut ctx = EvalCtx::new(&ds).with_governors(Arc::clone(&state));
+                        let checkpoint = RowCheckpoint::for_rows(&ctx, point, true, ROWS);
+                        let snapshot = ctx.loop_snapshot(ROWS);
+                        let (rows, chunks) = crate::parallel::par_loop_try_map_init(
+                            ctx.needs_bounded_loop_blocks(),
+                            false,
+                            &items,
+                            || {
+                                let mut child = ctx.fork_for_loop_worker(snapshot.as_ref());
+                                let mut local = checkpoint.clone();
+                                local.defer(&mut child);
+                                (child, local)
+                            },
+                            |(child, local), rows, &index| {
+                                if !local.reaches(index) || local.pass(child).is_err() {
+                                    return Ok(());
+                                }
+                                fork_visits.fetch_add(1, Ordering::Relaxed);
+                                visits[index].fetch_add(1, Ordering::Relaxed);
+                                if gated {
+                                    let worker = rayon::current_thread_index().expect("pool worker");
+                                    if !arrived[worker].swap(true, Ordering::Relaxed) {
+                                        arrivals.fetch_add(1, Ordering::Relaxed);
+                                        await_fixture(
+                                            || arrivals.load(Ordering::Relaxed) == threads,
+                                            "all four workers must enter before publishing a horizon",
+                                        );
+                                    }
+                                }
+                                if work(child, index, cost) {
+                                    local.keep();
+                                    rows.push(index);
+                                }
+                                if gated && index == 0 {
+                                    // Force one legal schedule with a conservatively
+                                    // stopped prefix: later source blocks publish enough
+                                    // real mint spend before the first block settles.
+                                    // Read the actual shared account, not a test mirror.
+                                    let shared = checkpoint
+                                        .ledger
+                                        .shared
+                                        .as_ref()
+                                        .expect("bounded fork shares scratch spend");
+                                    await_fixture(
+                                        || shared.scratch.load(Ordering::Relaxed) > ceiling,
+                                        "later blocks must publish scratch past the headroom",
+                                    );
+                                }
+                                local.settle(child);
+                                Ok(())
+                            },
+                            |(child, local)| local.finish(child, &checkpoint),
+                        )
+                        .expect("forked heavy rows");
+                        // The join is the phase boundary; caller worker identity is not.
+                        let forked = fork_visits.load(Ordering::Relaxed);
+                        let (mut rows, prefix) = checkpoint
+                            .commit_rows(&mut ctx, rows, chunks)
+                            .expect("ordered commit");
+                        let retained = ctx.scratch.minted_bytes();
+                        let charged = state.consumed_in(ResourceDimension::ScratchBytes);
+                        let pending = ctx.scratch.uncharged_growth();
+                        if let Some(prefix) = prefix {
+                            assert_eq!(retained, charged + pending);
+                            assert_eq!(pending, row_bytes, "the last uncharged tail is retained");
+                            assert_eq!(retained, prefix as u64 * row_bytes);
+                            let mut checkpoint =
+                                RowCheckpoint::for_rows(&ctx, point, false, ROWS - prefix);
+                            for &index in &items[prefix..] {
+                                if checkpoint.pass(&ctx).is_err() {
+                                    break;
+                                }
+                                resume_visits.fetch_add(1, Ordering::Relaxed);
+                                visits[index].fetch_add(1, Ordering::Relaxed);
+                                if !work(&mut ctx, index, cost) {
+                                    break;
+                                }
+                                rows.push(index);
+                            }
+                        }
+                        (
+                            (
+                                rows,
+                                state.tripped(),
+                                ResourceDimension::ALL
+                                    .map(|dimension| state.consumed_in(dimension)),
+                                ctx.scratch.minted_bytes(),
+                            ),
+                            forked,
+                            resume_visits.load(Ordering::Relaxed),
+                            prefix,
+                            retained,
+                            charged,
+                            pending,
+                        )
+                    });
+                let fork_bound = ceiling / row_bytes + threads as u64;
+                let resume_bound = ceiling.saturating_sub(retained) / row_bytes + 1;
+                assert!(
+                    forked as u64 <= fork_bound,
+                    "{forked} fork visits > {fork_bound}"
+                );
+                assert!(
+                    resumed as u64 <= resume_bound,
+                    "{resumed} resume visits > {resume_bound}"
+                );
+                assert!(
+                    visits
+                        .iter()
+                        .all(|count| count.load(Ordering::Relaxed) <= 1)
+                );
+                assert_eq!(observation, sequential, "{threads} workers at {ceiling}");
+                if gated {
+                    assert_eq!(prefix, Some(1));
+                    assert!(resumed > 1, "exercise multiple actual continuation rows");
+                }
+                eprintln!(
+                    "heavy phases: workers={threads} gated={gated} ceiling={ceiling} fork={forked}/{fork_bound} prefix={prefix:?} retained={retained} charged={charged} pending={pending} resume={resumed}/{resume_bound}"
+                );
+            }
+        }
+    }
+
+    /// Admission work and in-expression work are reported as they happen; the
+    /// ordered replay adds fuel but must never report either of them again.
+    #[test]
+    #[cfg(not(target_arch = "wasm32"))]
+    fn forked_admission_and_expression_work_reach_the_signal_exactly_once() {
+        use super::RowCheckpoint;
+        use crate::eval::EvalCtx;
+        use crate::governor::{ChargePoint, GovernorState, QueryGovernors, StopSignal};
+        use purrdf_core::{RdfDatasetBuilder, ResourceDimension, StopCause};
+        use std::sync::Arc;
+        use std::sync::atomic::{AtomicU64, Ordering};
+
+        #[derive(Debug, Default)]
+        struct Reported(AtomicU64);
+        impl StopSignal for Reported {
+            fn poll(&self) -> Option<StopCause> {
+                None
+            }
+            fn poll_after_work(&self, work: u64) -> Option<StopCause> {
+                self.0.fetch_add(work, Ordering::Relaxed);
+                None
+            }
+        }
+        const ROWS: usize = 1_031;
+        const EXPRESSION_WORK: u64 = 7;
+        let point = ChargePoint::RowExpressionEvaluation;
+        let ds = RdfDatasetBuilder::new().freeze().expect("empty dataset");
+        let items: Vec<_> = (0..ROWS).collect();
+        for threads in [1, 4, 32] {
+            let pool = rayon::ThreadPoolBuilder::new()
+                .num_threads(threads)
+                .build()
+                .expect("pool");
+            for base in [
+                QueryGovernors::UNBOUNDED,
+                QueryGovernors::METERED,
+                QueryGovernors::UNBOUNDED.with_fuel(1_000_000),
+            ] {
+                let signal = Arc::new(Reported::default());
+                let governors = base.with_stop_signal(Arc::clone(&signal) as Arc<dyn StopSignal>);
+                let state = Arc::new(GovernorState::new(&governors));
+                let (rows, resume) = pool.install(|| {
+                    let mut ctx = EvalCtx::new(&ds).with_governors(Arc::clone(&state));
+                    let checkpoint = RowCheckpoint::for_rows(&ctx, point, true, ROWS);
+                    let (rows, chunks) = crate::parallel::par_loop_try_map_init(
+                        ctx.needs_bounded_loop_blocks(),
+                        false,
+                        &items,
+                        || {
+                            let mut child = ctx.fork_for_worker();
+                            let mut local = checkpoint.clone();
+                            local.defer(&mut child);
+                            (child, local)
+                        },
+                        |(child, local), rows, &index| {
+                            assert!(local.reaches(index));
+                            local.pass(child).expect("admitted row");
+                            child
+                                .charge_amount(ResourceDimension::Fuel, EXPRESSION_WORK)
+                                .expect("admitted work");
+                            local.keep();
+                            rows.push(index);
+                            local.settle(child);
+                            Ok(())
+                        },
+                        |(child, local)| local.finish(child, &checkpoint),
+                    )
+                    .expect("forked row loop");
+                    checkpoint
+                        .commit_rows(&mut ctx, rows, chunks)
+                        .expect("ordered commit")
+                });
+                assert_eq!(rows, items);
+                assert_eq!(resume, None);
+                assert_eq!(state.poll_stop_after(1), None);
+                let expected = (ROWS as u64) * (point.cost() + EXPRESSION_WORK);
+                assert_eq!(
+                    signal.0.load(Ordering::Relaxed),
+                    expected + 1,
+                    "work reported once at {threads} workers: {governors:?}"
+                );
+                assert_eq!(
+                    state.consumed_in(ResourceDimension::Fuel),
+                    if state.is_engaged_in(ResourceDimension::Fuel) {
+                        expected
+                    } else {
+                        0
+                    }
+                );
+            }
+        }
+    }
+
+    #[test]
+    #[cfg(not(target_arch = "wasm32"))]
+    fn shared_spend_saturates_so_other_workers_cannot_miss_an_overflow() {
+        use super::ForkShared;
+        use std::sync::atomic::{AtomicU64, Ordering};
+
+        let total = AtomicU64::new(u64::MAX - 3);
+        std::thread::scope(|scope| {
+            for _ in 0..32 {
+                scope.spawn(|| {
+                    ForkShared::add_spend(&total, 2);
+                });
+            }
+        });
+        assert_eq!(total.load(Ordering::Relaxed), u64::MAX);
+        assert_eq!(ForkShared::add_spend(&total, 1), u64::MAX);
+    }
+
+    #[test]
+    fn bookkeeping_ledgers_do_not_allocate_shared_stopping_state() {
+        let unlimited = WorkerLedger::forking((u64::MAX - 1, u64::MAX - 1), false);
+        assert!(unlimited.shared.is_none());
+        let bounded = WorkerLedger::forking((1, u64::MAX), true);
+        assert!(bounded.shared.is_some());
+    }
+
+    /// An unchanged arena checkpoint contributes no scratch in ordered replay. New
+    /// mints and the marks of refused fuel charges remain at their original positions,
+    /// including when an unchanged checkpoint spans two settled items.
+    #[test]
+    fn unchanged_growth_is_omitted_without_losing_charge_marks_or_item_boundaries() {
+        let deferred = ExactDeferral::new((7, 100), true);
+        deferred.note_growth(2);
+        deferred.note_growth(2);
+        assert_eq!(deferred.end_item(), (0, 0, false, 1));
+        deferred.note_growth(2);
+        deferred
+            .charge_fuel(None, 3, Some(2))
+            .expect("fuel admitted");
+        deferred.note_growth(3);
+        assert!(deferred.charge_fuel(None, 8, Some(4)).is_err());
+        deferred.note_growth(4);
+        assert_eq!(deferred.end_item(), (11, 0, true, 4));
+        let charges = deferred.take_charges();
+        assert_eq!(
+            charges,
+            vec![
+                Deferred::Growth(2),
+                Deferred::Fuel {
+                    units: 3,
+                    mark: Some(ArenaMark::from_count(2)),
+                    point: None,
+                },
+                Deferred::Growth(3),
+                Deferred::Fuel {
+                    units: 8,
+                    mark: Some(ArenaMark::from_count(4)),
+                    point: None,
+                },
+            ]
+        );
+        assert_eq!(deferred.end_item(), (0, 0, false, 0));
+    }
+
+    #[test]
+    fn batched_numeric_charges_match_separate_charges_at_every_refusal_boundary() {
+        use crate::governor::ChargePoint;
+        let point = ChargePoint::RowExpressionEvaluation;
+        for headroom in [
+            (u64::MAX, u64::MAX),
+            (u64::MAX - 1, u64::MAX - 1),
+            (3, 10),
+            (100, 3),
+        ] {
+            for scratch in [false, true] {
+                let batched = ExactDeferral::new(headroom, scratch);
+                let separate = ExactDeferral::new(headroom, scratch);
+                for (work, computed, bytes) in [(0, 0, 0), (3, 2, 10), (1, 2, 20), (8, 3, 1)] {
+                    let got = batched.charge_numeric(point, work, computed, bytes);
+                    let expected = separate
+                        .charge_fuel(Some(point), work, Some(computed))
+                        .and_then(|()| {
+                            if scratch && bytes > 0 {
+                                separate.note_growth(computed);
+                                separate.admit_transient(bytes)
+                            } else {
+                                Ok(())
+                            }
+                        });
+                    assert_eq!(got, expected);
+                    assert_eq!(batched.end_item(), separate.end_item());
+                    if got.is_err() {
+                        break;
+                    }
+                }
+                assert_eq!(batched.take_charges(), separate.take_charges());
+            }
+        }
+    }
