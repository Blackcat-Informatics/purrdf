+    /// FILTER and filtered OPTIONAL already own fallibly allocated solution output.
+    /// Without replay, identity admission must keep that storage and every row binding.
+    #[test]
+    fn identity_commits_reuse_the_scheduler_output_without_replay() {
+        use super::{ItemLedger, RowAdmission, RowCheckpoint};
+        use crate::eval::EvalCtx;
+        use crate::governor::{ChargePoint, GovernorState, QueryGovernors};
+        use crate::solution::Solution;
+        use purrdf_core::{DatasetView, RdfDatasetBuilder, ResourceDimension, TermValue};
+        use std::sync::Arc;
+
+        fn scheduler_output<D: DatasetView + Sync>(
+            ctx: &mut EvalCtx<'_, D>,
+        ) -> Vec<Solution<D::Id>> {
+            let mut rows = crate::parallel::reserve_concatenated_rows(Vec::new(), [53])
+                .expect("fallibly allocated scheduler output");
+            for index in 0..37 {
+                let term = ctx
+                    .scratch
+                    .try_intern(
+                        ctx.dataset,
+                        TermValue::simple_literal(format!("row{index}")),
+                    )
+                    .expect("fixture read");
+                rows.push(
+                    [Some(term), (index % 2 == 0).then_some(term)]
+                        .into_iter()
+                        .collect(),
+                );
+            }
+            rows
+        }
+
+        let ds = RdfDatasetBuilder::new().freeze().expect("empty dataset");
+        for (mode, governed) in [
+            (RowAdmission::Free, false),
+            (RowAdmission::Free, true),
+            (RowAdmission::Sequential, true),
+            (RowAdmission::Forked, false),
+        ] {
+            let state = Arc::new(GovernorState::new(&QueryGovernors::METERED));
+            let mut ctx = EvalCtx::new(&ds);
+            if governed {
+                ctx = ctx.with_governors(Arc::clone(&state));
+            }
+            let checkpoint = RowCheckpoint::with_mode(mode, ChargePoint::RowExpressionEvaluation);
+            let rows = scheduler_output(&mut ctx);
+            let expected = rows.clone();
+            let pointer = rows.as_ptr();
+            let capacity = rows.capacity();
+            let consumed = ResourceDimension::ALL.map(|dimension| state.consumed_in(dimension));
+            let (rows, resume) = checkpoint
+                .commit_rows(&mut ctx, rows, [])
+                .expect("identity admission");
+            assert_eq!(rows.as_ptr(), pointer, "reuse the outer solution buffer");
+            assert_eq!(rows.capacity(), capacity, "retain spare scheduler capacity");
+            assert_eq!(rows, expected);
+            assert_eq!(resume, None);
+            assert_eq!(
+                ResourceDimension::ALL.map(|dimension| state.consumed_in(dimension)),
+                consumed
+            );
+        }
+
+        let mut ctx = EvalCtx::new(&ds);
+        let ledger = ItemLedger::for_items(&ctx);
+        let rows = scheduler_output(&mut ctx);
+        let expected = rows.clone();
+        let pointer = rows.as_ptr();
+        let capacity = rows.capacity();
+        let (rows, resume) = ledger
+            .commit_rows(&mut ctx, rows, [])
+            .expect("identity item admission");
+        assert_eq!(rows.as_ptr(), pointer, "reuse the outer solution buffer");
+        assert_eq!(rows.capacity(), capacity, "retain spare scheduler capacity");
+        assert_eq!(rows, expected);
+        assert_eq!(resume, None);
+
+        let input = scheduler_output(&mut ctx);
+        let expected = input.clone();
+        let pointer = input.as_ptr();
+        let capacity = input.capacity();
+        let minted = expected
+            .iter()
+            .cloned()
+            .map(crate::parallel::MintedRow::Direct)
+            .collect();
+        let checkpoint =
+            RowCheckpoint::with_mode(RowAdmission::Free, ChargePoint::RowExpressionEvaluation);
+        let (rows, resume) = checkpoint
+            .commit_into(&mut ctx, minted, [], input, |ctx, row| {
+                crate::parallel::reintern_minted_row(&mut ctx.scratch, ctx.dataset, row)
+            })
+            .expect("plain converting admission");
+        assert_eq!(
+            rows.as_ptr(),
+            pointer,
+            "reuse the typed input buffer through conversion"
+        );
+        assert_eq!(rows.capacity(), capacity, "retain its spare capacity");
+        assert_eq!(rows, expected);
+        assert_eq!(resume, None);
+    }
