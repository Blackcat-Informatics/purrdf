+    let Ok(parsed) = cose::parse_sign1(cose_bytes) else {
+        return false;
+    };
+    let Some(key) = keyring.resolve(parsed.kid(), parsed.algorithm()) else {
+        return false;
+    };
+    let result = verify_file_with_keyring(bytes, keyring);
+    parsed.verify(&index.id, key) == SigStatus::Valid
+        && result.ok
+        && result.invalid == 0
+        && result.unverified == 0
