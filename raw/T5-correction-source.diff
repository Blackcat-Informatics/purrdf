+const COMPACTION_PREDICATES: &[&str] = &[
+    RDF_TYPE,
+    stream::AGENT,
+    stream::TIMESTAMP,
+    stream::SOURCE_HEAD,
+    stream::SEALED_SOURCE,
+    stream::CONTENT_REFOLD_DIGEST,
+    stream::DETACHED_SIGNATURE_ROOT,
