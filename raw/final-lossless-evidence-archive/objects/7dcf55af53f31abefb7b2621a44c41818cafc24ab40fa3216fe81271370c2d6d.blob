[package]
name = "qualification-454-native-cost"
version = "0.0.0"
edition = "2024"
[workspace]
[dependencies]
purrdf-sparql-algebra = { path = "/opt/purrdf-454-native-cost-main-df2cec88/crates/sparql-algebra" }
purrdf-sparql-eval = { path = "/opt/purrdf-454-native-cost-main-df2cec88/crates/sparql-eval" }
purrdf-core = { path = "/opt/purrdf-454-native-cost-main-df2cec88/crates/rdf-core" }
purrdf-alloc-probe = { path = "/opt/purrdf-454-native-cost-main-df2cec88/crates/alloc-probe" }
[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 1
strip = "symbols"
debug-assertions = false
overflow-checks = false
