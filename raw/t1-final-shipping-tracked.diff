+                    lanes.iter_mut().zip(aggregates).zip(links.iter_mut())
+                {
+                    if lane.retired {
+                        continue;
+                    }
+                    let identity = |row: &Solution<D::Id>| -> Vec<Option<SolutionTerm<D::Id>>> {
+                        visible.as_ref().map_or_else(
+                            || row.to_vec(),
+                            |keep| keep.iter().map(|&column| row[column]).collect(),
+                        )
