+                            .iter_mut()
+                            .map(|link| link.term(row, &seq.schema, ctx))
+                            .collect::<Result<Vec<_>, _>>()?
+                    };
+                    if !agg.args().is_empty()
+                        && terms.iter().any(Option::is_none)
+                        && !matches!(agg.function(), AggregateFunction::Fold)
