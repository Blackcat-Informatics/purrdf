+    #[must_use]
+    pub fn contains(&self, subject: usize) -> bool {
+        self.subjects
+            .get(&subject)
+            .is_some_and(|&(types, allowed, fields)| {
+                types.is_power_of_two() && types & allowed != 0 && (types != 1 || fields == 7)
