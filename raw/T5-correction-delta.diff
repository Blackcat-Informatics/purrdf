+            state.1 &= !1;
+        }
+        let field = match predicate {
+            Some(stream::AGENT) => 1,
+            Some(stream::TIMESTAMP) => 2,
+            Some(stream::SOURCE_HEAD) => 4,
+            _ => return,
+        };
+        let Some(object) = g.terms.get(o) else {
+            state.1 &= !1;
+            return;
