+    }
+
+    fn class_subjects(&self, class: &str) -> impl Iterator<Item = usize> + '_ {
+        let bit = PROVENANCE_SHAPES
+            .iter()
+            .position(|&(name, _)| name == class)
+            .map_or(0, |index| 1 << index);
+        self.subjects
+            .iter()
