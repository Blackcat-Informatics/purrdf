+#[cfg(test)]
+mod tests {
+    use super::{Deferred, ExactDeferral, WorkerLedger};
+
+    /// Admission work and in-expression work are reported as they happen; the
+    /// ordered replay adds fuel but must never report either of them again.
+    #[test]
+    #[cfg(not(target_arch = "wasm32"))]
+    fn forked_admission_and_expression_work_reach_the_signal_exactly_once() {
+        use super::RowCheckpoint;
+        use crate::eval::EvalCtx;
+        use crate::governor::{ChargePoint, GovernorState, QueryGovernors, StopSignal};
+        use purrdf_core::{RdfDatasetBuilder, ResourceDimension, StopCause};
+        use std::sync::Arc;
+        use std::sync::atomic::{AtomicU64, Ordering};
+
+        #[derive(Debug, Default)]
+        struct Reported(AtomicU64);
+        impl StopSignal for Reported {
+            fn poll(&self) -> Option<StopCause> {
+                None
+            }
+            fn poll_after_work(&self, work: u64) -> Option<StopCause> {
+                self.0.fetch_add(work, Ordering::Relaxed);
+                None
+            }
+        }
+        const ROWS: usize = 1_031;
+        const EXPRESSION_WORK: u64 = 7;
+        let point = ChargePoint::RowExpressionEvaluation;
+        let ds = RdfDatasetBuilder::new().freeze().expect("empty dataset");
+        let items: Vec<_> = (0..ROWS).collect();
+        for threads in [1, 4, 32] {
+            let pool = rayon::ThreadPoolBuilder::new()
+                .num_threads(threads)
+                .build()
+                .expect("pool");
+            for base in [
+                QueryGovernors::UNBOUNDED,
+                QueryGovernors::METERED,
+                QueryGovernors::UNBOUNDED.with_fuel(1_000_000),
+            ] {
+                let signal = Arc::new(Reported::default());
+                let governors = base.with_stop_signal(Arc::clone(&signal) as Arc<dyn StopSignal>);
+                let state = Arc::new(GovernorState::new(&governors));
+                let (rows, resume) = pool.install(|| {
+                    let mut ctx = EvalCtx::new(&ds).with_governors(Arc::clone(&state));
+                    let checkpoint = RowCheckpoint::for_rows(&ctx, point, true, ROWS);
+                    let (rows, chunks) = crate::parallel::par_loop_try_map_init(
+                        ctx.needs_bounded_loop_blocks(),
+                        false,
+                        &items,
+                        || {
+                            let mut child = ctx.fork_for_worker();
+                            let mut local = checkpoint.clone();
+                            local.defer(&mut child);
+                            (child, local)
+                        },
+                        |(child, local), rows, &index| {
+                            assert!(local.reaches(index));
+                            local.pass(child).expect("admitted row");
+                            child
+                                .charge_amount(ResourceDimension::Fuel, EXPRESSION_WORK)
+                                .expect("admitted work");
+                            local.keep();
+                            rows.push(index);
+                            local.settle(child);
+                            Ok(())
+                        },
+                        |(child, local)| local.finish(child, &checkpoint),
+                    )
+                    .expect("forked row loop");
+                    checkpoint
+                        .commit(&mut ctx, rows, chunks, |_, row| Ok(row))
+                        .expect("ordered commit")
+                });
+                assert_eq!(rows, items);
+                assert_eq!(resume, None);
+                assert_eq!(state.poll_stop_after(1), None);
+                let expected = (ROWS as u64) * (point.cost() + EXPRESSION_WORK);
+                assert_eq!(
+                    signal.0.load(Ordering::Relaxed),
+                    expected + 1,
+                    "work reported once at {threads} workers: {governors:?}"
+                );
+                assert_eq!(
+                    state.consumed_in(ResourceDimension::Fuel),
+                    if state.is_engaged_in(ResourceDimension::Fuel) {
+                        expected
+                    } else {
+                        0
+                    }
+                );
+            }
+        }
+    }
+
+    #[test]
+    #[cfg(not(target_arch = "wasm32"))]
+    fn shared_spend_saturates_so_other_workers_cannot_miss_an_overflow() {
+        use super::ForkShared;
+        use std::sync::atomic::{AtomicU64, Ordering};
+
+        let total = AtomicU64::new(u64::MAX - 3);
+        std::thread::scope(|scope| {
+            for _ in 0..32 {
+                scope.spawn(|| {
+                    ForkShared::add_spend(&total, 2);
+                });
+            }
+        });
+        assert_eq!(total.load(Ordering::Relaxed), u64::MAX);
+        assert_eq!(ForkShared::add_spend(&total, 1), u64::MAX);
+    }
+
+    #[test]
+    fn bookkeeping_ledgers_do_not_allocate_shared_stopping_state() {
+        let unlimited = WorkerLedger::forking((u64::MAX - 1, u64::MAX - 1), false);
+        assert!(unlimited.shared.is_none());
+        let bounded = WorkerLedger::forking((1, u64::MAX), true);
+        assert!(bounded.shared.is_some());
+    }
+
+    /// An unchanged arena checkpoint contributes no scratch in ordered replay. New
+    /// mints and the marks of refused fuel charges remain at their original positions,
+    /// including when an unchanged checkpoint spans two settled items.
+    #[test]
+    fn unchanged_growth_is_omitted_without_losing_charge_marks_or_item_boundaries() {
+        let deferred = ExactDeferral::new((7, 100), true);
+        deferred.note_growth(2);
+        deferred.note_growth(2);
+        assert_eq!(deferred.end_item(), (0, 0, false, 1));
+        deferred.note_growth(2);
+        deferred
+            .charge_fuel(None, 3, Some(2))
+            .expect("fuel admitted");
+        deferred.note_growth(3);
+        assert!(deferred.charge_fuel(None, 8, Some(4)).is_err());
+        deferred.note_growth(4);
+        assert_eq!(deferred.end_item(), (11, 0, true, 4));
+        let charges = deferred.take_charges();
+        assert!(matches!(
+            &charges[..],
+            [
+                Deferred::Growth(2),
+                Deferred::Fuel {
+                    units: 3,
+                    mark: Some(2),
+                    ..
+                },
+                Deferred::Growth(3),
+                Deferred::Fuel {
+                    units: 8,
+                    mark: Some(4),
+                    ..
+                },
+            ]
+        ));
+        assert_eq!(deferred.end_item(), (0, 0, false, 0));
+    }
+
+    #[test]
+    fn batched_numeric_charges_match_separate_charges_at_every_refusal_boundary() {
+        use crate::governor::ChargePoint;
+        let point = ChargePoint::RowExpressionEvaluation;
+        for headroom in [
+            (u64::MAX, u64::MAX),
+            (u64::MAX - 1, u64::MAX - 1),
+            (3, 10),
+            (100, 3),
+        ] {
+            for scratch in [false, true] {
+                let batched = ExactDeferral::new(headroom, scratch);
+                let separate = ExactDeferral::new(headroom, scratch);
+                for (work, computed, bytes) in [(0, 0, 0), (3, 2, 10), (1, 2, 20), (8, 3, 1)] {
+                    let got = batched.charge_numeric(point, work, computed, bytes);
+                    let expected = separate
+                        .charge_fuel(Some(point), work, Some(computed))
+                        .and_then(|()| {
+                            if scratch && bytes > 0 {
+                                separate.note_growth(computed);
+                                separate.admit_transient(bytes)
+                            } else {
+                                Ok(())
+                            }
+                        });
+                    assert_eq!(got, expected);
+                    assert_eq!(batched.end_item(), separate.end_item());
+                    if got.is_err() {
+                        break;
+                    }
+                }
+                assert_eq!(batched.take_charges(), separate.take_charges());
+            }
+        }
+    }
+}
