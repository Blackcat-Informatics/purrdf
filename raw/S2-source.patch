+        let view = snapshot.query_view(PagedQueryLimits::UNBOUNDED);
+        assert!(matches!(
+            view.operation_status(),
+            ViewOperationStatus::Failed {
+                error: PagedQueryError::SourceSnapshot { source: 0, .. },
+                ..
+            }
