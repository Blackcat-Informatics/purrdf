+        assert_eq!(view.quads().count(), 0);
+        assert_eq!(view.named_graphs().count(), 0);
+        assert!(view.term_id_by_value(&iri("head")).is_err());
+        assert_eq!(provider.reads.load(Ordering::Relaxed), 0);
