+                    }
+                    BodyAtom::Role {
+                        from: 0,
+                        to: 1,
+                        role,
+                    } if read.is_none() => read = Some((at, role)),
+                    BodyAtom::Role { .. } | BodyAtom::Successors { .. } => return None,
+                }
+            }
+            let (at, role) = read?;
+            Some(SingleRead {
+                at,
+                patterns: patterns.indices(kb, role),
+            })
+        })
+        .collect()
