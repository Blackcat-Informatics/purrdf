cargo 1.100.0-nightly (7941be6fb 2026-09-11)
v26.10.0
wasm-bindgen 0.2.125
[profile.release]
opt-level = 3
lto = "fat"
codegen-units = 1
strip = "symbols"

# Benchmarks inherit release but keep symbols so perf/flamegraph work.
[profile.bench]
# No DWARF, but keep the symbol table. A profiler attributes samples by symbol
# name, which `strip = "none"` preserves against `[profile.release]`'s
# `strip = "symbols"`; full debug info buys source-line attribution that nothing
# in this repository's bench workflow reads, and pays for it in artifact size on
# the same disk the test lane is competing for.
debug = 0
strip = "none"

# === The GATE profile ===
#
# `make check` runs the whole test surface and `make conformance` runs every W3C
# suite through it, so both gates are bounded by how well the engines under them
# were compiled. `cargo test` builds with the `test` profile, which inherits
# every value in this block — including the `package` table below. The
# `[profile.test]` section further down sets exactly one thing, `debug = 0`, and
# must never set `opt-level`, `debug-assertions` or `overflow-checks`: those are
# stated once, here, and a second place to change them is how the gate would
# drift from what this block claims. `scripts/check-build-profiles.py` reads the
# resolved `test` graph, so the inheritance of those three is proven rather
# than assumed.
#
# This block replaced four hand-written per-crate `opt-level = 2` tables. They
# were right about the mechanism and wrong about its reach: the `"*"` glob below
# matches DEPENDENCIES ONLY — Cargo excludes workspace members from it — so
# every member that was not individually named sat at the dev default of
# opt-level 0. That was twenty-one crates, among them the SHACL validator, the
# ShEx validator, the SPARQL evaluator, the Datalog substrate and the GTS codec:
# precisely the engines the conformance corpora exercise. The manifest looked
# tuned and the gate was not, and nothing in the build said so.
#
# The deleted tables' measured rationale is why the base is opt-3, so it lives
# on here. At the dev default the zero-copy SPARQL lexer and the id-native
# string interners pay full un-inlined call overhead on every byte, making the
# compute-bound parse/property-test suite roughly 300x slower than release (~3 s vs
# ~10 ms for a ~4350-triple parse) and blowing test timeouts. The OWL-Direct
# tableau is checked against a naive model-enumeration oracle
# (`owl_dl::oracle`) that decides satisfiability by enumerating EVERY
# interpretation over a bounded domain — exponential on purpose, because the
# oracle's whole value is being too simple to be wrong — so its cost is a
# bitmask inner loop run hundreds of millions of times, which un-inlined codegen
# made roughly 15x slower.
#
# Optimizing the gate does not cost build time, which is the counter-intuitive
# part. MEASURED on the SHACL crate, which sat at opt-level 0, two samples per
# arm on a shared 32-core host (so the fastest sample of each is quoted — the
# slow ones are contention, not codegen):
#
#   `cargo test -p purrdf-shapes` run time     9.9 s -> 2.0 s   (~5x faster)
#   rebuild after one first-party edit         759 s -> 553 s   (faster, not slower)
#   peak single-rustc RSS                      3.5 -> 6.3 GiB   (the real cost)
#
# Un-inlined code is BIGGER, and a crate whose test surface links dozens of
# binaries pays that size back at every link, which is why opt-3 does not lose
# the build-time trade it looks like it should. What it does cost is memory per
# rustc process; that is the number to watch when sizing a CI runner, not wall
# clock.
#
# What is deliberately NOT set here:
#   * no `lto`, no `codegen-units = 1`. Both serialize codegen and inflate the
#     link step's memory. Release wants them because it ships once; the gate
#     wants the opposite, because it rebuilds constantly and CI runs it cold.
#   * no `strip`. At opt-3 inlining already shreds stack frames; deleting the
#     symbol names as well would leave a failing property test or conformance case
#     reporting bare addresses, on the one profile whose entire job is finding
#     bugs.
[profile.dev]
opt-level = 3
# Line tables rather than full DWARF: a backtrace keeps its function names and
# file/line, without the multi-GB symbol trees nothing here consumes.
debug = 1
# Orthogonal to opt-level, and load-bearing. First-party code carries
# `#[cfg(debug_assertions)]` bodies — the SPARQL parser and the BM25 scorer among
# them — that vanish silently with the flag, and overflow checks are what keep an
# arithmetic bug in a byte-deterministic codec from becoming a wrong-but-green
# run. Release-grade codegen AND the safety net, never one in place of the other.
debug-assertions = true
overflow-checks = true

# DEPENDENCIES ONLY — Cargo excludes workspace members from `"*"`. They inherit
# opt-level 3 from the base above, so it is stated once and proven for every unit
# by `scripts/check-build-profiles.py` rather than restated here.
#
# They keep the runtime checks too. Turning them off would buy build speed with
# the internal sanity checks of the crypto, compression and columnar crates,
# during exactly the runs whose job is finding bugs, in a library whose contract
# is byte determinism. That is not a trade this workspace makes at any measured
# price. The debug-info saving is taken here instead, where nearly every unit in
# the graph is.
[profile.test]
# Test binaries carry no debug info. `[profile.dev]`'s line tables exist so a
# backtrace from a REPL or an example keeps its function names; a test target is
# the one place that buys nothing, because a failing assertion prints its own
# file and line and a panicking test prints its own message. Meanwhile this is
# where the artifacts are: every integration-test file is its own linked binary,
# and the workspace has well over a hundred of them.
#
# Only `debug` is set. `opt-level`, `debug-assertions` and `overflow-checks` are
# inherited from `[profile.dev]`, which is deliberate and gated —
# `scripts/check-build-profiles.py` asserts those three and pointedly does not
# assert `debug`, on the grounds that debug-info size is disk hygiene rather than
# a correctness property.
debug = 0

[profile.dev.package."*"]
debug = false

# Build scripts, proc-macros and THEIR dependencies do not inherit the base
# profile — Cargo governs them with `build-override`, whose default is the
# unoptimized one. The deleted `[profile.dev.package."*"] opt-level = 2` table
# reached them only because `package."*"` outranks `build-override`, so raising
# the base alone would have QUIETLY DE-OPTIMIZED sixty units that are pure build
# time: `clap_derive`, `pyo3-macros`, `wasm-bindgen-macro` and the rest expand on every
# compile of every crate that uses them. Named here, where the population is
# named, instead of riding on a glob that means something else.
[profile.dev.build-override]
opt-level = 3
