+struct NoLookup;
+impl SignatureKeyring for NoLookup {
+    fn resolve(&self, _: Option<&[u8]>, _: Algorithm) -> Option<VerifyingKeyRef<'_>> {
+        panic!("malformed envelopes must not resolve a key")
+    }
