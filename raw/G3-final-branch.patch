+    /// Classify a materialized graph by the same rule as an evented reader.
+    #[must_use]
+    pub fn from_graph(g: &Graph) -> Self {
+        let mut subjects = Self::default();
+        for &(s, p, o, _) in &g.quads {
+            subjects.observe(g, s, p, o);
+        }
+        subjects
+    }
