+        use purrdf_core::{RdfDatasetBuilder, ResourceDimension, StopCause};
+        use std::sync::Arc;
+        use std::sync::atomic::{AtomicU64, Ordering};
+
+        #[derive(Debug, Default)]
+        struct Reported(AtomicU64);
+        impl StopSignal for Reported {
+            fn poll(&self) -> Option<StopCause> {
+                None
+            }
+            fn poll_after_work(&self, work: u64) -> Option<StopCause> {
+                self.0.fetch_add(work, Ordering::Relaxed);
+                None
+            }
+        }
+        const ROWS: usize = 1_031;
+        const EXPRESSION_WORK: u64 = 7;
+        let point = ChargePoint::RowExpressionEvaluation;
+        let ds = RdfDatasetBuilder::new().freeze().expect("empty dataset");
+        let items: Vec<_> = (0..ROWS).collect();
+        for threads in [1, 4, 32] {
+            let pool = rayon::ThreadPoolBuilder::new()
+                .num_threads(threads)
+                .build()
+                .expect("pool");
+            for base in [
+                QueryGovernors::UNBOUNDED,
+                QueryGovernors::METERED,
+                QueryGovernors::UNBOUNDED.with_fuel(1_000_000),
+            ] {
+                let signal = Arc::new(Reported::default());
+                let governors = base.with_stop_signal(Arc::clone(&signal) as Arc<dyn StopSignal>);
+                let state = Arc::new(GovernorState::new(&governors));
+                let (rows, resume) = pool.install(|| {
+                    let mut ctx = EvalCtx::new(&ds).with_governors(Arc::clone(&state));
+                    let checkpoint = RowCheckpoint::for_rows(&ctx, point, true, ROWS);
+                    let (rows, chunks) = crate::parallel::par_loop_try_map_init(
+                        ctx.needs_bounded_loop_blocks(),
+                        false,
+                        &items,
+                        || {
+                            let mut child = ctx.fork_for_worker();
+                            let mut local = checkpoint.clone();
+                            local.defer(&mut child);
+                            (child, local)
