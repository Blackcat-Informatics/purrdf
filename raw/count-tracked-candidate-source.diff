+        const ROWS: usize = 8_192;
+        const LEXICAL_BYTES: usize = 65_536;
+        fn value(index: usize) -> TermValue {
+            TermValue::simple_literal(format!("{index:016}{}", "x".repeat(LEXICAL_BYTES - 16)))
+        }
+        fn work<D: DatasetView + Sync>(ctx: &mut EvalCtx<'_, D>, index: usize, cost: Cost) -> bool {
+            if ctx.charge_exact_numeric(cost).is_err() {
+                return false;
+            }
+            // The admitted operation mints a distinct tail after its growth checkpoint.
+            // Its next charge must include this retained state, including worker ghosts.
+            let _ = ctx
+                .scratch
+                .try_intern(ctx.dataset, value(index))
+                .expect("fixture read");
+            true
+        }
+        fn await_fixture(ready: impl Fn() -> bool, reason: &str) {
+            let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+            while !ready() {
+                assert!(std::time::Instant::now() < deadline, "{reason}");
+                std::thread::yield_now();
+            }
+        }
+        let row_bytes = crate::scratch::value_bytes(&value(0));
+        assert_eq!(row_bytes, LEXICAL_BYTES as u64 + 71);
+        let cost = Cost::new(7, row_bytes * 2);
+        let point = ChargePoint::RowExpressionEvaluation;
+        let ds = RdfDatasetBuilder::new().freeze().expect("empty dataset");
+        let items: Vec<_> = (0..ROWS).collect();
+        for ceiling in [
+            row_bytes * 2 - 1,
+            row_bytes * 2,
+            row_bytes * 3,
+            row_bytes * 5,
+        ] {
+            let governors = QueryGovernors::METERED.with_max_scratch_bytes(ceiling);
+            let sequential = {
+                let state = Arc::new(GovernorState::new(&governors));
+                let mut ctx = EvalCtx::new(&ds).with_governors(Arc::clone(&state));
+                let mut checkpoint = RowCheckpoint::for_rows(&ctx, point, false, ROWS);
+                let mut rows = Vec::new();
+                for &index in &items {
+                    if checkpoint.pass(&ctx).is_err() || !work(&mut ctx, index, cost) {
+                        break;
+                    }
+                    rows.push(index);
+                }
+                (
+                    rows,
+                    state.tripped(),
+                    ResourceDimension::ALL.map(|dimension| state.consumed_in(dimension)),
+                    ctx.scratch.minted_bytes(),
+                )
+            };
+            for (threads, gated) in [(1, false), (4, false), (32, false), (4, true)] {
+                if gated && ceiling != row_bytes * 5 {
