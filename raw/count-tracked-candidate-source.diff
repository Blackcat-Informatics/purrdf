+fn quoted(text: &str) -> Result<String, EstimatesError> {
+    if text.contains(['"', '\\']) || text.chars().any(char::is_control) {
+        return Err(EstimatesError(
+            "record string contains an escape or control character".to_owned(),
+        ));
+    }
+    Ok(format!("\"{text}\""))
+}
