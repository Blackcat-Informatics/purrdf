+    #[test]
+    #[cfg(not(target_arch = "wasm32"))]
+    fn heavy_rows_bound_fork_work_and_retained_prefix_continuation_separately() {
+        use super::RowCheckpoint;
+        use crate::eval::EvalCtx;
+        use crate::governor::{ChargePoint, GovernorState, QueryGovernors};
+        use purrdf_core::{DatasetView, RdfDatasetBuilder, ResourceDimension, TermValue};
+        use purrdf_xsd::exact::Cost;
+        use std::sync::Arc;
+        use std::sync::atomic::{AtomicBool, AtomicU8, AtomicUsize, Ordering};
