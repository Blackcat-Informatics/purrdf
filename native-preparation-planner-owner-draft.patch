+    let required = output.len().checked_add(frame)
+        .ok_or(purrdf_lex::allocation::StorageError::SizeOverflow)?;
+    if required > output.capacity() {
+        let capacity = output.capacity().checked_mul(2)
+            .ok_or(purrdf_lex::allocation::StorageError::SizeOverflow)?.max(required);
+        memory.reserve(output, capacity)?;
+    }
+    append_framed_part(output, label, value);
+    Ok(())
