+                }
+            }
+            (Self::Describe { targets: left, .. }, Self::Describe { targets: right, .. })
+                if left != right => return Ok(false),
+            _ => {}
+        }
+        self.pattern().eq_with_memory(other.pattern(), memory)
+    }
