+    pub fn eq_with_memory<S: Admission + ?Sized>(
+        &self, other: &Self, memory: &mut Memory<'_, S>,
+    ) -> Result<bool, StorageError> {
+        if core::mem::discriminant(self) != core::mem::discriminant(other)
+            || self.dataset() != other.dataset()
+            || self.base_iri() != other.base_iri()
+            || self.version() != other.version()
+        { return Ok(false); }
+        match (self, other) {
+            (Self::Construct { template: left, .. }, Self::Construct { template: right, .. }) => {
+                if left.len() != right.len() { return Ok(false); }
+                for (left, right) in left.iter().zip(right) {
+                    if left.graph != right.graph
+                        || !crate::traits::nodes_eq_with_memory(
+                            crate::walk::NodeRef::Triple(&left.triple),
+                            crate::walk::NodeRef::Triple(&right.triple), memory,
