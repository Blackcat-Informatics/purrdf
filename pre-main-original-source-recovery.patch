@@ -0,0 +1,310 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+//! Borrowed RDF 1.2 reason statements from the original retained description.
+
+use crate::TermValue;
+use purrdf_lex::allocation::{Admission, Memory};
+
+use super::{ReasonDescription, ReasonError, ReasonId};
+
+mod row;
+pub use row::{LedgerNodeKey, LedgerNodes, RowStatements, RowVocabulary};
+mod frame;
+pub use frame::{FrameStatements, FrameVocabulary};
+
+/// Caller-selected reason annotation predicates, with no namespace default.
+#[derive(Clone, Copy, Debug)]
+pub struct ReasonVocabulary<'a> {
+    /// The reason's cause, independently of the concern it reifies.
+    pub cause: &'a TermValue,
+    /// The original constraint identity.
+    pub constraint: &'a TermValue,
+    /// The original vault identity.
+    pub vault: &'a TermValue,
+    /// The original watermark identity.
+    pub watermark: &'a TermValue,
+}
+
+/// One borrowed statement in the answer's own graph, with no graph name.
+#[derive(Clone, Copy, Debug)]
+pub struct LedgerStatement<'a> {
+    /// Original reifier node owned by the answer.
+    pub subject: &'a TermValue,
+    /// A validated caller predicate or the W3C RDF 1.2 reification predicate.
+    pub predicate: &'a str,
+    /// Original term, including a genuine triple term for a reified concern.
+    pub object: &'a TermValue,
+}
+
+/// A malformed rendering declaration or original canonical spelling failure.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LedgerError {
+    /// A reifier must be an IRI or blank node.
+    InvalidReifier,
+    /// Every annotation predicate must be a valid caller-selected IRI.
+    InvalidPredicate,
+    /// The original reason is malformed or its native scratch was refused.
+    Reason(ReasonError),
+    /// A row evidence reifier must concern a genuine solution triple term.
+    InvalidSolution,
+    /// A required original dictionary node was not retained by the answer.
+    MissingNode(LedgerNodeKey),
+    /// Acceptance identities must be a sorted unique set of retained reasons.
+    InvalidAcceptance,
+}
+
+impl core::fmt::Display for LedgerError {
+    fn fmt(&self, out: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::InvalidReifier => out.write_str("ledger reifier must be an IRI or blank node"),
+            Self::InvalidPredicate => {
+                out.write_str("ledger annotation predicate must be a valid caller-selected IRI")
+            }
+            Self::Reason(error) => error.fmt(out),
+            Self::InvalidSolution => {
+                out.write_str("ledger solution must be an RDF 1.2 triple term")
+            }
+            Self::MissingNode(key) => write!(out, "original ledger dictionary lacks {key:?}"),
+            Self::InvalidAcceptance => {
+                out.write_str("ledger acceptance must name sorted unique original reasons")
+            }
+        }
+    }
+}
+
+impl std::error::Error for LedgerError {}
+
+pub(super) fn reifier(node: &TermValue) -> Result<(), LedgerError> {
+    match node {
+        TermValue::Blank { .. } => Ok(()),
+        TermValue::Iri(_) => predicate(node)
+            .map(|_| ())
+            .map_err(|_| LedgerError::InvalidReifier),
+        _ => Err(LedgerError::InvalidReifier),
+    }
+}
+
+pub(super) fn predicate(term: &TermValue) -> Result<&str, LedgerError> {
+    match term {
+        TermValue::Iri(value) if purrdf_iri::is_absolute(value).is_ok_and(|absolute| absolute) => {
+            Ok(value)
+        }
+        _ => Err(LedgerError::InvalidPredicate),
+    }
+}
+
+/// Lazy, allocation-free reason rendering borrowing the original answer owner.
+///
+/// Cause and concern are separate statements. A CONSTRUCT can keep the cause
+/// while dropping the reified concern, vault or constraint. Row completeness is
+/// independently annotated by the row renderer and never inferred from whether
+/// these statements are exposed. No resident term copy or named graph is born.
+#[derive(Debug)]
+pub struct ReasonStatements<'a> {
+    node: &'a TermValue,
+    description: ReasonDescription<'a>,
+    predicates: [&'a str; 4],
+    identity: ReasonId,
+    position: u8,
+}
+
+impl<'a> ReasonStatements<'a> {
+    /// Validate the complete declaration before exposing the first statement.
+    ///
+    /// The caller's node is minted from the returned content identity through
+    /// its chosen vocabulary. Its spelling never changes the reason identity.
+    ///
+    /// # Errors
+    /// Refuses invalid reifiers, predicates or original reason construction.
+    pub fn new<S: Admission + ?Sized>(
+        node: &'a TermValue,
+        description: ReasonDescription<'a>,
+        vocabulary: ReasonVocabulary<'a>,
+        memory: &mut Memory<'_, S>,
+    ) -> Result<Self, LedgerError> {
+        reifier(node)?;
+        let mut predicates = [""; 4];
+        for (slot, term) in predicates.iter_mut().zip([
+            vocabulary.cause,
+            vocabulary.constraint,
+            vocabulary.vault,
+            vocabulary.watermark,
+        ]) {
+            *slot = predicate(term)?;
+        }
+        let identity = description.identity(memory).map_err(LedgerError::Reason)?;
+        Ok(Self {
+            node,
+            description,
+            predicates,
+            identity,
+            position: 0,
+        })
+    }
+
+    /// Content identity of the borrowed original reason.
+    #[must_use]
+    pub const fn identity(&self) -> ReasonId {
+        self.identity
+    }
+}
+
+impl<'a> Iterator for ReasonStatements<'a> {
+    type Item = LedgerStatement<'a>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        while self.position < 5 {
+            let position = self.position;
+            self.position += 1;
+            let (predicate, object) = match position {
+                0 => (
+                    purrdf_iri::vocab::rdf::REIFIES,
+                    Some(self.description.concern),
+                ),
+                1 => (self.predicates[0], Some(self.description.cause)),
+                2 => (self.predicates[1], self.description.constraint),
+                3 => (self.predicates[2], self.description.vault),
+                _ => (self.predicates[3], self.description.watermark),
+            };
+            if let Some(object) = object {
+                return Some(LedgerStatement {
+                    subject: self.node,
+                    predicate,
+                    object,
+                });
+            }
+        }
+        None
+    }
+}
+
+impl core::iter::FusedIterator for ReasonStatements<'_> {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        TermBox,
+        evidence::{ReasonTable, RetainedReason},
+    };
+    use purrdf_lex::allocation::Resident;
+    use std::{cell::Cell, rc::Rc};
+
+    #[derive(Debug)]
+    struct OriginalTerm {
+        value: TermValue,
+        live: Rc<Cell<usize>>,
+    }
+    impl core::ops::Deref for OriginalTerm {
+        type Target = TermValue;
+        fn deref(&self) -> &TermValue {
+            &self.value
+        }
+    }
+    impl Drop for OriginalTerm {
+        fn drop(&mut self) {
+            self.live.set(self.live.get() - 1);
+        }
+    }
+
+    #[test]
+    fn lazy_reason_projection_keeps_original_owners_and_separates_cause_from_concern() {
+        let live = Rc::new(Cell::new(0));
+        let own = |value| {
+            live.set(live.get() + 1);
+            OriginalTerm {
+                value,
+                live: Rc::clone(&live),
+            }
+        };
+        let mut admission = Resident;
+        let mut memory = Memory::new(&mut admission);
+        let reason = RetainedReason::from_parts(
+            own(TermValue::iri("https://example.org/missing-time")),
+            own(TermValue::Triple {
+                s: TermBox::new(TermValue::iri("https://example.org/private-vault")),
+                p: TermBox::new(TermValue::iri("https://example.org/time")),
+                o: TermBox::new(TermValue::simple_literal("required")),
+            }),
+            None,
+            Some(own(TermValue::iri("https://example.org/private-vault"))),
+            None,
+            &mut memory,
+        )
+        .unwrap();
+        assert_eq!(live.get(), 3);
+        let node = TermValue::iri("https://example.org/reason-node");
+        let cause = TermValue::iri("https://example.org/cause");
+        let constraint = TermValue::iri("https://example.org/constraint");
+        let vault = TermValue::iri("https://example.org/vault");
+        let watermark = TermValue::iri("https://example.org/watermark");
+        let vocabulary = ReasonVocabulary {
+            cause: &cause,
+            constraint: &constraint,
+            vault: &vault,
+            watermark: &watermark,
+        };
+        let mut statements =
+            ReasonStatements::new(&node, reason.description(), vocabulary, &mut memory).unwrap();
+        assert_eq!(statements.identity(), reason.identity());
+        let reified = statements.next().unwrap();
+        assert_eq!(reified.predicate, purrdf_iri::vocab::rdf::REIFIES);
+        assert!(matches!(reified.object, TermValue::Triple { .. }));
+        assert!(core::ptr::eq(reified.object, reason.description().concern));
+        let cause_statement = statements.next().unwrap();
+        assert_eq!(cause_statement.predicate, "https://example.org/cause");
+        assert!(core::ptr::eq(
+            cause_statement.object,
+            reason.description().cause
+        ));
+        // A presenter can keep this cause without the original private concern.
+        assert!(!matches!(cause_statement.object, TermValue::Triple { .. }));
+        assert_eq!(
+            statements.next().unwrap().predicate,
+            "https://example.org/vault"
+        );
+        assert!(statements.next().is_none());
+        assert!(statements.next().is_none());
+        assert_eq!(live.get(), 3);
+        assert_eq!(memory.admitted_bytes(), 0);
+        let invalid = TermValue::iri("relative");
+        assert!(matches!(
+            ReasonStatements::new(
+                &node,
+                reason.description(),
+                ReasonVocabulary {
+                    cause: &invalid,
+                    ..vocabulary
+                },
+                &mut memory
+            ),
+            Err(LedgerError::InvalidPredicate)
+        ));
+        let original_id = reason.identity();
+        let mut table = ReasonTable::with_admission(Resident);
+        assert_eq!(table.intern(reason).unwrap(), original_id);
+        for _ in 0..2279 {
+            let duplicate = RetainedReason::from_parts(
+                own(TermValue::iri("https://example.org/missing-time")),
+                own(TermValue::Triple {
+                    s: TermBox::new(TermValue::iri("https://example.org/private-vault")),
+                    p: TermBox::new(TermValue::iri("https://example.org/time")),
+                    o: TermBox::new(TermValue::simple_literal("required")),
+                }),
+                None,
+                Some(own(TermValue::iri("https://example.org/private-vault"))),
+                None,
+                &mut memory,
+            )
+            .unwrap();
+            assert_eq!(live.get(), 6);
+            assert_eq!(table.intern(duplicate).unwrap(), original_id);
+            assert_eq!(live.get(), 3);
+        }
+        assert_eq!(table.entries().unwrap().len(), 1);
+        assert_eq!(table.get(original_id).unwrap().identity(), original_id);
+        drop(table);
+        assert_eq!(live.get(), 0);
+    }
+}
diff --git crates/rdf-core/src/evidence/ledger/frame.rs crates/rdf-core/src/evidence/ledger/frame.rs
new file mode 100644
index 000000000..0490e585b
--- /dev/null
+++ crates/rdf-core/src/evidence/ledger/frame.rs
@@ -0,0 +1,264 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+//! Lazy canonical frame alternatives, with no scenario-to-actual coercion.
+
+use super::{LedgerError, LedgerNodeKey, LedgerNodes, LedgerStatement, predicate, reifier};
+use crate::{TermValue, evidence::Frame};
+
+/// Explicit caller predicates and values for the frame's logical structure.
+#[derive(Clone, Copy, Debug)]
+pub struct FrameVocabulary<'a> {
+    /// Frame mode: actual, conjunction or disjunction.
+    pub mode: &'a TermValue,
+    /// Link to one conjunctive alternative of a disjunction.
+    pub alternative: &'a TermValue,
+    /// Membership predicates in FrameComponent's canonical kind order:
+    /// standpoint, counterfactual, imagined, assumed, licensed falsehood.
+    pub components: [&'a TermValue; 5],
+    /// Explicit unrestricted actual mode.
+    pub actual: &'a TermValue,
+    /// Explicit conjunctive mode.
+    pub conjunction: &'a TermValue,
+    /// Explicit alternative-witness mode.
+    pub disjunction: &'a TermValue,
+}
+
+/// Borrowed original canonical frame and immutable dictionary node carriers.
+#[derive(Debug)]
+pub struct FrameStatements<'a, N> {
+    frame: &'a Frame,
+    nodes: &'a N,
+    vocabulary: FrameVocabulary<'a>,
+    predicates: [&'a str; 7],
+    phase: u8,
+    branch: usize,
+    atom: usize,
+}
+
+impl<'a, N: LedgerNodes> FrameStatements<'a, N> {
+    /// Validate every required original node before any frame statement escapes.
+    ///
+    /// # Errors
+    /// Refuses malformed vocabulary or missing original node carriers.
+    pub fn new(
+        frame: &'a Frame,
+        nodes: &'a N,
+        vocabulary: FrameVocabulary<'a>,
+    ) -> Result<Self, LedgerError> {
+        let mut predicates = [""; 7];
+        for (slot, term) in predicates.iter_mut().zip(
+            [vocabulary.mode, vocabulary.alternative]
+                .into_iter()
+                .chain(vocabulary.components),
+        ) {
+            *slot = predicate(term)?;
+        }
+        for value in [
+            vocabulary.actual,
+            vocabulary.conjunction,
+            vocabulary.disjunction,
+        ] {
+            predicate(value)?;
+        }
+        let result = Self {
+            frame,
+            nodes,
+            vocabulary,
+            predicates,
+            phase: 0,
+            branch: 0,
+            atom: 0,
+        };
+        result.dictionary_node(LedgerNodeKey::Frame(frame.identity()))?;
+        for (index, branch) in frame.alternatives().iter().enumerate() {
+            result.dictionary_node(LedgerNodeKey::Frame(
+                frame
+                    .alternative_identity(index)
+                    .ok_or(LedgerError::MissingNode(LedgerNodeKey::Frame(
+                        frame.identity(),
+                    )))?,
+            ))?;
+            for atom in branch {
+                result.dictionary_node(LedgerNodeKey::Reference(atom.preimage().1))?;
+            }
+        }
+        Ok(result)
+    }
+
+    fn dictionary_node(&self, key: LedgerNodeKey) -> Result<&'a TermValue, LedgerError> {
+        let node = self.nodes.node(key).ok_or(LedgerError::MissingNode(key))?;
+        reifier(node)?;
+        Ok(node)
+    }
+
+    fn pull(&mut self) -> Result<Option<LedgerStatement<'a>>, LedgerError> {
+        let disjunction = self.frame.alternatives().len() > 1;
+        let (subject, predicate, object) = loop {
+            match self.phase {
+                0 => {
+                    self.phase = if self.frame.is_unrestricted_actual() {
+                        4
+                    } else if disjunction {
+                        1
+                    } else {
+                        3
+                    };
+                    break (
+                        self.dictionary_node(LedgerNodeKey::Frame(self.frame.identity()))?,
+                        self.predicates[0],
+                        if self.frame.is_unrestricted_actual() {
+                            self.vocabulary.actual
+                        } else if disjunction {
+                            self.vocabulary.disjunction
+                        } else {
+                            self.vocabulary.conjunction
+                        },
+                    );
+                }
+                1 | 2 => {
+                    let Some(id) = self.frame.alternative_identity(self.branch) else {
+                        self.phase = 4;
+                        continue;
+                    };
+                    let branch_node = self.dictionary_node(LedgerNodeKey::Frame(id))?;
+                    if self.phase == 1 {
+                        self.phase = 2;
+                        break (
+                            self.dictionary_node(LedgerNodeKey::Frame(self.frame.identity()))?,
+                            self.predicates[1],
+                            branch_node,
+                        );
+                    }
+                    self.phase = 3;
+                    break (branch_node, self.predicates[0], self.vocabulary.conjunction);
+                }
+                3 => {
+                    let Some(branch) = self.frame.alternatives().get(self.branch) else {
+                        self.phase = 4;
+                        continue;
+                    };
+                    let Some(atom) = branch.get(self.atom) else {
+                        self.branch += 1;
+                        self.atom = 0;
+                        self.phase = if disjunction { 1 } else { 4 };
+                        continue;
+                    };
+                    let (kind, id) = atom.preimage();
+                    let branch_id = self.frame.alternative_identity(self.branch).ok_or(
+                        LedgerError::MissingNode(LedgerNodeKey::Frame(self.frame.identity())),
+                    )?;
+                    self.atom += 1;
+                    break (
+                        self.dictionary_node(LedgerNodeKey::Frame(branch_id))?,
+                        self.predicates[usize::from(kind) + 2],
+                        self.dictionary_node(LedgerNodeKey::Reference(id))?,
+                    );
+                }
+                _ => return Ok(None),
+            }
+        };
+        Ok(Some(LedgerStatement {
+            subject,
+            predicate,
+            object,
+        }))
+    }
+}
+
+impl<'a, N: LedgerNodes> Iterator for FrameStatements<'a, N> {
+    type Item = Result<LedgerStatement<'a>, LedgerError>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        match self.pull() {
+            Ok(statement) => statement.map(Ok),
+            Err(error) => {
+                self.phase = 4;
+                Some(Err(error))
+            }
+        }
+    }
+}
+
+impl<N: LedgerNodes> core::iter::FusedIterator for FrameStatements<'_, N> {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::evidence::{FrameComponent, ledger::row::tests::Nodes};
+    use purrdf_hash::hex::Digest32;
+    use purrdf_lex::allocation::{Memory, Resident};
+
+    #[test]
+    fn original_frame_alternatives_render_without_promoting_scenarios_to_actual() {
+        let terms: [TermValue; 10] = core::array::from_fn(|index| {
+            TermValue::iri(format!("https://example.org/frame-v/{index}"))
+        });
+        let vocabulary = FrameVocabulary {
+            mode: &terms[0],
+            alternative: &terms[1],
+            components: [&terms[2], &terms[3], &terms[4], &terms[5], &terms[6]],
+            actual: &terms[7],
+            conjunction: &terms[8],
+            disjunction: &terms[9],
+        };
+        let mut admission = Resident;
+        let mut memory = Memory::new(&mut admission);
+        let first = Frame::from_components(
+            &[
+                FrameComponent::Standpoint(Digest32::new([1; 32])),
+                FrameComponent::Counterfactual(Digest32::new([2; 32])),
+            ],
+            &mut memory,
+        )
+        .unwrap();
+        let second = Frame::from_components(
+            &[FrameComponent::Imagined(Digest32::new([3; 32]))],
+            &mut memory,
+        )
+        .unwrap();
+        let frame = first.union(&second, &mut memory).unwrap();
+        let mut nodes = Nodes::default();
+        nodes.add(LedgerNodeKey::Frame(frame.identity()));
+        for (index, branch) in frame.alternatives().iter().enumerate() {
+            nodes.add(LedgerNodeKey::Frame(
+                frame.alternative_identity(index).unwrap(),
+            ));
+            for atom in branch {
+                nodes.add(LedgerNodeKey::Reference(atom.preimage().1));
+            }
+        }
+        let statements = FrameStatements::new(&frame, &nodes, vocabulary)
+            .unwrap()
+            .collect::<Result<Vec<_>, _>>()
+            .unwrap();
+        assert_eq!(statements.len(), 8);
+        assert_eq!(statements[0].object, vocabulary.disjunction);
+        assert_eq!(
+            statements
+                .iter()
+                .filter(
+                    |statement| statement.predicate == predicate(vocabulary.alternative).unwrap()
+                )
+                .count(),
+            2
+        );
+        assert!(
+            statements
+                .iter()
+                .all(|statement| statement.object != vocabulary.actual)
+        );
+        assert_eq!(first.identity(), frame.alternative_identity(0).unwrap());
+        assert_eq!(second.identity(), frame.alternative_identity(1).unwrap());
+        assert!(Frame::actual().alternative_identity(0).is_none());
+        let mut actual_nodes = Nodes::default();
+        let actual = Frame::actual();
+        actual_nodes.add(LedgerNodeKey::Frame(actual.identity()));
+        let actual_statements = FrameStatements::new(&actual, &actual_nodes, vocabulary)
+            .unwrap()
+            .collect::<Result<Vec<_>, _>>()
+            .unwrap();
+        assert_eq!(actual_statements.len(), 1);
+        assert_eq!(actual_statements[0].object, vocabulary.actual);
+    }
+}
diff --git crates/rdf-core/src/evidence/ledger/row.rs crates/rdf-core/src/evidence/ledger/row.rs
new file mode 100644
index 000000000..0cbb9c27f
--- /dev/null
+++ crates/rdf-core/src/evidence/ledger/row.rs
@@ -0,0 +1,529 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+//! Lazy solution annotations borrowing the original answer dictionary.
+
+use purrdf_hash::{Domain, blake3::RecordHasher, frame::frame_le_into, hex::Digest32};
+
+use super::{LedgerError, LedgerStatement, predicate, reifier};
+use crate::{
+    TermValue,
+    evidence::{AggregateBound, EvidenceRecord, Information, ReasonId, StandpointKey},
+};
+
+const ANNOTATION_DOMAIN: Domain = Domain::new(b"purrdf-core/evidence-annotation/v1");
+
+/// Content key of a retained ledger node, independent of row and insertion ids.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum LedgerNodeKey {
+    /// The canonical original cause/concern description.
+    Reason(ReasonId),
+    /// A frame's canonical disjunction or one canonical conjunctive branch.
+    Frame(Digest32),
+    /// The caller's original standpoint, scenario or output-column identity.
+    Reference(Digest32),
+    /// One pointwise information assertion, reused across equal row contexts.
+    Information(StandpointKey, Information),
+    /// An independent bound for one original output column.
+    Aggregate(Digest32, AggregateBound),
+}
+
+impl LedgerNodeKey {
+    /// Canonical identity used by the caller's deliberate node-minting policy.
+    #[must_use]
+    pub fn identity(self) -> Digest32 {
+        let mut hash = RecordHasher::new();
+        frame_le_into(&mut hash, ANNOTATION_DOMAIN.as_bytes());
+        match self {
+            Self::Reason(reason) => return reason.digest(),
+            Self::Frame(id) | Self::Reference(id) => return id,
+            Self::Information(standpoint, information) => {
+                frame_le_into(&mut hash, &[0]);
+                match standpoint {
+                    StandpointKey::Unscoped => frame_le_into(&mut hash, &[0]),
+                    StandpointKey::Declared(id) => {
+                        frame_le_into(&mut hash, &[1]);
+                        frame_le_into(&mut hash, id.as_bytes());
+                    }
+                }
+                frame_le_into(&mut hash, &[information as u8]);
+            }
+            Self::Aggregate(column, bound) => {
+                frame_le_into(&mut hash, &[1]);
+                frame_le_into(&mut hash, column.as_bytes());
+                frame_le_into(&mut hash, &[bound as u8]);
+            }
+        }
+        Digest32::new(*hash.finalize().as_bytes())
+    }
+}
+
+/// Immutable original node carriers retained under the answer's native owner.
+///
+/// Implementations borrow the answer's dictionary. They must preserve the node
+/// for a key throughout this borrow and mint content nodes through the caller's
+/// explicit vocabulary. Rendering never invents a namespace or adopts a copy.
+pub trait LedgerNodes: core::fmt::Debug {
+    /// Borrow the original node; missing required nodes are a hard invariant error.
+    fn node(&self, key: LedgerNodeKey) -> Option<&TermValue>;
+}
+
+/// Caller-selected predicates and enum values for solution evidence.
+///
+/// Information values follow FOUR's canonical encoding: neither, supported,
+/// opposed, both. Completeness values are complete, undetermined, not-evaluated;
+/// aggregate values are exact, lower, upper, undetermined. All are explicit IRIs.
+#[derive(Clone, Copy, Debug)]
+pub struct RowVocabulary<'a> {
+    /// Independent fact of input completeness, retained when reasons are withheld.
+    pub completeness: &'a TermValue,
+    /// Information value, both for a fallback and a scoped assertion.
+    pub information: &'a TermValue,
+    /// Link to a pointwise information assertion node.
+    pub information_context: &'a TermValue,
+    /// The assertion's selected standpoint.
+    pub standpoint: &'a TermValue,
+    /// Link to the original canonical frame.
+    pub frame: &'a TermValue,
+    /// Link to an original content-identified reason.
+    pub reason: &'a TermValue,
+    /// Explicit override, without removing the original reason or incompleteness.
+    pub accepted_reason: &'a TermValue,
+    /// Link to an independent output-column bound.
+    pub aggregate: &'a TermValue,
+    /// The bound's original output column.
+    pub column: &'a TermValue,
+    /// Its bound value.
+    pub bound: &'a TermValue,
+    /// Explicit unscoped context, outside the declared standpoint order.
+    pub unscoped: &'a TermValue,
+    /// FOUR values in canonical encoding order.
+    pub information_values: [&'a TermValue; 4],
+    /// Completeness values in canonical encoding order.
+    pub completeness_values: [&'a TermValue; 3],
+    /// Aggregate values in canonical encoding order.
+    pub bound_values: [&'a TermValue; 4],
+}
+
+/// Allocation-free row rendering, preserving original solution and dictionary.
+#[derive(Debug)]
+pub struct RowStatements<'a, N> {
+    node: &'a TermValue,
+    solution: &'a TermValue,
+    record: &'a EvidenceRecord,
+    nodes: &'a N,
+    vocabulary: RowVocabulary<'a>,
+    predicates: [&'a str; 10],
+    accepted: &'a [ReasonId],
+    phase: u8,
+    index: usize,
+}
+
+impl<'a, N: LedgerNodes> RowStatements<'a, N> {
+    /// Validate the entire row declaration before publishing any statement.
+    ///
+    /// Accepted ids here belong to this row; callers intersect the accepted
+    /// answer set with its original reasons. Every reason is still rendered.
+    ///
+    /// # Errors
+    /// Refuses malformed RDF, missing retained nodes and invalid acceptance.
+    pub fn new(
+        node: &'a TermValue,
+        solution: &'a TermValue,
+        record: &'a EvidenceRecord,
+        nodes: &'a N,
+        vocabulary: RowVocabulary<'a>,
+        accepted: &'a [ReasonId],
+    ) -> Result<Self, LedgerError> {
+        reifier(node)?;
+        if !matches!(solution, TermValue::Triple { .. }) {
+            return Err(LedgerError::InvalidSolution);
+        }
+        if accepted.windows(2).any(|pair| pair[0] >= pair[1])
+            || accepted
+                .iter()
+                .any(|reason| record.reasons().binary_search(reason).is_err())
+        {
+            return Err(LedgerError::InvalidAcceptance);
+        }
+        let declarations = [
+            vocabulary.completeness,
+            vocabulary.information,
+            vocabulary.information_context,
+            vocabulary.standpoint,
+            vocabulary.frame,
+            vocabulary.reason,
+            vocabulary.accepted_reason,
+            vocabulary.aggregate,
+            vocabulary.column,
+            vocabulary.bound,
+        ];
+        let mut predicates = [""; 10];
+        for (slot, declaration) in predicates.iter_mut().zip(declarations) {
+            *slot = predicate(declaration)?;
+        }
+        for value in core::iter::once(vocabulary.unscoped)
+            .chain(vocabulary.information_values)
+            .chain(vocabulary.completeness_values)
+            .chain(vocabulary.bound_values)
+        {
+            predicate(value)?;
+        }
+        let result = Self {
+            node,
+            solution,
+            record,
+            nodes,
+            vocabulary,
+            predicates,
+            accepted,
+            phase: 0,
+            index: 0,
+        };
+        result.dictionary_node(LedgerNodeKey::Frame(record.frame().identity()))?;
+        for reason in record.reasons() {
+            result.dictionary_node(LedgerNodeKey::Reason(*reason))?;
+        }
+        for &(standpoint, information) in record.information().entries() {
+            result.dictionary_node(LedgerNodeKey::Information(standpoint, information))?;
+            if let StandpointKey::Declared(id) = standpoint {
+                result.dictionary_node(LedgerNodeKey::Reference(id))?;
+            }
+        }
+        for &(column, bound) in record.aggregate_bounds() {
+            result.dictionary_node(LedgerNodeKey::Aggregate(column, bound))?;
+            result.dictionary_node(LedgerNodeKey::Reference(column))?;
+        }
+        Ok(result)
+    }
+
+    fn dictionary_node(&self, key: LedgerNodeKey) -> Result<&'a TermValue, LedgerError> {
+        let node = self.nodes.node(key).ok_or(LedgerError::MissingNode(key))?;
+        reifier(node)?;
+        Ok(node)
+    }
+
+    fn pull(&mut self) -> Result<Option<LedgerStatement<'a>>, LedgerError> {
+        let (subject, predicate, object) = loop {
+            match self.phase {
+                0 => {
+                    self.phase = 1;
+                    break (self.node, purrdf_iri::vocab::rdf::REIFIES, self.solution);
+                }
+                1 => {
+                    self.phase = 2;
+                    break (
+                        self.node,
+                        self.predicates[0],
+                        self.vocabulary.completeness_values[self.record.completeness() as usize],
+                    );
+                }
+                2 => {
+                    self.phase = 3;
+                    break (
+                        self.node,
+                        self.predicates[1],
+                        self.vocabulary.information_values
+                            [self.record.information().fallback() as usize],
+                    );
+                }
+                3 => {
+                    self.phase = 4;
+                    break (
+                        self.node,
+                        self.predicates[4],
+                        self.dictionary_node(LedgerNodeKey::Frame(self.record.frame().identity()))?,
+                    );
+                }
+                4 | 5 => {
+                    let reasons = if self.phase == 4 {
+                        self.record.reasons()
+                    } else {
+                        self.accepted
+                    };
+                    if let Some(&reason) = reasons.get(self.index) {
+                        self.index += 1;
+                        break (
+                            self.node,
+                            self.predicates[if self.phase == 4 { 5 } else { 6 }],
+                            self.dictionary_node(LedgerNodeKey::Reason(reason))?,
+                        );
+                    }
+                    self.phase += 1;
+                    self.index = 0;
+                }
+                6 => {
+                    let Some(&(standpoint, information)) =
+                        self.record.information().entries().get(self.index / 3)
+                    else {
+                        self.phase = 7;
+                        self.index = 0;
+                        continue;
+                    };
+                    let node =
+                        self.dictionary_node(LedgerNodeKey::Information(standpoint, information))?;
+                    let statement = match self.index % 3 {
+                        0 => (self.node, self.predicates[2], node),
+                        1 => (
+                            node,
+                            self.predicates[3],
+                            match standpoint {
+                                StandpointKey::Unscoped => self.vocabulary.unscoped,
+                                StandpointKey::Declared(id) => {
+                                    self.dictionary_node(LedgerNodeKey::Reference(id))?
+                                }
+                            },
+                        ),
+                        _ => (
+                            node,
+                            self.predicates[1],
+                            self.vocabulary.information_values[information as usize],
+                        ),
+                    };
+                    self.index += 1;
+                    break statement;
+                }
+                7 => {
+                    let Some(&(column, bound)) = self.record.aggregate_bounds().get(self.index / 3)
+                    else {
+                        self.phase = 8;
+                        continue;
+                    };
+                    let node = self.dictionary_node(LedgerNodeKey::Aggregate(column, bound))?;
+                    let statement = match self.index % 3 {
+                        0 => (self.node, self.predicates[7], node),
+                        1 => (
+                            node,
+                            self.predicates[8],
+                            self.dictionary_node(LedgerNodeKey::Reference(column))?,
+                        ),
+                        _ => (
+                            node,
+                            self.predicates[9],
+                            self.vocabulary.bound_values[bound as usize],
+                        ),
+                    };
+                    self.index += 1;
+                    break statement;
+                }
+                _ => return Ok(None),
+            }
+        };
+        Ok(Some(LedgerStatement {
+            subject,
+            predicate,
+            object,
+        }))
+    }
+}
+
+impl<'a, N: LedgerNodes> Iterator for RowStatements<'a, N> {
+    type Item = Result<LedgerStatement<'a>, LedgerError>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        match self.pull() {
+            Ok(statement) => statement.map(Ok),
+            Err(error) => {
+                self.phase = 8;
+                Some(Err(error))
+            }
+        }
+    }
+}
+
+impl<N: LedgerNodes> core::iter::FusedIterator for RowStatements<'_, N> {}
