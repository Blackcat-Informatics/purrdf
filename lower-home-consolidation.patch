+        impl $type {
+            $(#[$native])*
+            pub fn try_from_lexical(lexical: &str) -> Result<Self, $crate::exact::ExactParseError> {
+                Self::parse_with_storage(lexical, &$crate::bigint::scratch::Fallible)
+            }
