# XML Schema Part 2 Appendix G, "Character Class Escapes": the
# multi-character escapes \i \I \c \C \d \D \s \S \w \W. Every one of
# these differs from the regex crate's same-spelled escape, except \d/\D.

# \i -- XML NameStartChar: Letter | '_' | ':'. Both ':' and '_' are in.
^\i$	-	match	a
^\i$	-	match	_
^\i$	-	match	:
^\i$	-	match	\u00c0
^\i$	-	nomatch	1
^\i$	-	nomatch	-
^\i$	-	nomatch	.

# \I -- the complement of \i.
^\I$	-	match	1
^\I$	-	match	-
^\I$	-	nomatch	a
^\I$	-	nomatch	_
^\I$	-	nomatch	:

# \c -- XML NameChar: \i plus digits, '-', '.' and the combining ranges.
^\c$	-	match	a
^\c$	-	match	1
^\c$	-	match	-
^\c$	-	match	.
^\c$	-	match	_
^\c$	-	match	:
^\c$	-	nomatch	 
^\c$	-	nomatch	(

# \C -- the complement of \c.
^\C$	-	match	 
^\C$	-	match	(
^\C$	-	nomatch	a
^\C$	-	nomatch	-

# The canonical XML-name pattern, which the regex crate could not even
# compile before: `\i` is not one of its escapes.
^\i\c*$	-	match	abc123
^\i\c*$	-	match	_x
^\i\c*$	-	match	ns:local-name.v2
^\i\c*$	-	nomatch	1abc
^\i\c*$	-	nomatch	a b

# \s -- exactly [#x20 #x9 #xA #xD], four code points. The regex crate's
# own \s is the 26-member Unicode White_Space property.
^\s+$	-	match	 \t\n\r
^\s$	-	nomatch	\u00a0
^\s$	-	nomatch	\u3000
^\s$	-	nomatch	\u2028
^\s$	-	nomatch	\u000b

# \S -- the complement, so the too-wide code points DO match it.
^\S$	-	match	\u00a0
^\S$	-	match	\u3000
^\S$	-	match	a
^\S$	-	nomatch	 
^\S$	-	nomatch	\t

# \w -- [^\p{P}\p{Z}\p{C}]. Wider than Perl's \w in one direction
# (symbols are in) and narrower in another ('_' is punctuation, so out).
^\w$	-	match	a
^\w$	-	match	1
^\w$	-	match	+
^\w$	-	nomatch	_
^\w$	-	nomatch	 
^\w$	-	nomatch	.

# \W -- the complement.
^\W$	-	match	_
^\W$	-	match	.
^\W$	-	match	 
^\W$	-	nomatch	a
^\W$	-	nomatch	+

# \d -- \p{Nd}, every Unicode decimal digit. The one escape whose regex
# crate default already agrees, so this pins the agreement.
^\d+$	-	match	42
^\d$	-	match	\u0660
^\d$	-	nomatch	a
^\D$	-	match	a
^\D$	-	nomatch	7
^\D$	-	nomatch	\u0660

# Every multi-character escape composes inside a character class, where
# it means the same thing it does outside one.
^[\s\d]+$	-	match	1 2
^[\s\d]+$	-	nomatch	1a2
^[\s\d]$	-	nomatch	\u00a0
^[\i-]+$	-	match	a-b
^[^\d]+$	-	match	abc
^[^\d]+$	-	nomatch	ab1
