@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/ns#> .
@prefix sparql: <http://www.w3.org/ns/sparql#> .

ex:OffsetShape
    a sh:NodeShape ;
    sh:targetClass ex:C ;
    sh:expression [
        sh:if [ sparql:greater-than ( [ sh:count [ sh:path ex:p ; sh:offset 2 ] ] 0 ) ] ;
        sh:then true ;
        sh:else false
    ] .
