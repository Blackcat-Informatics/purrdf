@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix ex: <http://example.org/ns#> .

# SHACL 1.2 Node Expressions §4.1.6: `shnex:then` is taken only when the
# condition's output nodes are the list ( true ); every other output takes
# `shnex:else`, with no effective-boolean-value coercion.
ex:IfShape
    a sh:NodeShape ;
    sh:targetClass ex:C ;
    sh:expression [
        shnex:if [ shnex:pathValues ex:flag ] ;
        shnex:then true ;
        shnex:else false
    ] .
