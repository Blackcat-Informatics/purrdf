#
# The loading sibling of `../unmodelled-requirement/`: the same case, naming
# two modelled features (one of them twice), which load as a sorted set.
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .

<#manifest> a mf:Manifest ;
    mf:entries ( <#requiringEntry> ) .

<#requiringEntry> a mf:PositiveSyntaxTest ;
    mf:name "requiringEntry" ;
    mf:action <requiringEntry.rq> ;
    mf:requires mf:LangTagAwareness , mf:KnownTypesDefault2Neq .
