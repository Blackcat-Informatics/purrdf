#
# The group the index in `../manifest.ttl` lists. It is an ordinary group
# manifest, run as its own case.
@prefix : <manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .

<> a mf:Manifest ;
    mf:entries ( :group-case-01 ) .

:group-case-01 a mf:PositiveSyntaxTest ;
    mf:name "group-case-01" ;
    mf:action <group-case-01.rq> .
