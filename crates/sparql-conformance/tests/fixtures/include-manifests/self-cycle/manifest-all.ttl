#
# The simplest include cycle: a manifest that includes ITSELF. `manifest::load`
# must refuse it with a typed error naming the cycle, rather than recursing until
# the stack is gone or quietly stopping at the second visit (which would report
# success over a closure it never finished walking).
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .

<> a mf:Manifest ;
    mf:include ( <manifest-all.ttl> ) .
