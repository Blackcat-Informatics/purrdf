#
# A TRANSITIVE include cycle: this manifest includes `inner/manifest-inner.ttl`,
# which includes this one back. A visited-set check alone would stop here without
# saying why; the loader must name the whole chain so the offending edge is
# identifiable from the error text.
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .

<> a mf:Manifest ;
    mf:include ( <inner/manifest-inner.ttl> ) .
