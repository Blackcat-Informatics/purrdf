#
# A manifest named like a discovered one that includes a group AND declares
# entries of its own: both a group and an index. Refused, because running it as
# a group would run its member's cases a second time.
@prefix : <manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .

<> a mf:Manifest ;
    mf:entries ( :own-case-01 ) ;
    mf:include ( <group/manifest.ttl> ) .

:own-case-01 a mf:PositiveSyntaxTest ;
    mf:name "own-case-01" ;
    mf:action <own-case-01.rq> .
