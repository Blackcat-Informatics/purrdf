PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# PT15H is outside the +-PT14H domain fn:adjust-dateTime-to-timezone enforces,
# so ADJUST() is a SPARQL expression error here; BIND leaves ?adjusted
# unbound rather than failing the whole solution.
SELECT ?ok ?adjusted WHERE {
  BIND(1 AS ?ok)
  BIND(ADJUST("2024-06-15T10:00:00Z"^^xsd:dateTime, "PT15H"^^xsd:dayTimeDuration) AS ?adjusted)
}
