<?xml version="1.0"?>
<sparql xmlns="http://www.w3.org/2005/sparql-results#">
  <head>
    <variable name="s"/>
    <variable name="o"/>
    <variable name="label"/>
  </head>
  <results>
    <result>
      <binding name="s"><uri>https://example.org/lateral#a</uri></binding>
      <binding name="o"><uri>https://example.org/lateral#oa</uri></binding>
      <binding name="label"><literal>a1</literal></binding>
    </result>
    <result>
      <binding name="s"><uri>https://example.org/lateral#b</uri></binding>
      <binding name="o"><uri>https://example.org/lateral#ob</uri></binding>
      <binding name="label"><literal>b1</literal></binding>
    </result>
  </results>
</sparql>
