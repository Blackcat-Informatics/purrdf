+fn bottom_role_index(interner: &Interner, term: u32) -> Option<usize> {
+    let TermValue::Iri(iri) = interner.value(term) else {
+        return None;
+    };
+    match iri.as_str() {
+        OWL_BOTTOMOBJECTPROPERTY => Some(0),
+        OWL_BOTTOMDATAPROPERTY => Some(1),
+        _ => None,
+    }
