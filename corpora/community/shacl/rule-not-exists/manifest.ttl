@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
<> a mf:Manifest ; mf:entries ( <http://example.org/community/rule-not-exists> ) .
<http://example.org/community/rule-not-exists> a sht:Infer ; mf:name "rule-not-exists" ; mf:action [ sht:shapesGraph <shapes.ttl> ; sht:dataGraph <data.ttl> ] ; mf:result ( ( ex:b ex:missing true ) ( ex:c ex:missing true ) ) ; mf:status sht:proposed .
