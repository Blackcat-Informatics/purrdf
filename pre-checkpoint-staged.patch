+        );
+        let free = [None];
+        let mut cursor = relation.open(&PfArgs::new(&free, &free), None).unwrap();
+        assert_eq!(
+            cursor.generation(),
+            crate::IndexGeneration::declared(index.id().to_string())
+        );
+        assert!(cursor.take_work() > 0);
+        assert_eq!(cursor.take_work(), 0);
