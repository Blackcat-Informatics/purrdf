+fn sort_rationals<W: RelateWork>(values: &mut W::Array<Rat>, work: &mut W) -> Result<(), GeoError> {
+    purrdf_lex::walk::try_sort_unstable_by(values, |a, b| {
+        work.visit(1, None)?;
+        work.exact(ExactOperation::RationalCompare, &[a, b], 1, |values| {
+            values.compare(a, b)
+        })
+    })?;
+    let unique = purrdf_lex::walk::try_partition_unique_by(values, |a, b| {
+        work.exact(ExactOperation::RationalCompare, &[a, b], 1, |values| {
+            Ok(values.compare(a, b)?.is_eq())
+        })
+    })?;
+    work.truncate(values, unique);
+    Ok(())
+}
