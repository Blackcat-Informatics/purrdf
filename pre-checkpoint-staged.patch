+#[test]
+fn cut_band_metadata_borrows_original_wide_box_endpoints_without_allocating() {
+    let denominator = Int::one().shl(8192);
+    let fraction = Rat::new(Int::one(), denominator).expect("positive source denominator");
+    let area = ClosedBox::new(
+        Rat::from_i64(170).add(&fraction),
+        Rat::from_i64(-10),
+        Rat::from_i64(-170).sub(&fraction),
+        Rat::from_i64(10),
+    )
+    .expect("cut-crossing exact source");
+    let cut_west = Rat::from_i64(-180);
+    let cut_east = Rat::from_i64(180);
+    let window = purrdf_alloc_probe::CurrentThreadWindow::open();
+    let bands = area.intervals(&cut_west, &cut_east, true);
+    let measured = window.close();
+    assert_eq!(measured.allocations, 0);
+    assert_eq!(bands.len(), 2);
+    assert!(core::ptr::eq(bands[0].0, core::ptr::from_ref(&cut_west)));
+    assert!(core::ptr::eq(bands[0].1, core::ptr::from_ref(&area.east)));
+    assert!(core::ptr::eq(bands[1].0, core::ptr::from_ref(&area.west)));
+    assert!(core::ptr::eq(bands[1].1, core::ptr::from_ref(&cut_east)));
+    assert!(area.contains(&point(-180, 0)));
+    assert!(!area.contains(&point(0, 0)));
+}
