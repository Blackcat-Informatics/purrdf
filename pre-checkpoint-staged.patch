+struct GeometryArguments<'a, 'storage> {
+    vocab: &'a GeoVocab,
+    cached: &'a [(&'a TermValue, GeometryLiteral)],
+    storage: Option<&'a purrdf_geo_kernel::carrier::CarrierStorage<'storage>>,
