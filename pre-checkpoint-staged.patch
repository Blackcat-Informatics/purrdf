+/// Meter the shared pure kernel without exposing evaluator reentry.
+pub(crate) struct GeoWork<'a> {
+    context: &'a crate::user_fn::NativeFnContext<'a>,
+    storage: crate::workspace::LexicalFrame,
+}
+
+impl<'a> GeoWork<'a> {
+    pub(super) fn new(context: &'a crate::user_fn::NativeFnContext<'a>) -> Self {
+        Self {
+            context,
+            storage: crate::workspace::LexicalFrame::new(context.workspace()),
+        }
+    }
+}
+
+impl purrdf_geo_kernel::MetricWorkObserver for GeoWork<'_> {
+    fn retain_failure(&mut self, error: GeoError) -> GeoError {
+        let admitted = self.storage.admitted_bytes();
+        let replacement = crate::workspace::LexicalFrame::new(self.context.workspace());
+        let error = purrdf_geo_kernel::retain_failure_with_storage(
+            error,
+            &mut self.storage,
+            replacement,
+            admitted,
+        );
+        if let Some(first) = self.storage.take_failure() {
+            self.context.record_physical_failure(first);
+        }
+        if let GeoError::Storage(original) = &error {
+            self.context.record_physical_failure(
+                self.storage
+                    .storage_error(*original, "native geographic failure"),
+            );
+        }
+        // The original working payloads have died. Keep only an explicitly
+        // published cause; no failed source is charged for hypothetical reuse.
+        self.storage = crate::workspace::LexicalFrame::new(self.context.workspace());
+        error
+    }
+    fn native_storage(
+        &mut self,
+        producer: &mut dyn purrdf_geo_kernel::NativeStorageProducer,
+    ) -> Result<(), GeoError> {
+        let admitted = self.storage.admitted_bytes();
+        let mut work = Self::new(self.context);
+        producer.produce(
+            &mut purrdf_lex::allocation::Memory::resume(&mut self.storage, admitted),
+            &mut work,
+        )
+    }
+    fn retain_current(
+        &mut self,
+        control: core::alloc::Layout,
+    ) -> Result<(purrdf_lex::allocation::SharedOwned<()>, usize), GeoError> {
+        let admitted = self.storage.admitted_bytes();
+        let replacement = crate::workspace::LexicalFrame::new(self.context.workspace());
+        purrdf_lex::allocation::SharedOwned::retain_current(
+            &mut self.storage,
+            replacement,
+            admitted,
+            control,
+        )
+        .map_err(|error| {
+            self.context.record_physical_failure(
+                self.storage
+                    .storage_error(error, "retained geographic index"),
+            );
+            GeoError::Storage(error)
+        })
+    }
+    fn retained_owner_layout(&self) -> core::alloc::Layout {
+        purrdf_lex::allocation::SharedOwned::<()>::allocation_layout::<crate::workspace::LexicalFrame>(
+        )
+    }
+
+    fn retain_produced(
+        &mut self,
+        control: core::alloc::Layout,
+        producer: &mut dyn purrdf_geo_kernel::RetainedAllocationProducer,
+    ) -> Result<purrdf_lex::allocation::SharedOwned<()>, GeoError> {
+        purrdf_geo_kernel::retain_produced_with_storage(
+            control,
+            producer,
+            crate::workspace::LexicalFrame::new(self.context.workspace()),
+        )
+        .map_err(|failure| match failure {
+            purrdf_geo_kernel::RetainedProductionFailure::Published(error) => error,
+            purrdf_geo_kernel::RetainedProductionFailure::Unpublished {
+                error,
+                storage: mut original,
+            } => {
+                if let Some(first) = original.take_failure() {
+                    self.context.record_physical_failure(first);
+                } else if let GeoError::Storage(storage) = &error {
+                    self.context.record_physical_failure(
+                        original.storage_error(*storage, "retained geographic value"),
+                    );
+                }
+                error
+            }
+        })
+    }
+
+    fn allocation(&mut self) -> Option<(&mut dyn purrdf_lex::allocation::Admission, usize)> {
+        let admitted = self.storage.admitted_bytes();
+        Some((&mut self.storage, admitted))
+    }
+
+    fn retain_text(&mut self, text: &str) -> Result<purrdf_lex::allocation::SharedText, GeoError> {
+        self.context
+            .workspace()
+            .authored_text(&text)
+            .map_err(|error| {
+                self.context.record_physical_failure(error);
+                GeoError::Storage(purrdf_lex::allocation::StorageError::AdmissionFailed)
+            })
+    }
+
+    fn charge_chunk(&mut self, work_items: u64, workspace_growth: u64) -> Result<(), GeoError> {
+        self.context
+            .charge_work(work_items)
+            .map_err(|_| GeoError::Cancelled)?;
+        self.context
+            .charge_workspace_growth(workspace_growth)
+            .map_err(|_| GeoError::Cancelled)
+    }
+
+    fn integer_scratch_layout(&self, buffers: usize, limbs: usize) -> Result<usize, GeoError> {
+        purrdf_xsd::integer::LimbScratch::required_bytes_with_storage::<
+            crate::workspace::LexicalFrame,
+        >(buffers, limbs)
+        .map_err(|error| self.storage_failure(error, "geo integer arena"))
+    }
+
+    fn prepare_integer_scratch(
+        &mut self,
+        buffers: usize,
+        limbs: usize,
+    ) -> Result<purrdf_xsd::integer::LimbScratch, GeoError> {
+        let frame = crate::workspace::LexicalFrame::new(self.context.workspace());
+        purrdf_xsd::integer::LimbScratch::new_with_storage(buffers, limbs, frame).map_err(
+            |(error, mut frame)| {
+                self.context
+                    .record_physical_failure(frame.storage_error(error, "geo integer arena"));
+                GeoError::Storage(error)
+            },
+        )
+    }
+
+    fn binary64_layout(&self) -> usize {
+        purrdf_xsd::math::PreparedBinary64::required_bytes_with_storage::<
+            crate::workspace::LexicalFrame,
+        >()
+    }
+
+    fn prepare_binary64(
+        &mut self,
+        math: &mut purrdf_xsd::math::CoordinateMath,
+    ) -> Result<purrdf_xsd::math::PreparedBinary64, purrdf_xsd::math::MathError> {
+        let frame = crate::workspace::LexicalFrame::new(self.context.workspace());
+        math.prepare_binary64_with_storage(frame)
+            .map_err(|(error, mut frame)| {
+                if let purrdf_xsd::math::MathError::Storage(storage_error) = &error {
+                    self.context.record_physical_failure(
+                        frame.storage_error(*storage_error, "geo binary64 coefficients"),
+                    );
+                }
+                error
+            })
+    }
+
+    fn taylor_scratch_layout(&self, coefficients: usize, jets: usize) -> Result<usize, GeoError> {
+        purrdf_xsd::math::TaylorScratch::required_bytes_with_storage::<crate::workspace::LexicalFrame>(coefficients, jets)
+            .ok_or_else(|| self.storage_failure(purrdf_lex::allocation::StorageError::SizeOverflow, "geo Taylor arena"))
+    }
+
+    fn prepare_taylor_scratch(
+        &mut self,
+        coefficients: usize,
+        jets: usize,
+        zero: purrdf_xsd::math::FixedInterval,
+    ) -> Result<purrdf_xsd::math::TaylorScratch, GeoError> {
+        let frame = crate::workspace::LexicalFrame::new(self.context.workspace());
+        purrdf_xsd::math::TaylorScratch::new_with_storage(coefficients, jets, zero, frame).map_err(
+            |(error, mut frame)| match error {
+                purrdf_xsd::math::TaylorScratchError::Storage(error) => {
+                    self.context
+                        .record_physical_failure(frame.storage_error(error, "geo Taylor arena"));
+                    GeoError::Storage(error)
+                }
+                error => GeoError::NumericalTaylorScratch(error),
+            },
+        )
+    }
+}
+
+impl GeoWork<'_> {
+    fn storage_failure(
+        &self,
+        error: purrdf_lex::allocation::StorageError,
+        construct: &'static str,
+    ) -> GeoError {
+        let mut frame = crate::workspace::LexicalFrame::new(self.context.workspace());
+        self.context
+            .record_physical_failure(frame.storage_error(error, construct));
+        GeoError::Storage(error)
+    }
+}
