+pub struct NativeFnContext<'a> {
+    charge: &'a dyn Fn(NativeCharge) -> Result<(), purrdf_core::TrippedGovernor>,
+    stopped: core::cell::Cell<Option<purrdf_core::TrippedGovernor>>,
