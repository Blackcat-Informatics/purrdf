+#[derive(Clone, Copy)]
+enum ObserverArithmetic {
+    Floating,
+    Integer,
+}
+impl ObserverArithmetic {
+    fn validate(self) -> Result<(), GeoError> {
+        match self {
+            Self::Floating => validate_environment(),
+            Self::Integer => Ok(()),
+        }
