+#[derive(Clone, Copy)]
+struct DiskRequest<'call, 'source> {
+    centers: &'call [Cow<'source, LonLat>],
+    radius: &'call Rat,
+    prepared: &'call PreparedGeodesic,
+    profile: &'call GeoProfile,
+    target: &'call Crs,
+    global_band: &'call Rat,
