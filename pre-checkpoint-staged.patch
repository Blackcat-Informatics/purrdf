+                let footprint = Footprint::new(cell).expect("chart");
+                assert!(footprint.radius > Rat::zero());
+                let guard = Rat::new(Int::one(), Int::one().shl(59)).expect("positive guard");
+                assert!(footprint.radius <= Rat::from_i64(2).add(&guard));
+            }
+        }
+    }
+}
