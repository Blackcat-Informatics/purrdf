+    }
+    let derivation = match function {
+        GeofFunction::Envelope => Some(construct::Derivation::Envelope),
+        GeofFunction::Boundary => Some(construct::Derivation::Boundary),
+        GeofFunction::ConvexHull => Some(construct::Derivation::ConvexHull),
+        GeofFunction::Centroid => Some(construct::Derivation::Centroid),
+        _ => None,
+    };
