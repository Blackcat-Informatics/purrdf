+            })?;
+            let padding = budget.expression_result(
+                ExactOperation::RationalAdd,
+                &[&quantum, &half_ulp],
+                1,
+                |values| Ok(values.add(&quantum, &half_ulp)?),
+            )?;
+            let radius = budget.expression_result(
+                ExactOperation::RationalAdd,
+                &[&exact, &padding],
+                1,
+                |values| Ok(Metres::new(values.add(&exact, &padding)?)),
