+    fn compile_binding(
+        source: OperationReference,
+        target: OperationReference,
+        model: &OperationModel,
+        values: &crate::numerical::ExactValues<'_>,
+        progress: &mut WorkProgress<'_>,
+    ) -> Result<OperationCompilation, GeoError> {
+        model.validate_with(values, progress)?;
+        let (input, output) = model.units();
+        if source.unit != input || target.unit != output {
+            return Err(progress.retained_message(
+                "operation units disagree with model input/output units",
+                GeoError::Config,
+            ));
+        }
+        let law = SemanticLawId::from_digest(hash_fields(OPERATION_LAW, [model.descriptor()]));
+        let mut identity = purrdf_hash::blake3::Hasher::new();
+        identity.update(OPERATION_BINDING.as_bytes());
+        let law_digest = law.digest();
+        let axes = [u8::from(source.swapped_axes), u8::from(target.swapped_axes)];
+        for field in [
+            law_digest.as_bytes().as_slice(),
+            source.realization.as_bytes().as_slice(),
+            target.realization.as_bytes().as_slice(),
+            &axes,
+        ] {
+            purrdf_hash::frame::frame_le_into(&mut identity, field);
+        }
+        // Both directions share the original complete parameter preimage,
+        // rendered once under compilation admission. Panel consumers compare
+        // this fixed-width fingerprint instead of deeply comparing rational
+        // axes, origins and projection parameters on every evaluation.
+        let mut transverse = matches!(
+            model,
+            OperationModel::TransverseMercator(_) | OperationModel::TransverseMercatorInverse(_)
+        )
+        .then(|| {
+            let mut hash = purrdf_hash::blake3::Hasher::new();
+            hash.update(TRANSVERSE_PARAMETER.as_bytes());
+            hash
+        });
+        model.parameters(&mut ParameterHash {
+            identity: &mut identity,
+            transverse: transverse.as_mut(),
+            values,
+        })?;
+        let transverse_parameter_id =
+            transverse.map(|hash| Digest32::new(*hash.finalize().as_bytes()));
+        let id = Digest32::new(*identity.finalize().as_bytes());
+        let mut maximum_original_operand_bits = 0;
+        model.visit_original_operands(&mut |value| {
+            maximum_original_operand_bits =
+                maximum_original_operand_bits.max(crate::numerical::rational_operand_bits(value));
+        });
+        Ok(OperationCompilation {
+            transverse_parameter_id,
+            id,
+            law,
+            maximum_original_operand_bits,
+        })
+    }
