+                    .to_string(),
+                "FF10F0FF2"
+            );
+            assert_eq!(
+                relate(&origin, &folded, &mut context).unwrap().to_string(),
+                "F0FFFF102"
+            );
+            assert_eq!(folded.id(), id);
+        }
