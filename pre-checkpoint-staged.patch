+        ] {
+            let point = source(text);
+            let forward = relate(&point, &region, &mut context).unwrap();
+            assert_eq!(forward.to_string(), expected);
+            let reverse = relate(&region, &point, &mut context).unwrap();
+            for first in Set::ALL {
