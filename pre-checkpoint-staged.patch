+        let left = polygon_geometry(ring.clone(), OrientedInterior::Left, &mut context);
+        let right = polygon_geometry(ring, OrientedInterior::Right, &mut context);
+        let tangent = LonLat::new(Rat::zero(), Rat::zero()).unwrap();
+        assert_eq!(
