+        if let TermValue::Literal { datatype, .. } = argument
+            && matches!(
+                vocab.term_of(datatype),
+                Some(GeoTerm::WktLiteral | GeoTerm::GeoJsonLiteral)
+            )
+        {
+            let source = match storage {
+                Some(storage) => purrdf_geo_kernel::carrier::geometry_arg_with_storage(
+                    vocab,
+                    argument,
+                    budget.remaining()?,
+                    observer,
+                    storage,
+                ),
+                None => purrdf_geo_kernel::carrier::geometry_arg_metered(
+                    vocab,
+                    argument,
+                    budget.remaining()?,
+                    observer,
+                ),
+            }?;
+            budget.retain(
+                source.receipt().work_items(),
+                source.receipt().workspace_bytes(),
+            )?;
+            parsed.push((argument, source.into_literal()));
+        } else {
+            let source = match storage {
+                Some(storage) => purrdf_geo_kernel::carrier::term_source_with_storage(
+                    argument,
+                    budget.remaining()?,
+                    observer,
+                    storage,
+                ),
+                None => purrdf_geo_kernel::carrier::term_source_metered(
+                    argument,
+                    budget.remaining()?,
+                    observer,
+                ),
+            }?;
+            budget.retain(source.work_items(), source.workspace_bytes())?;
+        }
+    }
