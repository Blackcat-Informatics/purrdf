+impl IntegralCoefficients<FixedInterval> {
+    fn new(
+        c: &FixedInterval,
+        order: usize,
+        chunks: &mut ChunkObserver<'_, '_>,
+        math: &mut CoordinateMath,
+    ) -> Result<Self, SolveError> {
