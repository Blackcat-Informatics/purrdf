+    ///
+    /// # Errors
+    /// Preserves invalid extents, cancellation, work and physical refusal.
+    pub fn new_in_budget_metered(
+        west: Rat,
+        east: Rat,
+        south: Rat,
+        north: Rat,
+        budget: &mut crate::PreparationBudget,
