+/// Worker precision-specific line scratch; no floating guard or callback is retained.
+#[derive(Clone, Debug)]
+pub(crate) struct FixedArcLine {
+    binding_id: crate::GeoBindingId,
+    start: LonLat,
+    end: Option<LonLat>,
+    azimuth: FixedInterval,
+    exact_azimuth: Option<Rat>,
