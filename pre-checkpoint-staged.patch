+        let mut context = MetricContext::wgs84().unwrap();
+        let index = Arc::new(
+            super::GeographicGeoIndex::prepare(source, &profile, crs(ogc::CRS84), &mut context)
+                .unwrap(),
+        );
+        let relation = GeoRelation::new_geographic(
