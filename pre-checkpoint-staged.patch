+        assert!(OrientedRing::new(linear_ring(&[(0, 0), (10, 0)]), &mut context).is_err());
+        assert!(OrientedRing::new(linear_ring(&[(0, 90), (50, 90)]), &mut context).is_err());
+    }
+}
