+        use crate::operation::{Hemisphere, TransverseMercator, ZoneFamily};
+        use crate::{AxisOrder, PreparedCurve, PreparedEdge, PreparedGeometry, PreparedRegion};
+        for axes in [AxisOrder::LonLat, AxisOrder::LatLon] {
