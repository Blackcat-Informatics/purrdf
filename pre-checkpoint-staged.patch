+fn region(text: &str) -> PreparedRegion {
+    let literal = crate::wkt::parse(text, &Crs::new(ogc::CRS84).expect("IRI")).expect("carrier");
+    PreparedGeometry::from_literal(&literal, &GeoProfile::standard())
+        .expect("prepared")
