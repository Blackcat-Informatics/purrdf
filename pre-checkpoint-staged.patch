+fn compute_carrier(
+    function: GeofFunction,
+    vocab: &GeoVocab,
+    args: &[&TermValue],
+) -> Result<TermValue, GeoError> {
+    // Wrong arity is fatal for every solution, including direct typed callers.
+    function.check_argument_count(args.len())?;
+    dispatch(
+        function,
+        vocab,
+        args,
+        &GeometryArguments {
+            vocab,
+            cached: &[],
+            storage: None,
+        },
+        None,
+    )
+}
