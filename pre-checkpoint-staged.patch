+impl GeometryArguments<'_, '_> {
+    fn get(&self, value: &TermValue) -> Result<std::borrow::Cow<'_, GeometryLiteral>, GeoError> {
+        if let Some((_, literal)) = self
+            .cached
+            .iter()
+            .find(|(source, _)| core::ptr::eq(*source, value))
