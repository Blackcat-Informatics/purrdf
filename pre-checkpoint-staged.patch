+/// Source-defined selected geodesic with unrounded branch proof.
+#[derive(Clone, Debug)]
+pub struct ArcIntervalView {
+    prepared: PreparedGeodesic,
+    start: LonLat,
+    end: Option<LonLat>,
+    azimuth: (Rat, Rat),
+    exact_azimuth: Option<Rat>,
+    length: (Metres, Metres),
+    proof_bits: u32,
+}
+
+crate::context::retained::native_detached_fields!(ArcIntervalView {
+    native: [prepared, start, end, azimuth, exact_azimuth, length],
+    copy: [proof_bits]
+});
+
+/// Borrowed original view fields. Their native factory is shared by resident
+/// preparation and bounded proof preparation; no owned clone precedes it.
+#[derive(Clone, Copy)]
+struct ViewFields<'a> {
+    start: &'a LonLat,
+    end: Option<&'a LonLat>,
+    azimuth: (&'a Rat, &'a Rat),
+    exact_azimuth: Option<&'a Rat>,
+    length: (&'a Metres, &'a Metres),
+    proof_bits: u32,
+}
+
+impl ViewFields<'_> {
+    fn layout_bytes(&self, prepared: &PreparedGeodesic) -> Result<usize, GeoError> {
+        let fields = [
+            prepared.layout_bytes(),
+            self.start.layout_bytes(),
+            self.end.map_or(Ok(0), NativeDetached::layout_bytes),
+            self.azimuth.0.layout_bytes(),
+            self.azimuth.1.layout_bytes(),
+            self.exact_azimuth
+                .map_or(Ok(0), NativeDetached::layout_bytes),
+            self.length.0.layout_bytes(),
+            self.length.1.layout_bytes(),
+        ];
+        fields.into_iter().try_fold(0_usize, |bytes, field| {
+            bytes
+                .checked_add(field.map_err(GeoError::Storage)?)
+                .ok_or(GeoError::Storage(
+                    purrdf_lex::allocation::StorageError::SizeOverflow,
+                ))
+        })
+    }
+
+    fn construct(
+        self,
+        prepared: &PreparedGeodesic,
+        memory: &mut purrdf_lex::allocation::Memory<'_, dyn purrdf_lex::allocation::Admission + '_>,
+    ) -> Result<ArcIntervalView, GeoError> {
+        let copy = (|| {
+            Ok::<_, purrdf_lex::allocation::StorageError>(ArcIntervalView {
+                prepared: prepared.prepare(memory)?,
+                start: self.start.prepare(memory)?,
+                end: self.end.map(|end| end.prepare(memory)).transpose()?,
+                azimuth: (
+                    self.azimuth.0.prepare(memory)?,
+                    self.azimuth.1.prepare(memory)?,
+                ),
+                exact_azimuth: self
+                    .exact_azimuth
+                    .map(|value| value.prepare(memory))
+                    .transpose()?,
+                length: (
+                    self.length.0.prepare(memory)?,
+                    self.length.1.prepare(memory)?,
+                ),
+                proof_bits: self.proof_bits,
+            })
+        })();
+        copy.map_err(GeoError::Storage)
+    }
+
+    fn admitted(
+        self,
+        prepared: &PreparedGeodesic,
+        context: &mut MetricContext,
+        progress: &mut WorkProgress<'_>,
+    ) -> Result<ArcIntervalView, GeoError> {
+        let bytes = self.layout_bytes(prepared)?;
+        let cost = crate::numerical::rational_copy_cost(
+            [
+                self.start.longitude(),
+                self.start.latitude(),
+                self.azimuth.0,
+                self.azimuth.1,
+                self.length.0.exact(),
+                self.length.1.exact(),
+            ]
+            .into_iter()
+            .chain(
+                self.end
+                    .into_iter()
+                    .flat_map(|end| [end.longitude(), end.latitude()]),
+            )
+            .chain(self.exact_azimuth),
+        )
+        .ok_or(GeoError::ArithmeticOverflow("original arc view copy work"))?;
+        progress.exact_with(context, cost, |context, progress| {
+            context.with_metadata(progress, |context, progress, retained| {
+                crate::context::retained::persistent_numeric_fields(
+                    bytes,
+                    context,
+                    progress,
+                    retained,
+                    |memory| self.construct(prepared, memory),
+                )
+            })
+        })
+    }
+}
