+    /// Obtain the original policy receipt before dropping all result clones.
+    /// Release it through the producing context after those payloads die.
+    #[must_use]
+    pub fn output_receipt(&self) -> MaterializedOutputReceipt {
+        self.receipt.clone()
+    }
+}
