+    );
+    let request = GeoRequest::CellScale {
+        grid: NativeGridProfile::Wgs84,
+        level: 16,
+        maximum_edge: Some(purrdf_geo_kernel::Metres::new(Rat::from_i64(150))),
+    };
+    for (limits, work_failure) in [
+        (
+            ExecutionLimits {
+                max_work_items: 1,
+                ..ExecutionLimits::GEOMETRY
+            },
