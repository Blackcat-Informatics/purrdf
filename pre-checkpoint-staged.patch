+
+    /// Derive the explicitly declared inverse within cumulative configuration
+    /// admission, before cloning original parameter bundles or grids.
+    /// # Errors
+    /// Refuses unsupported inverse domains and exact work/storage exhaustion.
+    pub fn inverse_in_budget(
+        &self,
+        budget: &mut crate::PreparationBudget,
+    ) -> Result<Self, GeoError> {
+        self.inverse_in_budget_observed(budget, None)
+    }
+
+    /// Derive the same explicit inverse inside the original native model
+    /// factory. Boxed parameter bundles and every detached scalar retain that
+    /// account, without an intermediate resident model or a second copy.
+    ///
+    /// # Errors
+    /// Preserves inverse-domain, native work, cancellation and physical refusal.
+    pub fn inverse_in_budget_metered(
+        &self,
+        budget: &mut crate::PreparationBudget,
+        observer: &mut dyn MetricWorkObserver,
+    ) -> Result<Self, GeoError> {
+        self.inverse_in_budget_observed(budget, Some(observer))
+    }
+
+    fn inverse_in_budget_observed(
+        &self,
+        budget: &mut crate::PreparationBudget,
+        observer: Option<&mut dyn MetricWorkObserver>,
+    ) -> Result<Self, GeoError> {
+        use purrdf_xsd::integer::{ExactArithmeticCost, ExactOperation};
+        let (mut cost, mut destination_bits) = self.model.admit_compile(budget)?;
+        let mut extra = ExactArithmeticCost::for_operation(ExactOperation::Linear, 1, 0)
+            .ok_or(GeoError::ArithmeticOverflow("inverse parameter work"))?;
+        if matches!(self.model(), OperationModel::BaiduMercatorAnalyticV1) {
+            let constants = baidu_mercator_parameters_cost()
+                .ok_or(GeoError::ArithmeticOverflow("analytic inverse constants"))?;
+            let bits = constants.output_bits;
+            extra = constants
+                .followed_by(
+                    ExactArithmeticCost::for_operation(ExactOperation::DecimalRender, bits, 4)
+                        .ok_or(GeoError::ArithmeticOverflow("analytic inverse rendering"))?,
+                )
+                .and_then(|cost| {
+                    cost.followed_by(ExactArithmeticCost::for_operation(
+                        ExactOperation::RationalCompare,
+                        bits,
+                        3,
+                    )?)
+                })
+                .ok_or(GeoError::ArithmeticOverflow("analytic inverse constants"))?;
+            let bytes = bits
+                .div_ceil(3)
+                .checked_add(2)
+                .and_then(|bytes| bytes.checked_add(8))
+                .and_then(|bytes| bytes.checked_mul(4))
+                .and_then(|bytes| bytes.checked_mul(8))
+                .ok_or(GeoError::ArithmeticOverflow("analytic inverse framing"))?;
+            let hashing = ExactArithmeticCost::for_operation(ExactOperation::Linear, bytes, 8)
+                .ok_or(GeoError::ArithmeticOverflow("analytic inverse hashing"))?;
+            destination_bits = destination_bits.max(extra.output_bits);
+            extra = extra
+                .followed_by(hashing)
+                .ok_or(GeoError::ArithmeticOverflow("analytic inverse hashing"))?;
+        } else if matches!(self.model(), OperationModel::WebMercator { .. }) {
+            // The inverse adds canonical zero eccentricity and the one original
+            // square-domain field; the source radius already has its quotation.
+            extra = ExactArithmeticCost::for_operation(ExactOperation::DecimalRender, 1, 2)
+                .and_then(|cost| {
+                    cost.followed_by(ExactArithmeticCost::for_operation(
+                        ExactOperation::RationalCompare,
+                        1,
+                        2,
+                    )?)
+                })
+                .ok_or(GeoError::ArithmeticOverflow("inverse zero eccentricity"))?;
+            destination_bits = destination_bits.max(extra.output_bits);
+            extra = extra
+                .followed_by(
+                    ExactArithmeticCost::for_operation(
+                        ExactOperation::Linear,
+                        (2 * (1 + 8) + 1 + 8) * 8,
+                        8,
+                    )
+                    .ok_or(GeoError::ArithmeticOverflow(
+                        "inverse square-domain framing",
+                    ))?,
+                )
+                .ok_or(GeoError::ArithmeticOverflow(
+                    "inverse square-domain framing",
+                ))?;
+        } else if matches!(self.model(), OperationModel::EllipsoidalMercator { .. }) {
+            extra = ExactArithmeticCost::for_operation(ExactOperation::Linear, 9 * 8, 8)
+                .ok_or(GeoError::ArithmeticOverflow("inverse domain framing"))?;
+        }
+        cost = cost
+            .followed_by(extra)
+            .ok_or(GeoError::ArithmeticOverflow("inverse compilation work"))?;
+        let owner = observer.as_ref().map_or_else(
+            || WorkProgress::integer(None).retained_owner_layout(),
+            MetricWorkObserver::retained_owner_layout,
+        );
+        let control = crate::PreparedValue::<OperationModel>::allocation_layout()
+            .size()
+            .checked_add(owner.size())
+            .and_then(|bytes| u64::try_from(bytes).ok())
+            .ok_or(GeoError::Storage(
+                purrdf_lex::allocation::StorageError::SizeOverflow,
+            ))?;
+        cost.workspace_bytes =
+            cost.workspace_bytes
+                .checked_add(control)
+                .ok_or(GeoError::Storage(
+                    purrdf_lex::allocation::StorageError::SizeOverflow,
+                ))?;
+        budget.exact_values_with_bits_observed(
+            cost,
+            destination_bits,
+            |values, progress| {
+                let model = crate::PreparedValue::produce(
+                    progress,
+                    |memory| self.inverse_model_with_memory(values, memory),
+                    |model, original| model.publish(original).map_err(GeoError::Storage),
+                )?;
+                let compilation =
+                    Self::compile_binding(self.target, self.source, &model, values, progress)?;
+                Ok(compilation.finish(self.target, self.source, model))
+            },
+            observer,
+        )
+    }
+
+    fn inverse_model_with_memory(
+        &self,
+        values: &crate::numerical::ExactValues<'_>,
+        memory: &mut purrdf_lex::allocation::Memory<'_, dyn purrdf_lex::allocation::Admission + '_>,
+    ) -> Result<OperationModel, GeoError> {
+        let model = match self.model() {
+            OperationModel::Bd09LlV1 => OperationModel::Bd09LlInverseV1,
+            OperationModel::Bd09LlInverseV1 => OperationModel::Bd09LlV1,
+            OperationModel::GcjRationalHarmonicV1(domain) => {
+                OperationModel::GcjRationalHarmonicInverseV1(
+                    domain.prepare(memory).map_err(GeoError::Storage)?,
+                )
+            }
+            OperationModel::GcjRationalHarmonicInverseV1(domain) => {
+                OperationModel::GcjRationalHarmonicV1(
+                    domain.prepare(memory).map_err(GeoError::Storage)?,
+                )
+            }
+            OperationModel::BaiduMercatorAnalyticV1 => {
+                let (radius, eccentricity_squared) = baidu_mercator_parameters_with(values)?;
+                OperationModel::MercatorToGeographic {
+                    eccentricity_squared: eccentricity_squared
+                        .prepare(memory)
+                        .map_err(GeoError::Storage)?,
+                    radius: radius.prepare(memory).map_err(GeoError::Storage)?,
+                    square_domain: false,
+                }
+            }
+            OperationModel::WebMercator { radius } => OperationModel::MercatorToGeographic {
+                radius: radius.prepare(memory).map_err(GeoError::Storage)?,
+                eccentricity_squared: Rat::zero(),
+                square_domain: true,
+            },
+            OperationModel::EllipsoidalMercator {
+                semimajor,
+                eccentricity_squared,
+            } => OperationModel::MercatorToGeographic {
+                radius: semimajor.prepare(memory).map_err(GeoError::Storage)?,
+                eccentricity_squared: eccentricity_squared
+                    .prepare(memory)
+                    .map_err(GeoError::Storage)?,
+                square_domain: false,
+            },
+            OperationModel::MercatorToGeographic {
+                radius,
+                eccentricity_squared,
+                square_domain,
+            } => {
+                if *square_domain && eccentricity_squared.is_zero() {
+                    OperationModel::WebMercator {
+                        radius: radius.prepare(memory).map_err(GeoError::Storage)?,
+                    }
+                } else {
+                    OperationModel::EllipsoidalMercator {
+                        semimajor: radius.prepare(memory).map_err(GeoError::Storage)?,
+                        eccentricity_squared: eccentricity_squared
+                            .prepare(memory)
+                            .map_err(GeoError::Storage)?,
+                    }
+                }
+            }
+            OperationModel::GeographicToGeocentric { ellipsoid } => {
+                OperationModel::GeocentricToGeographic {
+                    ellipsoid: ellipsoid.prepare(memory).map_err(GeoError::Storage)?,
+                }
+            }
+            OperationModel::GeocentricToGeographic { ellipsoid } => {
+                OperationModel::GeographicToGeocentric {
+                    ellipsoid: ellipsoid.prepare(memory).map_err(GeoError::Storage)?,
+                }
+            }
+            OperationModel::TransverseMercator(parameters) => {
+                OperationModel::TransverseMercatorInverse(
+                    parameters.prepare(memory).map_err(GeoError::Storage)?,
+                )
+            }
+            OperationModel::TransverseMercatorInverse(parameters) => {
+                OperationModel::TransverseMercator(
+                    parameters.prepare(memory).map_err(GeoError::Storage)?,
+                )
+            }
+            OperationModel::Helmert(parameters) => {
+                let mut parameters = parameters.prepare(memory).map_err(GeoError::Storage)?;
+                parameters.inverse = !parameters.inverse;
+                OperationModel::Helmert(parameters)
+            }
+            OperationModel::Similarity2d(parameters) => {
+                let mut parameters = parameters.prepare(memory).map_err(GeoError::Storage)?;
+                parameters.inverse = !parameters.inverse;
+                OperationModel::Similarity2d(parameters)
+            }
+            _ => {
+                return Err(GeoError::Config(
+                    memory
+                        .string("model requires an explicitly certified inverse domain")
+                        .map_err(GeoError::Storage)?,
+                ));
+            }
+        };
+        Ok(model)
+    }
+
+    fn apply_inner(
+        &self,
+        point: &OperationPoint,
+        grid: TransformOutputGrid,
+        context: &mut MetricContext,
+        progress: &mut WorkProgress<'_>,
+    ) -> Result<TransformResult, GeoError> {
+        let input = prepare_source_point(
+            &self.model,
+            [&point.x, &point.y],
+            point.z.as_ref(),
+            point.epoch.as_ref(),
+            self.source.swapped_axes,
+            context,
+            progress,
+        )?;
+        with_application_source(&input, context, progress, |input, context, progress| {
+            grid.validate(self.target.unit, point.z.is_some(), context, progress)?;
+            let limits = *context.policy().limits();
+            let solver_limits = OperationSolverLimits {
+                iterations: limits.max_iterations,
+                subdivisions: limits.max_subdivision_levels,
+                quantize_inverse: grid == TransformOutputGrid::DEFAULT,
+            };
+            complete_transform(
+                TransformTarget {
+                    reference: self.target,
+                    operation: self.id,
+                    law: self.law,
+                    grid,
+                    original_operand_bits: point_operand_bits(input)
+                        .max(self.maximum_original_operand_bits),
+                    exact_output: None,
+                },
+                point.epoch.as_ref(),
+                context,
+                progress,
+                |math, progress| self.model.evaluate(input, solver_limits, math, progress),
+                |certification_input, values, math, progress| {
+                    self.model
+                        .certify_quantized_fixed(certification_input, values, math, progress)
+                },
+            )
+        })
+    }
+}
