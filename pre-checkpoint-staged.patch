+        let tolerance = Rat::parse_decimal("0.1").unwrap();
+        assert!(left_area.exact().sub(&cap).abs() < tolerance);
+        assert!(left_area.exact().add(right_area.exact()).sub(&whole).abs() < tolerance);
+        assert!(right_area.exact() > left_area.exact());
