+        function,
+        GeofFunction::Area
+            | GeofFunction::MetricArea
+            | GeofFunction::Length
+            | GeofFunction::MetricLength
+            | GeofFunction::Perimeter
+            | GeofFunction::MetricPerimeter
+    ) {
