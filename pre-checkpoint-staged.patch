+    fn cover_box(
+        self,
+        area: &ClosedBox,
+        levels: CoverLevels,
+        limits: MixedCoverLimits,
+        observer: Option<&mut dyn MetricWorkObserver>,
+    ) -> Result<CellCover, GeoError> {
+        let mut budget = CoverBudget::new_metered(limits, observer)?;
+        let operands = [&area.west, &area.south, &area.east, &area.north];
+        let cut_west = Rat::from_i64(-180);
+        let cut_east = Rat::from_i64(180);
+        let (full_longitude, seam, full_latitude, wraps) =
+            budget.expression_result(ExactOperation::RationalCompare, &operands, 14, |values| {
+                let wraps = values.compare(&area.west, &area.east)?.is_gt();
+                let full_longitude = area.west == cut_west && area.east == cut_east;
+                let contains = |value: &Rat| {
+                    let after_west = values.compare(value, &area.west)?.is_ge();
+                    let before_east = values.compare(value, &area.east)?.is_le();
+                    Ok::<_, purrdf_xsd::integer::LimbScratchError>(if wraps {
+                        after_west || before_east
+                    } else {
+                        after_west && before_east
+                    })
+                };
+                let seam = full_longitude || contains(&cut_west)? || contains(&cut_east)?;
+                Ok((
+                    full_longitude,
+                    seam,
+                    area.south == Rat::from_i64(-90) && area.north == Rat::from_i64(90),
+                    wraps,
+                ))
+            })?;
+        if full_longitude && full_latitude {
+            // The exact closed whole-surface box proves every footprint inside.
+            // Traversal still obeys the same minimum level, canonicalization,
+            // logical output/work/memory limits and governor law.
+            return build(self, levels, limits, &mut budget, |_, _| {
+                Ok(Classification::Inside)
+            });
+        }
+        let target = area.intervals(&cut_west, &cut_east, wraps);
+        build(self, levels, limits, &mut budget, |cell, budget| {
+            classify_box(
+                area,
+                &target,
+                full_longitude,
+                seam,
+                &Footprint::new_admitted(cell, budget)?,
+                budget,
+            )
+        })
+    }
