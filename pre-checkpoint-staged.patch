+        let a = crate::wkt::parse("GEOMETRYCOLLECTION (POLYGON ((0 0,4 0,4 4,0 4,0 0),(1 1,3 1,3 3,1 3,1 1)),LINESTRING (0 2,4 2))", &crs).unwrap();
+        let b = crate::wkt::parse("POLYGON ((2 -1,5 -1,5 5,2 5,2 -1))", &crs).unwrap();
