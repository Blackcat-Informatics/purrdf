+    /// A point that is collinear with a segment but beyond its end is NOT on it;
+    /// the neighbouring point that is within the span is.
+    #[test]
+    fn on_segment_is_collinearity_and_containment_not_collinearity_alone() {
+        let a = c(0, 0);
