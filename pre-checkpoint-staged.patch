+pub(crate) fn evaluate_standard(
+    function: GeofFunction,
+    call: &crate::user_fn::NativeFnCall<'_>,
+) -> Result<Option<crate::WorkspaceTerm>, EvalError> {
+    // Original source containers die inside the computation scope, before this
+    // frame can release their account. Numerical values keep intrinsic owners;
+    // emitted text uses the observer's separate original publication frame.
+    let mut source_frame = crate::workspace::LexicalFrame::new(call.workspace);
+    let mut observer = GeoWork::new(call.context);
+    let result = {
+        let storage = purrdf_geo_kernel::carrier::CarrierStorage::new(&mut source_frame);
+        compute_standard_in_storage(
+            function,
+            call.geo,
+            call.args,
+            &mut observer,
+            purrdf_geo_kernel::PreparationBudget::new(call.geo.policy()),
+            Some(&storage),
+        )
+    };
+    if let Some(original) = source_frame
+        .take_failure()
+        .or_else(|| observer.storage.take_failure())
+    {
+        return Err(original);
+    }
+    match result {
+        Ok(value) => observer.storage.finish_term(|| value).map(Some),
+        Err(error) if error.is_expression_error() => Ok(None),
+        Err(error) => Err(super::error::native_error(&error, call.workspace)),
+    }
+}
