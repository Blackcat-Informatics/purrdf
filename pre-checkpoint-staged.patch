+            (-4, 4),
+            (0, 0),
+            (8, 0),
+            (8, 8),
+            (0, 8),
+            (-2, -2),
+            (2, 2),
+            (6, 6),
+            (-90, -45),
+            (90, 45),
+            (180, 90),
