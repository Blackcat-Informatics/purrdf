+    pub(super) fn validate_fields(
+        west: &Rat,
+        east: &Rat,
+        south: &Rat,
+        north: &Rat,
+        values: &crate::numerical::ExactValues<'_>,
+        progress: &mut WorkProgress<'_>,
+    ) -> Result<(), GeoError> {
+        if !values
+            .compare(west, east)
+            .map_err(GeoError::NumericalScratch)?
+            .is_lt()
+            || !values
+                .compare(south, north)
+                .map_err(GeoError::NumericalScratch)?
+                .is_lt()
+        {
+            return Err(progress.retained_message(
+                "operation applicability must have positive extents",
+                GeoError::Config,
+            ));
+        }
+        Ok(())
+    }
+
+    /// Whether an exact source point is in the declared closed applicability.
+    #[must_use]
+    pub fn contains(&self, x: &Rat, y: &Rat) -> bool {
+        x >= &self.west && x <= &self.east && y >= &self.south && y <= &self.north
+    }
+}
