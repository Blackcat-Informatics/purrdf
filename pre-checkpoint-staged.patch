+        .unwrap();
+        let mixed = crate::ellipsoidal::length(&mixed, &mut context).unwrap();
+        let standalone = crate::ellipsoidal::length(&standalone, &mut context).unwrap();
+        assert_eq!(
+            standalone.exact(),
+            &Rat::parse_decimal("221893.879351").unwrap()
+        );
