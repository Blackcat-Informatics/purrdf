+    let record = response(
+        &session,
+        r#"{"version":1,"operation":"cell-scale","grid":"wgs84","level":16,"maximum_edge_metres":"0.0000000001"}"#,
+    );
+    assert_eq!(record["error"]["code"], "unattainable-edge-length");
+    assert_eq!(record["error"]["target_metres"], "0.0000000001");
