+#[derive(Default)]
+struct ArcReceipt {
+    work: u64,
+    peak: u64,
+}
+impl MetricWorkObserver for ArcReceipt {
+    fn charge_chunk(&mut self, work: u64, growth: u64) -> Result<(), GeoError> {
+        self.work = self.work.checked_add(work).unwrap();
+        self.peak = self.peak.checked_add(growth).unwrap();
+        Ok(())
+    }
+}
