+        GeofFunction::MinX => Some((measure::Ordinate::X, false)),
+        GeofFunction::MaxX => Some((measure::Ordinate::X, true)),
+        GeofFunction::MinY => Some((measure::Ordinate::Y, false)),
+        GeofFunction::MaxY => Some((measure::Ordinate::Y, true)),
+        GeofFunction::MinZ => Some((measure::Ordinate::Z, false)),
+        GeofFunction::MaxZ => Some((measure::Ordinate::Z, true)),
+        _ => None,
+    };
