+                reference.datum.as_bytes(),
+                b"longitude-latitude",
+                b"degrees;metres",
+                b"6378137",
+                b"1",
+                b"298257223563",
+                b"1000000000",
+            ],
+        ));
+        let scratch = purrdf_xsd::integer::LimbScratch::new(8, 8).unwrap();
+        let values = crate::numerical::ExactValues::admitted(&scratch);
+        let window = purrdf_alloc_probe::CurrentThreadWindow::open();
+        let actual = crate::numerical::reference_identity_using(&reference, &values).unwrap();
+        let allocation = window.close();
+        assert_eq!(actual, expected);
+        assert_eq!(allocation.allocations, 0);
