+#[cfg(test)]
+mod arithmetic_tests {
+    use super::*;
+    use purrdf_alloc_probe::CurrentThreadWindow;
+
+    fn value(n: Int, d: Int) -> Rational {
+        Rational::new(Integer::from_bigint(n), Integer::from_bigint(d))
+            .expect("nonzero denominator")
+    }
