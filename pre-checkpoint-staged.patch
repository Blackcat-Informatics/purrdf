+        let left = selected(90, 1000, &mut context);
+        let right = selected(450, 3000, &mut context);
+        assert_eq!(
+            intersections(&left, &right, &mut context).expect("exact prefix law"),
+            vec![CurveIntersection::BranchOverlap {
+                left: (Rat::zero(), Rat::one()),
