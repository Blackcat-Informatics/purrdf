+        })
+        .unwrap();
+    let session = GeoSession::try_new(invocation.clone(), ExecutionPolicy::geometry()).unwrap();
+    let refused = response(&session, DISTANCE);
+    assert_eq!(refused["error"]["code"].as_str(), Some("work-exhausted"));
+    assert_eq!(
