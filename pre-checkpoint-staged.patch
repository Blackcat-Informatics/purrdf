+        .unwrap();
+        let mut context = MetricContext::wgs84().unwrap();
+        let image = chain
+            .materialize_geometry(
+                source.geometry(),
+                crs(),
+                &ImageMetric::CartesianMetres,
+                None,
+                &mut context,
