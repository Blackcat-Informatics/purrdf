+    fn worker(work: u64) -> MetricContext {
+        let mut limits = ExecutionLimits::GEOMETRY;
+        limits.max_work_items = work;
+        MetricContext::new(
+            GeographicReference::wgs84(),
+            ExecutionPolicy::new(limits).unwrap(),
