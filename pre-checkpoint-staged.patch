+// Coordinate operations have at most three numerical axes. Keep every lane
+// inline while the variable-length operation chain remains separately owned.
+pub(crate) type OperationCoordinates = purrdf_core::SmallVec<[FixedInterval; 3]>;
+type QuantizedCoordinates = purrdf_core::SmallVec<[Rat; 3]>;
+
+/// The original parameter-field order, shared by quotation and compilation.
+/// Fixed fields borrow stack bytes; rational fields use the sole XSD renderer.
+pub(super) trait ParameterSink {
+    fn bytes(&mut self, field: &[u8]) -> Result<(), GeoError>;
+    fn rational(&mut self, value: &Rat) -> Result<(), GeoError>;
+}
+
+struct ParameterHash<'hash, 'scratch> {
+    identity: &'hash mut purrdf_hash::blake3::Hasher,
+    transverse: Option<&'hash mut purrdf_hash::blake3::Hasher>,
+    values: &'hash crate::numerical::ExactValues<'scratch>,
+}
+
+impl ParameterSink for ParameterHash<'_, '_> {
+    fn bytes(&mut self, field: &[u8]) -> Result<(), GeoError> {
+        purrdf_hash::frame::frame_le_into(self.identity, field);
+        if let Some(transverse) = &mut self.transverse {
+            purrdf_hash::frame::frame_le_into(*transverse, field);
+        }
+        Ok(())
+    }
+
+    fn rational(&mut self, value: &Rat) -> Result<(), GeoError> {
+        for integer in [value.numerator(), value.denominator()] {
+            let digits = self
+                .values
+                .decimal_digits(&integer)
+                .map_err(GeoError::NumericalScratch)?;
+            crate::numerical::frame_decimal_digits(self.identity, &digits)?;
+            if let Some(transverse) = &mut self.transverse {
+                crate::numerical::frame_decimal_digits(transverse, &digits)?;
+            }
+        }
+        Ok(())
+    }
+}
