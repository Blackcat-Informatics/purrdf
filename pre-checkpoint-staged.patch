+                    x_power: 0,
+                    y_power: 1,
+                    x_coefficient: Rat::zero(),
+                    y_coefficient: Rat::one(),
+                },
+                PolynomialTerm {
+                    x_power: 2,
+                    y_power: 0,
+                    x_coefficient: Rat::zero(),
+                    y_coefficient: Rat::one(),
+                },
+            ],
+        )
+        .unwrap();
+        let polynomial = CoordinateOperation::compile(
+            op_ref(1, CoordinateUnit::Metres),
