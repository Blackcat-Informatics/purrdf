+fn point_polygons(
+    request: DiskRequest<'_, '_>,
+    context: &mut MetricContext,
+    progress: &mut WorkProgress<'_>,
+    total: &mut u64,
+    retained: &mut MaterializationStorage,
+    global_output: &mut bool,
+) -> Result<GeometryBody, GeoError> {
