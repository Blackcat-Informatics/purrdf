+            })
+            .collect();
+        // Only if: batch and scalar assignment are the same law.
+        let mut batch = vec![wgs84.assign(&points[0], 30).unwrap(); points.len()];
+        wgs84.assign_batch(&points, 30, &mut batch).unwrap();
+        for (point, key) in points.iter().zip(&batch) {
