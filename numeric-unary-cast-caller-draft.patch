+        }
+        XsdValue::Float(value) => Ok(Some(PreparedNumericText::Ieee(xpath_float_text(*value)))),
+        XsdValue::Double(value) => Ok(Some(PreparedNumericText::Ieee(xpath_double_text(*value)))),
+        other => prepare_numeric_text(other, admit),
+    }
+}
