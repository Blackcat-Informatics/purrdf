+) -> Result<Option<PreparedNumericText>, crate::bigint::LimbScratchError> {
+    match value {
+        XsdValue::Boolean(value) => {
+            use std::fmt::Write;
+            let mut text = CanonicalFloatText::empty();
+            text.write_str(if *value { "true" } else { "false" }).expect("Boolean lexical fits inline");
