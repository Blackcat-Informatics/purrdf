msgstr "`date + yearMonthDuration`"

#: src/sparql/querying.md:144 src/sparql/querying.md:145
#: src/sparql/querying.md:146 src/sparql/querying.md:147
msgid "`date`"
msgstr "`date`"

#: src/sparql/querying.md:145
msgid "`date - yearMonthDuration`"
msgstr "`date - yearMonthDuration`"

#: src/sparql/querying.md:146
msgid "`date + dayTimeDuration`"
msgstr "`date + dayTimeDuration`"

#: src/sparql/querying.md:147
msgid "`date - dayTimeDuration`"
msgstr "`date - dayTimeDuration`"

#: src/sparql/querying.md:148
