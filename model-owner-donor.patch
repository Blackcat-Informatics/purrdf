+    let mut reader = test_reader(&[1, 100]);
+    reader.catalogs = vec![Some(Arc::clone(&catalog)); 101];
+    assert!(Arc::ptr_eq(&reader.catalog().unwrap().unwrap(), &catalog));
+    assert_eq!(reader.remaining(), 0);
+}
