+    let path = Path::Predicate(NamedNode::new_unchecked("http://example.org/ns#p"));
+    let reserve = purrdf_stack::reserve(purrdf_stack::remaining());
+    let refused = PreparedShapes::new(Arc::clone(&shapes));
