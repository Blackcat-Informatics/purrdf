+fn duplicate_function_headers_are_refused_before_bodies_are_installed() {
+    let mut shapes = crate::engine::parse_shapes(
+        "@prefix sh: <http://www.w3.org/ns/shacl#> . @prefix ex: <http://example.org/> .
