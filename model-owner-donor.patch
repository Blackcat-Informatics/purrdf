 }
 
+/// A shared definition re-enters the traversal through a finite set of sink
+/// types. Erase only the forwarding callback: recursively nesting `NodeRoles<S>`
+/// here would require infinitely many monomorphizations. The reporting constants
+/// still remove result construction from conformance-only traversal.
+struct ReferenceSink<'a, const RECORDS: bool, const EVIDENCE: bool> {
+    forward: &'a mut dyn FnMut(&Severity, Option<ResultRecord>) -> Flow,
+}
+
+impl<const RECORDS: bool, const EVIDENCE: bool> ResultSink
+    for ReferenceSink<'_, RECORDS, EVIDENCE>
+{
+    const RECORDS_RESULTS: bool = RECORDS;
+    const RECORDS_EVIDENCE: bool = EVIDENCE;
+
+    fn violation(&mut self, severity: &Severity, build: impl FnOnce() -> ResultRecord) -> Flow {
+        (self.forward)(severity, RECORDS.then(build))
+    }
+}
+
+/// Keep the original sink, stop decision and evidence through a catalog edge,
+/// without allocating a temporary report or changing the reporting mode.
+fn walk_reference<S: ResultSink>(
+    context: ValidationContext<'_, '_>,
+    focus: &FocusNode,
+    sink: &mut S,
+) -> Result<Flow, crate::error::ShapesError> {
+    let mut forward = |severity: &Severity, record: Option<ResultRecord>| {
+        sink.violation(severity, || {
+            record.expect("a reporting reference sink builds its original record")
+        })
+    };
+    if S::RECORDS_EVIDENCE {
+        walk_shape(
+            context,
+            focus,
+            &mut ReferenceSink::<true, true> {
+                forward: &mut forward,
+            },
+        )
+    } else if S::RECORDS_RESULTS {
+        walk_shape(
+            context,
+            focus,
+            &mut ReferenceSink::<true, false> {
+                forward: &mut forward,
+            },
+        )
+    } else {
+        walk_shape(
+            context,
+            focus,
+            &mut ReferenceSink::<false, false> {
+                forward: &mut forward,
+            },
+        )
+    }
+}
