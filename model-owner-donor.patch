+#[test]
+fn stack_refusal_is_not_a_conformance_or_validation_report() {
+    use purrdf_shapes::constraints::conforms;
+    use purrdf_shapes::data::ShaclData;
+    use purrdf_shapes::engine::PreparedShapes;
+    use purrdf_shapes::term::NamedNode;
