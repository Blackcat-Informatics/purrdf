+fn catalog_codec_preserves_logical_cycles_shared_roots_and_owner_release() {
+    let mut left = leaf_shape("Left");
+    let mut right = leaf_shape("Right");
+    left.constraints
+        .push(Constraint::Reference(right.id.clone()));
+    right
+        .constraints
+        .push(Constraint::Reference(left.id.clone()));
+    let catalog = crate::shapes::ShapeCatalog::from_definitions(vec![left, right]).unwrap();
+    let mut writer = test_writer();
+    writer
+        .shape(&catalog.root(&ex_term("Left")).unwrap())
+        .unwrap();
+    writer
+        .shape(&catalog.root(&ex_term("Right")).unwrap())
+        .unwrap();
+    let mut reader = test_reader(&writer.out);
+    let left = reader.shape().unwrap();
+    let right = reader.shape().unwrap();
+    assert_eq!(reader.remaining(), 0);
+    assert!(Arc::ptr_eq(
+        left.catalog.as_ref().unwrap(),
+        right.catalog.as_ref().unwrap()
+    ));
+    let restored = left.catalog.as_ref().unwrap();
+    assert!(
+        matches!(restored.get(&ex_term("Left")).unwrap().constraints.as_slice(),
+        [Constraint::Reference(id)] if *id == ex_term("Right"))
+    );
+    assert!(
+        matches!(restored.get(&ex_term("Right")).unwrap().constraints.as_slice(),
+        [Constraint::Reference(id)] if *id == ex_term("Left"))
+    );
+    let weak = Arc::downgrade(restored);
+    drop(reader);
+    drop(left);
+    assert!(weak.upgrade().is_some());
+    drop(right);
+    assert!(weak.upgrade().is_none());
+}
