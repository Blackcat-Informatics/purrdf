+fn copy_path(path: &Path, inverted: bool) -> Path {
+    use purrdf_lex::walk::WorkList;
+    enum Build {
+        Inverse,
+        Sequence(usize),
+        Alternative(usize),
+        ZeroOrMore,
+        OneOrMore,
+        ZeroOrOne,
