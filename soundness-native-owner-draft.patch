+    #[test]
+    fn native_soundness_analysis_keeps_original_immutable_owners_after_context_drop() {
+        use crate::governor::soundness::{
+            NodeAnalysisTable, RowCollisionIntro, analyze_pattern_admitted,
+            exists_row_collision_admitted, probe_admissible_admitted,
+        };
+        use purrdf_sparql_algebra::{Query, SparqlParser, Variable};
+        let query = SparqlParser::new().parse_query(
+            "ASK { ?s <http://example.org/p> ?o BIND(?o AS ?v) FILTER(BOUND(?s)) }",
+        ).expect("caller-owned soundness fixture");
+        let Query::Ask { pattern, .. } = &query else { unreachable!("ASK fixture"); };
+        let (workspace, ledger, base) = account(u64::MAX);
+        let capability = workspace.capability();
+        let mut table = NodeAnalysisTable::default();
+        let root = analyze_pattern_admitted(pattern, &mut table, &capability)
+            .expect("native complete synthesis");
+        assert_eq!(root.free_vars.len(), 3);
+        assert_eq!(root.certainly_bound.len(), 3);
+        for name in ["s", "o", "v"] {
+            assert!(root.free_vars.contains(&Variable::new(name)));
+            assert!(root.certainly_bound.contains(&Variable::new(name)));
+        }
+        assert!(!root.has_stateful_builtin);
+        assert!(!root.can_hard_error);
+        let schema = crate::VarSchema::from_vars_admitted([Variable::new("s")], &capability)
+            .expect("original outer-schema owner");
+        assert!(probe_admissible_admitted(pattern, &table, &schema, &capability)
+            .expect("native probe"));
+        assert!(exists_row_collision_admitted(pattern, &schema, &capability)
+            .expect("native fresh-target walk").is_none());
+        let bound = crate::VarSchema::from_vars_admitted([Variable::new("v")], &capability)
+            .expect("actual row scope");
+        let collision = exists_row_collision_admitted(pattern, &bound, &capability)
+            .expect("native collision");
+        assert_eq!(collision.map(|(variable, intro)| (variable.as_str(), intro)),
+            Some(("v", RowCollisionIntro::Bind)));
+        let live = ledger.live.load(Ordering::Relaxed);
+        assert!(live > base);
+        let copy = root.clone();
+        assert_eq!(ledger.live.load(Ordering::Relaxed), live,
+            "immutable analyses share their original schema allocations");
+        drop(schema);
+        drop(bound);
+        drop(capability);
+        drop(workspace);
+        assert!(ledger.live.load(Ordering::Relaxed) > 0);
+        drop(table);
+        drop(root);
+        assert!(ledger.live.load(Ordering::Relaxed) > 0,
+            "the extracted shallow analysis still owns the original grants");
+        drop(copy);
+        assert_eq!(ledger.live.load(Ordering::Relaxed), 0);
+        assert_eq!(ledger.clones.load(Ordering::Relaxed), 0);
+    }
+
+    #[test]
+    fn native_cap_plan_and_spilled_edges_keep_original_grants_until_payload_drop() {
+        use crate::governor::soundness::{child_edges_admitted, plan_cap_pushdown_admitted};
+        use purrdf_sparql_algebra::{Query, SparqlParser};
+        let query = SparqlParser::new().parse_query(
+            "ASK { { ?s <http://example.org/p> ?o } UNION { ?s <http://example.org/q> ?o } UNION { ?s <http://example.org/r> ?o } UNION { ?s <http://example.org/t> ?o } UNION { ?s <http://example.org/u> ?o } UNION { ?s <http://example.org/v> ?o } }",
+        ).expect("caller-owned wide UNION");
+        let Query::Ask { pattern, .. } = &query else { unreachable!("ASK fixture"); };
+        let (workspace, ledger, base) = account(u64::MAX);
+        let capability = workspace.capability();
+        let edges = child_edges_admitted(pattern, &capability).expect("actual classified edge spill");
+        let pushdown = plan_cap_pushdown_admitted(pattern, Some(3), &capability)
+            .expect("native pushdown");
+        assert_eq!(pushdown.ceiling_of(pattern), Some(3));
+        assert!(ledger.live.load(Ordering::Relaxed) > base);
+        drop(capability);
+        drop(workspace);
+        drop(pushdown);
+        assert!(ledger.live.load(Ordering::Relaxed) > 0,
+            "the wide edge payload retains the original spill admission");
+        drop(edges);
+        assert_eq!(ledger.live.load(Ordering::Relaxed), 0);
+    }
