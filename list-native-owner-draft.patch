+#[derive(Debug, Default)]
+pub(crate) struct ConstructedCells {
+    values: Vec<(purrdf_core::TermValue, purrdf_core::TermValue, purrdf_core::TermValue)>,
+    grants: Vec<[WorkspaceAllocation; 3]>,
+    value_allocation: Option<WorkspaceAllocation>,
+    grant_allocation: Option<WorkspaceAllocation>,
+}
+impl std::ops::Deref for ConstructedCells {
+    type Target = [(purrdf_core::TermValue, purrdf_core::TermValue, purrdf_core::TermValue)];
+    fn deref(&self) -> &Self::Target { &self.values }
