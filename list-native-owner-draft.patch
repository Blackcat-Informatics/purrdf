+impl ConstructedCells {
+    fn reserve(&mut self, required: usize, workspace: &WorkspaceCapability) -> Result<(), EvalError> {
+        if required > self.values.capacity() || required > self.grants.capacity() {
+            let current = self.values.capacity().max(self.grants.capacity());
+            let capacity = current.checked_mul(2)
+                .ok_or(EvalError::WorkspaceBoundOverflow)?.max(required);
+            workspace.reserve_vec(&mut self.values, &mut self.value_allocation, capacity)?;
+            workspace.reserve_vec(&mut self.grants, &mut self.grant_allocation, capacity)?;
+        }
+        Ok(())
+    }
