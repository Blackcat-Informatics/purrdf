+        &mut self, cell: (WorkspaceTerm, WorkspaceTerm, WorkspaceTerm),
+        workspace: &WorkspaceCapability,
+    ) -> Result<(), EvalError> {
+        let required = self.values.len().checked_add(1).ok_or(EvalError::WorkspaceBoundOverflow)?;
+        self.reserve(required, workspace)?;
+        let (s, sa) = cell.0.into_parts();
+        let (p, pa) = cell.1.into_parts();
+        let (o, oa) = cell.2.into_parts();
+        self.values.push((s, p, o));
+        self.grants.push([sa, pa, oa]);
+        Ok(())
