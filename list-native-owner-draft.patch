+        &mut self, other: &mut Self, workspace: &WorkspaceCapability,
+    ) -> Result<(), EvalError> {
+        let required = self.values.len().checked_add(other.values.len())
+            .ok_or(EvalError::WorkspaceBoundOverflow)?;
+        self.reserve(required, workspace)?;
