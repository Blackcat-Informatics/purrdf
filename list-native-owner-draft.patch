+/// A borrowed native term formatter. Each formatting pass keeps its actual
+/// token/container buffers admitted through destruction, without owning a copy
+/// of the term or replacing the first physical failure with a formatting error.
+pub(crate) struct WorkspaceDebug<'a> {
+    value: &'a purrdf_core::TermValue,
+    workspace: &'a WorkspaceCapability,
+    failure: std::cell::RefCell<Option<EvalError>>,
+}
+impl<'a> WorkspaceDebug<'a> {
+    pub(crate) const fn new(value: &'a purrdf_core::TermValue, workspace: &'a WorkspaceCapability) -> Self {
+        Self { value, workspace, failure: std::cell::RefCell::new(None) }
+    }
+    pub(crate) fn take_failure(&self) -> Option<EvalError> { self.failure.borrow_mut().take() }
+}
+impl core::fmt::Debug for WorkspaceDebug<'_> {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        let mut frame = LexicalFrame::new(self.workspace);
+        let result = self.value.write_debug_with_memory(
+            f, &mut purrdf_lex::allocation::Memory::new(&mut frame));
+        match result {
+            Ok(()) => Ok(()),
+            Err(purrdf_lex::walk::DebugWriteError::Format(error)) => Err(error),
+            Err(purrdf_lex::walk::DebugWriteError::Storage(error)) => {
+                let error = frame.storage_error(error, "native term Debug");
+                let mut failure = self.failure.borrow_mut();
+                if failure.is_none() { *failure = Some(error); }
+                Err(core::fmt::Error)
+            }
+        }
+    }
+}
