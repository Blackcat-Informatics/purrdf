+// One erased capability, original grant and first typed native admission failure.
+// The native leaf owns this callback; it never owns a copied grant or bare payload.
+struct NativeAdmission {
+    workspace: WorkspaceCapability,
+    allocation: Option<WorkspaceAllocation>,
+    failure: Option<EvalError>,
+    live: usize,
+}
+
+impl NativeAdmission {
+    fn new(workspace: &WorkspaceCapability) -> Self {
+        Self { workspace: workspace.clone(), allocation: None, failure: None, live: 0 }
+    }
+    fn resize_eval(&mut self, live: usize) -> Result<(), EvalError> {
+        if let Some(error) = &self.failure { return Err(error.clone()); }
+        let bytes = u64::try_from(live).map_err(|_| EvalError::WorkspaceBoundOverflow)?;
+        match &mut self.allocation {
+            Some(allocation) => allocation.resize(bytes)?,
+            None if live != 0 => self.allocation = Some(self.workspace.charge(bytes)?),
+            None => {}
+        }
+        self.live = live;
+        Ok(())
+    }
