+macro_rules! kid_list {
+    ($($method:ident => $one:ident: $ty:ty;)+) => {$(
+        fn $method<S: Admission + ?Sized>(
+            &mut self,
+            count: usize,
+            memory: &mut Memory<'_, S>,
+        ) -> Result<Vec<$ty>, StorageError> {
+            let mut copies = Vec::new();
+            memory.reserve(&mut copies, count)?;
+            for _ in 0..count {
+                copies.push(self.$one());
+            }
+            Ok(copies)
+        }
+    )+};
+}
