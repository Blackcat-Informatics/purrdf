+#[test]
+fn http_native_decode_and_blank_ingest_preserve_duplicates_and_physical_refusal_beats_silent() {
+    use purrdf_sparql_eval::{AdmittedHttpBody,HttpRequest,HttpTransport,HttpRemoteQuerySource,RemoteError,ServiceResolutionError,WorkspaceCapability};
+    struct Native {refuse:bool}
+    impl HttpTransport for Native {
+        fn post(&self,_:HttpRequest<'_>)->Result<Vec<u8>,RemoteError>{panic!("bounded route cannot enter the opaque resident producer")}
+        fn post_admitted(&self,_:HttpRequest<'_>,workspace:WorkspaceCapability)->Result<AdmittedHttpBody,ServiceResolutionError>{
+            AdmittedHttpBody::try_build(&workspace,|memory|{
+                if self.refuse {
+                    let mut bytes=Vec::<u8>::new();
+                    memory.reserve(&mut bytes,usize::MAX)?;
+                    return Ok(bytes);
+                }
+                memory.collect(br#"{"head":{"vars":["b","x"]},"results":{"bindings":[{"b":{"type":"bnode","value":"shared"},"x":{"type":"literal","value":"same"}},{"b":{"type":"bnode","value":"shared"},"x":{"type":"literal","value":"same"}}]}}"#.iter().copied()).map_err(Into::into)
+            })
+        }
+    }
+    let (image,_)=fixture();
+    let source=open_with_evidence(&image,CEILING,2,16_384);
+    let remote=HttpRemoteQuerySource::new(Native{refuse:false});
+    let engine=NativeSparqlEngine::new();
+    let window=purrdf_alloc_probe::CurrentThreadWindow::open();
+    let result=engine.query_fallible_view(&source,SparqlRequest{query:"SELECT ?b ?x WHERE {SERVICE <https://example.org/service> {?b ?p ?x}}",base_iri:None,substitutions:&[]},QueryOptions::EMPTY.with_remote(Some(&remote))).unwrap().result;
+    let measurement=window.close();
+    assert!(u64::try_from(measurement.peak_working_bytes).unwrap()<=source.evidence().peak_bytes());
+    let rows=support::sorted_rows(&result,support::render_cell);
+    assert_eq!(rows.len(),2);
+    assert_eq!(rows[0],rows[1],"one response identity is shared and bag duplicates survive");
+    drop(result);
+    let source=open_with_evidence(&image,CEILING,2,16_384);
+    let remote=HttpRemoteQuerySource::new(Native{refuse:true});
+    let error=engine.query_fallible_view(&source,SparqlRequest{query:"SELECT ?x WHERE {SERVICE SILENT <https://example.org/service> {?x ?p ?o}}",base_iri:None,substitutions:&[]},QueryOptions::EMPTY.with_remote(Some(&remote))).expect_err("physical layout refusal is never an invocation failure SILENT can swallow");
+    assert_eq!(error.diagnostic().expect("typed physical refusal").code,"native-sparql-workspace-bound-overflow");
