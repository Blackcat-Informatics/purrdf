 impl<T> AdmittedVec<T> {
+    /// A known array layout, admitted before its fallible allocation.
+    pub(crate) fn with_capacity(capacity: usize, workspace: &WorkspaceCapability) -> Result<Self, EvalError> {
+        let layout = std::alloc::Layout::array::<T>(capacity).map_err(|_| EvalError::WorkspaceBoundOverflow)?;
+        let allocation = if layout.size() == 0 { None } else {
+            Some(workspace.charge(u64::try_from(layout.size()).map_err(|_| EvalError::WorkspaceBoundOverflow)?)?)
+        };
+        let values = vector::<T>(capacity, "admitted vector")?;
+        Ok(Self { values, allocation, workspace: workspace.clone() })
+    }
+
+    /// Mutating existing elements cannot grow or detach the covered buffer.
+    pub(crate) fn as_mut_slice(&mut self) -> &mut [T] { &mut self.values }
+
