+
+    /// The same kept numbering, with native construction fallible and owned.
+    pub(crate) fn handle_admitted(
+        &self,
+        root: &GraphPattern,
+        workspace: &crate::WorkspaceCapability,
+    ) -> Result<PlanHandle, crate::EvalError> {
+        if self.kept.get().is_none() {
+            let handle = Tree::build_admitted(root, workspace)?.handle();
+            let _ = self.kept.set(handle);
+        }
+        let kept = self.kept.get().expect("a successful constructor or another worker installed the shape");
+        debug_assert!(kept.shape.kind(NodeId::ROOT) == NodeKind::of(root), "the cache keeps its owner's tree");
+        kept.shape.root.store(std::ptr::from_ref(root) as usize, Ordering::Relaxed);
+        Ok(kept.clone())
+
 }
+}
