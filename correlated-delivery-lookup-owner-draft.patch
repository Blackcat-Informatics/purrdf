+/// Values Insertion keeps the authored leaf on the left and its singleton
+/// restriction on the right. Bulk and delivered execution enter this same
+/// child-role/schema law before reading the native restricted relation.
+fn eval_values_restricted_join<D: DatasetView + Sync>(
+    node: &GraphPattern,
+    left: &GraphPattern,
+    right: &GraphPattern,
+    ctx: &mut EvalCtx<'_, D>,
+) -> Result<Option<Evaluated<D::Id>>, EvalError> {
+    if !ctx.in_substituted_exists
+        || !matches!(right, GraphPattern::Values { bindings, .. } if bindings.len() == 1)
+    {
+        return Ok(None);
+    }
+    let driver_schema = crate::eval::syntactic_schema_admitted(right, &ctx.growth)?;
+    if !crate::bgp::PositivePlan::seed_eligible_admitted(left, &driver_schema, &ctx.growth)? {
+        return Ok(None);
+    }
+    let output = crate::eval::syntactic_schema_admitted(node, &ctx.growth)?;
+    let mut lift = Lift::at_admitted(node, &ctx.growth)?;
+    let Some(driver) = lift.absorb(1, eval_evaluated(right, ctx)?) else {
+        return Ok(Some(lift.withheld()));
+    };
+    if lift.is_truncated() {
+        return Ok(Some(lift.finish(SolutionSeq::empty(output))));
+    }
+    finish_seeded_join(lift, driver, left, 0, Some(&output), ctx).map(Some)
 }
 
