+# SPDX-FileCopyrightText: 2026 Blackcat Informatics Inc. <paudley@blackcatinformatics.ca>
+# SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
+@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
+@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
+
+<> a mf:Manifest ;
+   mf:entries (
+      <#alternative-sequence>
+      <#repeated-alternatives>
+      <#inverse-sequence>
+      <#optional>
+      <#minus-correlated>
+      <#minus-disjoint>
+      <#exists>
+      <#not-exists>
+      <#named-graph>
+      <#subquery-hidden-name>
+      <#bind-values>
+      <#source-blank-connection>
+      <#independent-union-blanks>
+      <#caller-lookalikes>
+      <#zero-visible>
+      <#distinct-zero-visible>
+      <#distinct-visible>
+      <#illegal-union-label>
+      <#illegal-optional-label>
+      <#illegal-subquery-label>
+   ) .
+
+<#alternative-sequence> a mf:QueryEvaluationTest ;
+    mf:name "alternative-sequence" ;
+    rdfs:comment "The p arm has witnesses a and b; the q arm has witness a. All three reach o. The disconnected wrong-to-other edge cannot join." ;
+    mf:action [ qt:query <alternative-sequence.rq> ; qt:data <data.ttl> ] ;
+    mf:result <alternative-sequence.srj> .
+
+<#repeated-alternatives> a mf:QueryEvaluationTest ;
+    mf:name "repeated-alternatives" ;
+    rdfs:comment "Each of two p witnesses matches two identical first arms and two identical second arms: 2 x 2 x 2 = 8 copies of o." ;
+    mf:action [ qt:query <repeated-alternatives.rq> ; qt:data <data.ttl> ] ;
+    mf:result <repeated-alternatives.srj> .
+
+<#inverse-sequence> a mf:QueryEvaluationTest ;
+    mf:name "inverse-sequence" ;
+    rdfs:comment "Inverting the three legal derivations from s to o reverses the endpoints and preserves their three derivations." ;
+    mf:action [ qt:query <inverse-sequence.rq> ; qt:data <data.ttl> ] ;
+    mf:result <inverse-sequence.srj> .
+
+<#optional> a mf:QueryEvaluationTest ;
+    mf:name "optional" ;
+    rdfs:comment "s has three compatible right solutions. lonely has none and survives once with o unbound." ;
+    mf:action [ qt:query <optional.rq> ; qt:data <data.ttl> ] ;
+    mf:result <optional.srj> .
+
+<#minus-correlated> a mf:QueryEvaluationTest ;
+    mf:name "minus-correlated" ;
+    rdfs:comment "The right side shares s and removes s through compatibility; it has no row for lonely." ;
+    mf:action [ qt:query <minus-correlated.rq> ; qt:data <data.ttl> ] ;
+    mf:result <minus-correlated.srj> .
+
+<#minus-disjoint> a mf:QueryEvaluationTest ;
+    mf:name "minus-disjoint" ;
+    rdfs:comment "The right relation is nonempty but shares no distinguished variable with the left. MINUS preserves all three left rows." ;
+    mf:action [ qt:query <minus-disjoint.rq> ; qt:data <data.ttl> ] ;
+    mf:result <minus-disjoint.srj> .
+
+<#exists> a mf:QueryEvaluationTest ;
+    mf:name "exists" ;
+    rdfs:comment "EXISTS tests presence once per outer row; three s witnesses do not multiply the single s row." ;
+    mf:action [ qt:query <exists.rq> ; qt:data <data.ttl> ] ;
+    mf:result <exists.srj> .
+
+<#not-exists> a mf:QueryEvaluationTest ;
+    mf:name "not-exists" ;
+    rdfs:comment "s has a compatible witness and is rejected; lonely has no witness and remains." ;
+    mf:action [ qt:query <not-exists.rq> ; qt:data <data.ttl> ] ;
+    mf:result <not-exists.srj> .
+
+<#named-graph> a mf:QueryEvaluationTest ;
+    mf:name "named-graph" ;
+    rdfs:comment "g1 contains only the p/a/r/o derivation; g2 only the q/b/r/other derivation. Witnesses cannot cross active graph boundaries." ;
+    mf:action [ qt:query <named-graph.rq> ; qt:data <data.ttl> ; qt:graphData [ qt:graph <g1.ttl> ; rdfs:label "http://example.org/g1" ] ; qt:graphData [ qt:graph <g2.ttl> ; rdfs:label "http://example.org/g2" ] ] ;
+    mf:result <named-graph.srj> .
+
+<#subquery-hidden-name> a mf:QueryEvaluationTest ;
+    mf:name "subquery-hidden-name" ;
+    rdfs:comment "The inner s is not projected, so it cannot join the outer s=lonely binding. The inner query independently emits three o rows." ;
+    mf:action [ qt:query <subquery-hidden-name.rq> ; qt:data <data.ttl> ] ;
+    mf:result <subquery-hidden-name.srj> .
+
+<#bind-values> a mf:QueryEvaluationTest ;
+    mf:name "bind-values" ;
+    rdfs:comment "Two identical VALUES rows each join three witnesses. BIND copies o into a distinguished column without changing the six-row bag." ;
+    mf:action [ qt:query <bind-values.rq> ; qt:data <data.ttl> ] ;
+    mf:result <bind-values.srj> .
+
+<#source-blank-connection> a mf:QueryEvaluationTest ;
+    mf:name "source-blank-connection" ;
+    rdfs:comment "The same existential in one BGP connects its path endpoint to marker=yes, selecting only s and its three derivations. FILTER does not split the BGP." ;
+    mf:action [ qt:query <source-blank-connection.rq> ; qt:data <data.ttl> ] ;
+    mf:result <source-blank-connection.srj> .
+
+<#independent-union-blanks> a mf:QueryEvaluationTest ;
+    mf:name "independent-union-blanks" ;
+    rdfs:comment "Distinct existential labels in the two BGPs are legal and independent. p contributes a, b, dead; q contributes a. UNION preserves both copies of a." ;
+    mf:action [ qt:query <independent-union-blanks.rq> ; qt:data <data.ttl> ] ;
+    mf:result <independent-union-blanks.srj> .
+
+<#caller-lookalikes> a mf:QueryEvaluationTest ;
+    mf:name "caller-lookalikes" ;
+    rdfs:comment "Both legal user variable spellings remain distinguished and retain their literals for each of three path witnesses; translator names cannot capture them." ;
+    mf:action [ qt:query <caller-lookalikes.rq> ; qt:data <data.ttl> ] ;
+    mf:result <caller-lookalikes.srj> .
+
+<#zero-visible> a mf:QueryEvaluationTest ;
+    mf:name "zero-visible" ;
+    rdfs:comment "Both endpoints are ground. Projecting all hidden witnesses leaves three copies of the empty solution, not one." ;
+    mf:action [ qt:query <zero-visible.rq> ; qt:data <data.ttl> ] ;
+    mf:result <zero-visible.srj> .
+
+<#distinct-zero-visible> a mf:QueryEvaluationTest ;
+    mf:name "distinct-zero-visible" ;
+    rdfs:comment "The three projected empty solutions compare equal, so DISTINCT yields one empty row." ;
+    mf:action [ qt:query <distinct-zero-visible.rq> ; qt:data <data.ttl> ] ;
+    mf:result <distinct-zero-visible.srj> .
+
+<#distinct-visible> a mf:QueryEvaluationTest ;
+    mf:name "distinct-visible" ;
+    rdfs:comment "All three witnesses project to the same o binding and DISTINCT yields one row." ;
+    mf:action [ qt:query <distinct-visible.rq> ; qt:data <data.ttl> ] ;
+    mf:result <distinct-visible.srj> .
+
+<#illegal-union-label> a mf:NegativeSyntaxTest11 ;
+    mf:name "illegal-union-label" ;
+    rdfs:comment "A blank label occurs in two separate basic graph patterns; the source query must be rejected before execution." ;
+    mf:action <illegal-union-label.rq> .
+
+<#illegal-optional-label> a mf:NegativeSyntaxTest11 ;
+    mf:name "illegal-optional-label" ;
+    rdfs:comment "A blank label occurs in two separate basic graph patterns; the source query must be rejected before execution." ;
+    mf:action <illegal-optional-label.rq> .
+
+<#illegal-subquery-label> a mf:NegativeSyntaxTest11 ;
+    mf:name "illegal-subquery-label" ;
+    rdfs:comment "A blank label occurs in two separate basic graph patterns; the source query must be rejected before execution." ;
+    mf:action <illegal-subquery-label.rq> .
